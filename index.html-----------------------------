                const map = new Map();
                KHATABOOK_CUSTOMERS.forEach(({ name, phone }) => {
                    const key = normalizePhone(phone);
                    if (!key || !name) return;
                    if (!map.has(key)) map.set(key, []);
                    map.get(key).push(String(name).trim());
                });
                return map;
            })();

