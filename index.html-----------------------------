            function flyToCart(sourceImg, cartBtn, onDone) {
                const srcRect = sourceImg.getBoundingClientRect();
                const destRect = cartBtn.getBoundingClientRect();
                if (srcRect.width === 0 || srcRect.height === 0) {
                    onDone();
                    return;
                }

                const flyer = sourceImg.cloneNode(true);
                flyer.removeAttribute("id");
                flyer.style.cssText = `position:fixed;z-index:9999;margin:0;pointer-events:none;
        left:${srcRect.left}px;top:${srcRect.top}px;width:${srcRect.width}px;height:${srcRect.height}px;
        opacity:1;transform:translate(0,0) scale(1);transform-origin:top left;
        transition:transform .55s cubic-bezier(0.34,0,0.64,1),opacity .55s ease;will-change:transform,opacity;`;
                document.body.appendChild(flyer);

                const destX = destRect.left + destRect.width / 2 - (srcRect.left + srcRect.width / 2);
                const destY = destRect.top + destRect.height / 2 - (srcRect.top + srcRect.height / 2);

                let finished = false;
                const finish = () => {
                    if (finished) return;
                    finished = true;
                    flyer.remove();
                    onDone();
                };
                flyer.addEventListener("transitionend", finish, {
                    once: true,
                });
                setTimeout(finish, 650);

                requestAnimationFrame(() => {
                    requestAnimationFrame(() => {
                        flyer.style.transform = `translate(${destX}px, ${destY}px) scale(0.12)`;
