            const SEARCH_SYNONYMS = {
                cloth: "towel",
                rag: "towel",
                wiper: "towel",
                shine: "polish",
                shiner: "polish",
                spray: "gun",
                sprayer: "gun",
                cleaning: "wash",
                clean: "wash",
                shampoo: "wash",
            };

            function levenshteinDistance(a, b) {
                if (a === b) return 0;
                if (!a.length) return b.length;
                if (!b.length) return a.length;
                let prevRow = Array.from({ length: b.length + 1 }, (_, i) => i);
                for (let i = 1; i <= a.length; i++) {
                    let prevDiag = prevRow[0];
                    prevRow[0] = i;
                    for (let j = 1; j <= b.length; j++) {
                        const temp = prevRow[j];
                        prevRow[j] = Math.min(
                            prevRow[j] + 1,
                            prevRow[j - 1] + 1,
                            prevDiag + (a[i - 1] === b[j - 1] ? 0 : 1)
                        );
                        prevDiag = temp;
                    }
                }
                return prevRow[b.length];
            }

            function fuzzyWordsMatch(a, b) {
                if (a === b || a.includes(b) || b.includes(a)) return true;
                const maxDistance = Math.min(a.length, b.length) > 5 ? 2 : 1;
                return levenshteinDistance(a, b) <= maxDistance;
            }

            function scoreProductAgainstQuery(product, queryWords) {
                const haystack = `${product.name} ${product.description}`.toLowerCase();
                const haystackWords = haystack.split(/\s+/);
                let score = 0;
                queryWords.forEach((word) => {
                    const variants = SEARCH_SYNONYMS[word] ? [word, SEARCH_SYNONYMS[word]] : [word];
                    variants.forEach((variant) => {
                        if (haystack.includes(variant)) score += 3;
                        else if (haystackWords.some((hw) => fuzzyWordsMatch(hw, variant))) score += 1;
                    });
                });
                return score;
            }

            function filterProducts(rawQuery) {
                const query = String(rawQuery || "");
                const q = query.trim().toLowerCase();
                const container = document.getElementById("productsGrid");
                if (!container) return;
                if (!q) {
                    renderProducts();
                    return;
                }
                const queryWords = q.split(/\s+/).filter(Boolean);
                const ranked = products
                    .map((product) => ({ product, score: scoreProductAgainstQuery(product, queryWords) }))
                    .filter((entry) => entry.score > 0)
                    .sort((a, b) => b.score - a.score);

                container.innerHTML = ranked.length
                    ? ranked.map((entry) => createProductCard(entry.product)).join("")
                    : `<p class="col-span-full text-center text-gray-500 py-12">No products match "${escapeHtml(query.trim())}". Try a different search or <a href="#contact" class="text-blue-600 underline">contact us</a> for custom requirements.</p>`;
            }

            function initProductSearch() {
                const input = document.getElementById("productSearch");
                if (!input) return;
                input.addEventListener(
                    "input",
                    debounce(() => filterProducts(input.value), 150)
                );
            }

            function isSpeechRecognitionSupported() {
                return Boolean(window.SpeechRecognition || window.webkitSpeechRecognition);
            }

            function createSpeechRecognizer() {
                const SpeechRecognitionCtor = window.SpeechRecognition || window.webkitSpeechRecognition;
                const recognizer = new SpeechRecognitionCtor();
                recognizer.lang = "en-IN";
                recognizer.interimResults = false;
                recognizer.maxAlternatives = 1;
                return recognizer;
            }

            function attachVoiceInput(buttonEl, inputEl, options) {
                if (!buttonEl || !inputEl) return;
                const opts = options || {};
                let listening = false;

                buttonEl.addEventListener("click", () => {
                    if (listening) return;
                    let recognizer;
                    try {
                        recognizer = createSpeechRecognizer();
                    } catch (err) {
                        return;
                    }

                    listening = true;
                    buttonEl.classList.add("listening");
                    buttonEl.setAttribute("aria-label", opts.listeningLabel || "Listening…");

                    recognizer.onresult = (event) => {
                        const transcript = event.results[0][0].transcript;
                        inputEl.value = transcript;
                        inputEl.dispatchEvent(new Event("input", { bubbles: true }));
                        if (opts.onTranscript) opts.onTranscript(transcript);
                    };
                    recognizer.onerror = () => {
