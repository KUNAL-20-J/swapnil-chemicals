                                <button type="button" class="enquiry-trigger-btn" data-action="open-enquiry" data-product-id="${product.id}" aria-label="Send an enquiry for ${name}"><i class="fas fa-clipboard-list" aria-hidden="true"></i> Enquiry</button>
