                            : `<span class="product-badge"><i class="fas fa-tag" aria-hidden="true"></i>Per piece</span>`}
                        <img src="${escapeHtml(product.image)}" alt="${name}" class="product-image" ${imgLoading} decoding="async" width="400" height="250">
                        <div class="product-image-fallback"><i class="fas fa-image text-4xl mb-2" aria-hidden="true"></i><p>Image not available</p></div>
                    </div>
                    <div class="p-6">
                        <h3 class="text-xl font-bold text-gray-800 mb-3 group-hover:text-blue-600">${name}</h3>
                        <p class="text-gray-600 mb-4">${escapeHtml(product.description)}</p>
                        <div class="flex justify-between items-center">
                            <div class="text-2xl font-bold gradient-text">${formatCurrency(product.price)}<span class="text-lg text-gray-500 ml-1">/${escapeHtml(product.unit)}</span></div>
                            <div class="flex space-x-2">
