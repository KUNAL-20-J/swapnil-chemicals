        <style>
            /* =====================================================================
               Swapnil Chemicals — design system (2026 refresh)
               Layer order: tw (pre-built Tailwind, used by JS templates) < base <
               layout < components < utilities < states. Everything here is layered,
               so specificity fights are settled by layer order, not !important.
               ===================================================================== */
            @layer tw, base, layout, components, responsive, utilities, states;

            @property --angle {
                syntax: "<angle>";
                inherits: false;
                initial-value: 0deg;
            }

            /* ---------------------------------------------------------------- base */
            @layer base {
                :root {
                    /* Neutral "ink" scale (cool slate) */
                    --ink-950: oklch(0.16 0.03 262);
                    --ink-900: oklch(0.21 0.035 262);
                    --ink-800: oklch(0.28 0.035 262);
                    --ink-700: oklch(0.38 0.03 262);
                    --ink-600: oklch(0.46 0.028 262);
                    --ink-500: oklch(0.54 0.024 262);
                    --ink-400: oklch(0.66 0.02 262);
                    --ink-300: oklch(0.8 0.014 262);
                    --ink-200: oklch(0.9 0.01 262);
                    --ink-100: oklch(0.95 0.007 262);
                    --ink-50: oklch(0.982 0.004 262);

                    /* Brand: deep blue → aqua (water, gloss), amber for highlights */
                    --brand-800: oklch(0.4 0.15 262);
                    --brand-700: oklch(0.47 0.18 262);
                    --brand-600: oklch(0.55 0.2 260);
                    --brand-500: oklch(0.63 0.18 252);
                    --brand-200: oklch(0.88 0.06 250);
                    --brand-100: oklch(0.94 0.035 250);
                    --brand-50: oklch(0.975 0.015 250);
                    --aqua-300: oklch(0.86 0.11 200);
                    --aqua-500: oklch(0.74 0.14 208);
                    --amber-300: oklch(0.88 0.13 85);
                    --amber-500: oklch(0.78 0.17 68);
                    --wa-500: oklch(0.72 0.19 150);
                    --wa-600: oklch(0.6 0.16 152);
                    --danger-500: oklch(0.64 0.21 25);
                    --danger-600: oklch(0.57 0.21 27);
                    --danger-50: oklch(0.97 0.02 20);
                    --success-500: oklch(0.7 0.17 152);

                    /* Semantic tokens */
                    --bg: var(--ink-50);
                    --surface: #fff;
                    --surface-2: var(--ink-100);
                    --text: var(--ink-900);
                    --text-muted: var(--ink-500);
                    --border: var(--ink-200);
                    --focus: var(--brand-500);
                    --grad-brand: linear-gradient(135deg, var(--brand-600) 0%, var(--aqua-500) 100%);
                    /* Dark surfaces: rich brand blue instead of near-black */
                    --deep-800: oklch(0.38 0.14 262);
                    --deep-700: oklch(0.45 0.17 260);
                    --grad-ink: linear-gradient(160deg, oklch(0.38 0.15 262) 0%, oklch(0.5 0.17 250) 60%, oklch(0.58 0.14 225) 100%);

                    /* Type */
                    --font-sans: "Inter", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
                    --font-display: "Manrope", var(--font-sans);
                    --fs-xs: 0.75rem;
                    --fs-sm: 0.875rem;
                    --fs-base: 1rem;
                    --fs-lg: clamp(1.05rem, 0.98rem + 0.3vw, 1.2rem);
                    --fs-xl: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
                    --fs-2xl: clamp(1.75rem, 1.35rem + 1.6vw, 2.6rem);
                    --fs-hero: clamp(2.4rem, 1.5rem + 4.2vw, 4.6rem);

                    /* Shape & depth */
                    --radius-sm: 10px;
                    --radius-md: 14px;
                    --radius-lg: 20px;
                    --radius-xl: 28px;
                    --radius-pill: 999px;
                    --shadow-xs: 0 1px 2px oklch(0.2 0.03 262 / 0.06);
                    --shadow-sm: 0 1px 2px oklch(0.2 0.03 262 / 0.05), 0 4px 12px oklch(0.2 0.03 262 / 0.06);
                    --shadow-md: 0 2px 4px oklch(0.2 0.03 262 / 0.04), 0 12px 32px oklch(0.2 0.03 262 / 0.1);
                    --shadow-lg: 0 4px 8px oklch(0.2 0.03 262 / 0.05), 0 24px 60px oklch(0.2 0.03 262 / 0.16);
                    --shadow-brand: 0 10px 30px oklch(0.55 0.2 260 / 0.35);

                    /* Motion */
                    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
                    --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
                    --dur-fast: 0.15s;
                    --dur: 0.3s;

                    /* Layout */
                    --container: 1240px;
                    --gutter: clamp(16px, 4vw, 32px);
                    --header-h: 72px;
                    --section-y: clamp(64px, 8vw, 112px);

                    color-scheme: light;
                    accent-color: var(--brand-600);
                    interpolate-size: allow-keywords;
                }

                html {
                    scroll-padding-top: calc(var(--header-h) + 16px);
                    scrollbar-gutter: stable;
                    -webkit-font-smoothing: antialiased;
                    -moz-osx-font-smoothing: grayscale;
                    text-rendering: optimizeLegibility;
                }

                @media (prefers-reduced-motion: no-preference) {
                    html {
                        scroll-behavior: smooth;
                    }
                }

                body {
                    margin: 0;
                    min-height: 100dvh;
                    background: var(--bg);
                    color: var(--text);
                    font-family: var(--font-sans);
                    font-size: var(--fs-base);
                    line-height: 1.6;
                    font-feature-settings: "cv11", "ss01";
                    overflow-x: clip;
                }

                h1,
                h2,
                h3,
                h4 {
                    font-family: var(--font-display);
                    line-height: 1.15;
                    letter-spacing: -0.02em;
                    text-wrap: balance;
                    color: inherit;
                }

                p {
                    text-wrap: pretty;
                }

                img {
                    max-width: 100%;
                    height: auto;
                }

                a {
                    color: inherit;
                    text-decoration: none;
                }

                ::selection {
                    background: var(--brand-600);
                    color: #fff;
                }

                :where(button, a, input, textarea, select, summary, [tabindex]):focus-visible {
                    outline: 3px solid var(--focus);
                    outline-offset: 3px;
                    border-radius: 8px;
                }

                ::-webkit-scrollbar {
                    width: 10px;
                    height: 10px;
                }
                ::-webkit-scrollbar-track {
                    background: var(--ink-100);
                }
                ::-webkit-scrollbar-thumb {
                    background: var(--ink-300);
                    border-radius: 10px;
                    border: 2px solid var(--ink-100);
                }
                ::-webkit-scrollbar-thumb:hover {
                    background: var(--ink-400);
                }

                @media (prefers-reduced-motion: reduce) {
                    *,
                    *::before,
                    *::after {
                        animation-duration: 0.01ms !important;
                        animation-iteration-count: 1 !important;
                        transition-duration: 0.01ms !important;
                        scroll-behavior: auto !important;
                    }
                }
            }

            /* -------------------------------------------------------------- layout */
            @layer layout {
                .container {
                    width: 100%;
                    max-width: calc(var(--container) + var(--gutter) * 2);
                    margin-inline: auto;
                    padding-inline: var(--gutter);
                }

                .section {
                    padding-block: var(--section-y);
                    position: relative;
                }

                .section-alt {
                    background: var(--surface);
                    border-block: 1px solid var(--border);
                }

                .section-head {
                    max-width: 720px;
                    margin: 0 auto clamp(32px, 5vw, 56px);
                    text-align: center;
                }

                .section-head.is-split {
                    max-width: none;
                    display: flex;
                    flex-wrap: wrap;
                    align-items: end;
                    justify-content: space-between;
                    gap: 24px;
                    text-align: left;
                }

                .section-head.is-split > div {
                    max-width: 600px;
                }

                .section-title {
                    font-size: var(--fs-2xl);
                    font-weight: 800;
                    margin: 12px 0 0;
                }

                .section-lead {
                    margin: 14px 0 0;
                    color: var(--text-muted);
                    font-size: var(--fs-lg);
                }

                .section-eyebrow {
                    display: inline-flex;
                    align-items: center;
                    gap: 8px;
                    padding: 6px 14px;
                    border-radius: var(--radius-pill);
                    background: var(--brand-50);
                    border: 1px solid var(--brand-100);
                    color: var(--brand-700);
                    font-size: var(--fs-xs);
                    font-weight: 700;
                    letter-spacing: 0.08em;
                    text-transform: uppercase;
                }

                .section-eyebrow::before {
                    content: "";
                    width: 6px;
                    height: 6px;
                    border-radius: 50%;
                    background: var(--grad-brand);
                }

                .on-dark .section-eyebrow {
                    background: oklch(1 0 0 / 0.08);
                    border-color: oklch(1 0 0 / 0.14);
                    color: var(--aqua-300);
                }

                #products,
                #faq,
                #contact {
                    content-visibility: auto;
                    contain-intrinsic-size: auto 1000px;
                }
            }

            /* ---------------------------------------------------------- components */
            @layer components {
                /* ---------- Skip link & scroll progress ---------- */
                .skip-link {
                    position: fixed;
                    top: 12px;
                    left: 12px;
                    z-index: 1000;
                    padding: 10px 16px;
                    border-radius: var(--radius-sm);
                    background: var(--deep-700);
                    color: #fff;
                    font-weight: 600;
                    translate: 0 -200%;
                    transition: translate var(--dur) var(--ease-out);
                }
                .skip-link:focus-visible {
                    translate: 0 0;
                }

                .scroll-progress {
                    position: fixed;
                    inset: 0 0 auto 0;
                    height: 3px;
                    z-index: 70;
                    width: 100%;
                    background: var(--grad-brand);
                    transform-origin: 0 50%;
                    transform: scaleX(0);
                    pointer-events: none;
                }

                @supports (animation-timeline: scroll()) {
                    .scroll-progress {
                        transform: none;
                        scale: 0 1;
                        animation: progress-grow linear both;
                        animation-timeline: scroll(root block);
                    }
                }

                @keyframes progress-grow {
                    to {
                        scale: 1 1;
                    }
                }

                /* ---------- Buttons ---------- */
                .btn {
                    --tx: 0px;
                    --ty: 0px;
                    position: relative;
                    isolation: isolate;
                    overflow: hidden;
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    gap: 10px;
                    min-height: 48px;
                    padding: 12px 24px;
                    border-radius: var(--radius-md);
                    font-weight: 600;
                    font-size: var(--fs-base);
                    line-height: 1.2;
                    white-space: nowrap;
                    cursor: pointer;
                    border: 1px solid transparent;
                    translate: var(--tx) var(--ty);
                    transition:
                        translate var(--dur) var(--ease-out),
                        background-color var(--dur-fast),
                        box-shadow var(--dur),
                        border-color var(--dur-fast),
                        color var(--dur-fast);
                }

                .btn-lg {
                    min-height: 56px;
                    padding: 14px 28px;
                    font-size: var(--fs-lg);
                }

                .btn-primary {
                    background: var(--grad-brand);
                    color: #fff;
                    box-shadow: var(--shadow-brand);
                }
                .btn-primary:hover {
                    box-shadow: 0 14px 40px oklch(0.55 0.2 260 / 0.45);
                }

                .btn-glass {
                    background: oklch(1 0 0 / 0.08);
                    border-color: oklch(1 0 0 / 0.2);
                    color: #fff;
                    backdrop-filter: blur(8px);
                }
                .btn-glass:hover {
                    background: oklch(1 0 0 / 0.16);
                }

                .btn-light {
                    background: #fff;
                    color: var(--ink-900);
                    box-shadow: var(--shadow-sm);
                }
                .btn-light:hover {
                    box-shadow: var(--shadow-md);
                }

                .btn-whatsapp {
                    background: var(--wa-600);
                    color: #fff;
                }
                .btn-whatsapp:hover {
                    background: oklch(0.55 0.16 152);
                }

                /* Sheen sweep on hover */
                .btn-shine::after {
                    content: "";
                    position: absolute;
                    inset: 0;
                    z-index: -1;
                    background: linear-gradient(110deg, transparent 30%, oklch(1 0 0 / 0.35) 50%, transparent 70%);
                    translate: -110% 0;
                    transition: translate 0.7s var(--ease-out);
                    pointer-events: none;
                }
                .btn-shine:hover::after {
                    translate: 110% 0;
                }

                .ripple {
                    position: absolute;
                    border-radius: 50%;
                    background: oklch(1 0 0 / 0.35);
                    scale: 0;
                    pointer-events: none;
                    animation: ripple-out 0.65s var(--ease-out) forwards;
                }
                @keyframes ripple-out {
                    to {
                        scale: 1;
                        opacity: 0;
                    }
                }

                .bump {
                    animation: bump 0.45s var(--ease-spring);
                }
                @keyframes bump {
                    40% {
                        scale: 1.25;
                    }
                }

                .link-btn {
                    background: none;
                    border: 0;
                    padding: 0;
                    color: var(--brand-600);
                    font: inherit;
                    font-weight: 700;
                    text-decoration: underline;
                    text-underline-offset: 3px;
                    cursor: pointer;
                }

                /* ---------- Header ---------- */
                .site-header {
                    position: sticky;
                    top: 0;
                    z-index: 60;
                    background: oklch(1 0 0 / 0.86);
                    backdrop-filter: saturate(1.6) blur(14px);
                    -webkit-backdrop-filter: saturate(1.6) blur(14px);
                    border-bottom: 1px solid transparent;
                    transition:
                        border-color var(--dur),
                        box-shadow var(--dur),
                        background-color var(--dur);
                }
                .site-header.scrolled {
                    background: oklch(1 0 0 / 0.95);
                    border-bottom-color: var(--border);
                    box-shadow: var(--shadow-sm);
                }

                .header-inner {
                    display: flex;
                    align-items: center;
                    gap: 24px;
                    min-height: 72px;
                }

                .brand {
                    display: flex;
                    align-items: center;
                    gap: 12px;
                    min-width: 0;
                    margin-right: auto;
                }

                .brand-logo {
                    position: relative;
                    flex-shrink: 0;
                    width: 46px;
                    height: 46px;
                    border-radius: 14px;
                    background: #fff;
                    box-shadow:
                        0 0 0 1px var(--border),
                        var(--shadow-xs);
                }
                .brand-logo img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    border-radius: inherit;
                }
                .brand-status {
                    position: absolute;
                    right: -3px;
                    bottom: -3px;
                    width: 13px;
                    height: 13px;
                    border-radius: 50%;
                    background: var(--success-500);
                    border: 2px solid #fff;
                }

                .brand-text {
                    display: grid;
                    min-width: 0;
                }
                .brand-name {
                    font-family: var(--font-display);
                    font-weight: 800;
                    font-size: 1.15rem;
                    letter-spacing: -0.02em;
                    line-height: 1.2;
                }
                .brand-tag {
                    font-size: var(--fs-xs);
                    color: var(--text-muted);
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }

                .site-nav ul {
                    display: flex;
                    gap: 4px;
                    list-style: none;
                    margin: 0;
                    padding: 0;
                }
                .site-nav a {
                    display: block;
                    padding: 8px 14px;
                    border-radius: var(--radius-pill);
                    font-size: var(--fs-sm);
                    font-weight: 600;
                    color: var(--ink-700);
                    transition:
                        background-color var(--dur-fast),
                        color var(--dur-fast);
                }
                .site-nav a:hover {
                    background: var(--ink-100);
                    color: var(--ink-950);
                }

                .header-actions {
                    display: flex;
                    align-items: center;
                    gap: 10px;
                }

                .header-call {
                    display: inline-flex;
                    align-items: center;
                    gap: 8px;
                    min-height: 44px;
                    padding: 0 16px;
                    border-radius: var(--radius-pill);
                    background: var(--deep-700);
                    color: #fff;
                    font-size: var(--fs-sm);
                    font-weight: 600;
                    transition: background-color var(--dur-fast);
                }
                .header-call:hover {
                    background: var(--brand-700);
                }

                .icon-btn,
                .cart-icon-btn {
                    position: relative;
                    display: inline-grid;
                    place-items: center;
                    width: 44px;
                    height: 44px;
                    border-radius: 50%;
                    background: var(--surface);
                    border: 1px solid var(--border);
                    color: var(--ink-800);
                    cursor: pointer;
                    transition:
                        background-color var(--dur-fast),
                        border-color var(--dur-fast),
                        color var(--dur-fast),
                        scale var(--dur) var(--ease-spring);
                }
                .icon-btn:hover,
                .cart-icon-btn:hover {
                    border-color: var(--brand-200);
                    color: var(--brand-600);
                    background: var(--brand-50);
                }
                .cart-icon-btn:active {
                    scale: 0.92;
                }

                .cart-badge {
                    position: absolute;
                    top: -4px;
                    right: -4px;
                    min-width: 20px;
                    height: 20px;
                    padding: 0 5px;
                    border-radius: var(--radius-pill);
                    background: var(--danger-500);
                    color: #fff;
                    font-size: 11px;
                    font-weight: 800;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    border: 2px solid #fff;
                    font-variant-numeric: tabular-nums;
                }
                /* JS toggles the native `hidden` attribute instead of writing inline styles. */
                .cart-badge[hidden],
                .cart-panel-footer[hidden] {
                    display: none;
                }

                /* Shown only when JavaScript is off (see <noscript> at the top of <body>). */
                .noscript-banner {
                    padding: 12px 16px;
                    background: #fef2f2;
                    color: #991b1b;
                    font: 14px/1.5 system-ui, sans-serif;
                    text-align: center;
                }
                .noscript-banner a {
                    color: inherit;
                    font-weight: 700;
                }

                .menu-btn {
                    display: none;
                }

                .mobile-nav {
                    position: fixed;
                    inset: calc(var(--header-h) + 8px) 12px auto 12px;
                    margin: 0;
                    width: auto;
                    padding: 12px;
                    border: 1px solid var(--border);
                    border-radius: var(--radius-lg);
                    background: var(--surface);
                    box-shadow: var(--shadow-lg);
                    opacity: 1;
                    translate: 0 0;
                    transition:
                        opacity var(--dur) var(--ease-out),
                        translate var(--dur) var(--ease-out),
                        display var(--dur) allow-discrete,
                        overlay var(--dur) allow-discrete;
                }
                .mobile-nav:not(:popover-open) {
                    opacity: 0;
                    translate: 0 -8px;
                }
                @starting-style {
                    .mobile-nav:popover-open {
                        opacity: 0;
                        translate: 0 -8px;
                    }
                }
                .mobile-nav::backdrop {
                    background: oklch(0.3 0.1 262 / 0.3);
                }
                .mobile-nav ul {
                    list-style: none;
                    margin: 0;
                    padding: 0;
                    display: grid;
                    gap: 2px;
                }
                .mobile-nav a {
                    display: flex;
                    align-items: center;
                    gap: 12px;
                    padding: 14px 16px;
                    border-radius: var(--radius-md);
                    font-weight: 600;
                }
                .mobile-nav a:hover {
                    background: var(--ink-100);
                }
                .mobile-nav a i {
                    width: 20px;
                    color: var(--brand-600);
                    text-align: center;
                }
                .mobile-nav .mobile-nav-cta {
                    margin-top: 8px;
                    padding-top: 12px;
                    border-top: 1px solid var(--border);
                    display: grid;
                    grid-template-columns: 1fr 1fr;
                    gap: 8px;
                }
                .mobile-nav .mobile-nav-cta .btn {
                    min-height: 44px;
                    padding: 10px 12px;
                    font-size: var(--fs-sm);
                }

                /* ---------- Hero ---------- */
                .hero {
                    position: relative;
                    isolation: isolate;
                    overflow: hidden;
                    background: var(--grad-ink);
                    color: #fff;
                    padding-block: clamp(56px, 8vw, 104px) clamp(72px, 9vw, 120px);
                }

                .hero-aurora {
                    position: absolute;
                    inset: 0;
                    z-index: -2;
                    overflow: hidden;
                    pointer-events: none;
                }
                .aurora-orb {
                    position: absolute;
                    border-radius: 50%;
                    filter: blur(80px);
                    opacity: 0.55;
                    animation: aurora-drift 22s ease-in-out infinite alternate;
                }
                .orb-1 {
                    width: 520px;
                    height: 520px;
                    top: -180px;
                    left: -120px;
                    background: var(--brand-600);
                }
                .orb-2 {
                    width: 420px;
                    height: 420px;
                    top: 10%;
                    right: -120px;
                    background: var(--aqua-500);
                    opacity: 0.4;
                    animation-delay: -7s;
                }
                .orb-3 {
                    width: 360px;
                    height: 360px;
                    bottom: -180px;
                    left: 40%;
                    background: var(--amber-500);
                    opacity: 0.22;
                    animation-delay: -14s;
                }
                @keyframes aurora-drift {
                    to {
                        translate: 60px 40px;
                        scale: 1.12;
                    }
                }

                .hero-grid {
                    position: absolute;
                    inset: 0;
                    z-index: -1;
                    background-image:
                        linear-gradient(oklch(1 0 0 / 0.05) 1px, transparent 1px),
                        linear-gradient(90deg, oklch(1 0 0 / 0.05) 1px, transparent 1px);
                    background-size: 56px 56px;
                    mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 30%, transparent 75%);
                    pointer-events: none;
                }

                .hero-inner {
                    display: grid;
                    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
                    align-items: center;
                    gap: clamp(40px, 6vw, 80px);
                }

                .hero-content-in > * {
                    animation: rise-in 0.8s var(--ease-out) both;
                }
                .hero-content-in > :nth-child(2) {
                    animation-delay: 0.08s;
                }
                .hero-content-in > :nth-child(3) {
                    animation-delay: 0.16s;
                }
                .hero-content-in > :nth-child(4) {
                    animation-delay: 0.24s;
                }
                .hero-content-in > :nth-child(5) {
                    animation-delay: 0.32s;
                }
                @keyframes rise-in {
                    from {
                        opacity: 0;
                        translate: 0 24px;
                    }
                }

                .hero-chip {
                    display: inline-flex;
                    align-items: center;
                    gap: 10px;
                    padding: 8px 16px 8px 12px;
                    border-radius: var(--radius-pill);
                    background: oklch(1 0 0 / 0.08);
                    border: 1px solid oklch(1 0 0 / 0.16);
                    font-size: var(--fs-sm);
                    font-weight: 500;
                    color: oklch(1 0 0 / 0.9);
                    backdrop-filter: blur(6px);
                }
                .hero-chip-dot {
                    position: relative;
                    width: 8px;
                    height: 8px;
                    border-radius: 50%;
                    background: var(--success-500);
                }
                .hero-chip-dot::after {
                    content: "";
                    position: absolute;
                    inset: -4px;
                    border-radius: 50%;
                    border: 2px solid var(--success-500);
                    animation: ping 2s var(--ease-out) infinite;
                }
                @keyframes ping {
                    from {
                        scale: 0.6;
                        opacity: 1;
                    }
                    to {
                        scale: 1.8;
                        opacity: 0;
                    }
                }

                .hero-title {
                    margin: 24px 0 0;
                    font-size: var(--fs-hero);
                    font-weight: 800;
                    line-height: 1.04;
                    letter-spacing: -0.035em;
                }
                .hero-shine-text {
                    display: inline-block;
                    /* Extra bottom padding keeps descenders ("g") inside the clipped gradient. */
                    padding-bottom: 0.08em;
                    background: linear-gradient(100deg, var(--aqua-300), #fff 70%);
                    -webkit-background-clip: text;
                    background-clip: text;
                    color: transparent;
                }

                .hero-lead {
                    margin: 22px 0 0;
                    max-width: 56ch;
                    font-size: var(--fs-lg);
                    color: oklch(1 0 0 / 0.78);
                }

                .hero-actions {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 12px;
                    margin-top: 32px;
                }

                .hero-stats {
                    display: grid;
                    grid-template-columns: repeat(4, minmax(0, 1fr));
                    gap: 1px;
                    margin: 44px 0 0;
                    border-radius: var(--radius-lg);
                    overflow: hidden;
                    background: oklch(1 0 0 / 0.1);
                    border: 1px solid oklch(1 0 0 / 0.1);
                }
                .hero-stats div {
                    display: flex;
                    flex-direction: column;
                    padding: 16px 18px;
                    background: oklch(1 0 0 / 0.1);
                }
                .hero-stats dt {
                    font-size: var(--fs-xs);
                    color: oklch(1 0 0 / 0.6);
                    order: 2;
                }
                .hero-stats dd {
                    margin: 0;
                    font-family: var(--font-display);
                    font-weight: 800;
                    font-size: 1.35rem;
                    letter-spacing: -0.02em;
                }

                /* Trade price list card (hero, right column) */
                .trade-card {
                    display: grid;
                    gap: 18px;
                    padding: clamp(20px, 2.4vw, 28px);
                    border-radius: var(--radius-xl);
                    background: var(--surface);
                    color: var(--text);
                    border: 1px solid oklch(1 0 0 / 0.5);
                    box-shadow: 0 30px 80px oklch(0.2 0.1 262 / 0.35);
                    animation: rise-in 0.9s var(--ease-out) 0.2s both;
                }
                .trade-head {
                    display: flex;
                    align-items: flex-start;
                    justify-content: space-between;
                    gap: 12px;
                }
                .trade-eyebrow {
                    margin: 0;
                    font-size: var(--fs-xs);
                    font-weight: 700;
                    letter-spacing: 0.08em;
                    text-transform: uppercase;
                    color: var(--brand-600);
                }
                .trade-title {
                    margin: 4px 0 0;
                    font-family: var(--font-display);
                    font-size: 1.15rem;
                    font-weight: 800;
                    letter-spacing: -0.01em;
                    line-height: 1.25;
                }
                .trade-badge {
                    display: inline-flex;
                    align-items: center;
                    gap: 6px;
                    flex-shrink: 0;
                    padding: 6px 10px;
                    border-radius: var(--radius-pill);
                    background: oklch(0.95 0.05 155);
                    color: oklch(0.42 0.12 155);
                    font-size: var(--fs-xs);
                    font-weight: 700;
                    white-space: nowrap;
                }
                .trade-list {
                    margin: 0;
                    padding: 0;
                    list-style: none;
                    border-block: 1px solid var(--border);
                }
                .trade-list li + li {
                    border-top: 1px solid var(--border);
                }
                .trade-row {
                    display: grid;
                    grid-template-columns: minmax(0, 1fr) auto;
                    align-items: center;
                    gap: 2px 12px;
                    width: 100%;
                    padding: 11px 4px;
                    background: none;
                    border: 0;
                    color: inherit;
                    text-align: left;
                    cursor: pointer;
                    border-radius: var(--radius-sm);
                    transition: background-color var(--dur-fast);
                }
                .trade-row:hover {
                    background: var(--surface-2);
                }
                .trade-row:focus-visible {
                    outline: 2px solid var(--brand-600);
                    outline-offset: 2px;
                }
                .trade-name {
                    font-weight: 600;
                    font-size: var(--fs-sm);
                }
                .trade-packs {
                    grid-column: 1;
                    font-size: var(--fs-xs);
                    color: var(--text-muted);
                }
                .trade-price {
                    grid-row: 1 / span 2;
                    grid-column: 2;
                    text-align: right;
                    font-family: var(--font-display);
                    font-weight: 800;
                    font-variant-numeric: tabular-nums;
                    white-space: nowrap;
                }
                .trade-price small {
                    display: block;
                    font-family: var(--font-sans);
                    font-size: var(--fs-xs);
                    font-weight: 500;
                    color: var(--text-muted);
                }
                .trade-price .trade-from {
                    display: inline;
                    margin-right: 4px;
                }
                .trade-note {
                    margin: 0;
                    font-size: var(--fs-xs);
                    color: var(--text-muted);
                }
                .trade-actions {
                    display: grid;
                    grid-template-columns: 1fr 1fr;
                    gap: 10px;
                }
                .trade-actions .btn {
                    justify-content: center;
                }

                .hero-scroll-cue {
                    position: absolute;
                    left: 50%;
                    bottom: 22px;
                    translate: -50% 0;
                    opacity: 0.7;
                    transition: opacity var(--dur-fast);
                }
                .hero-scroll-cue:hover {
                    opacity: 1;
                }
                .hero-scroll-mouse {
                    display: block;
                    width: 24px;
                    height: 38px;
                    border: 2px solid oklch(1 0 0 / 0.6);
                    border-radius: 14px;
                    position: relative;
                }
                .hero-scroll-mouse span {
                    position: absolute;
                    left: 50%;
                    top: 7px;
                    width: 4px;
                    height: 8px;
                    margin-left: -2px;
                    border-radius: 2px;
                    background: #fff;
                    animation: scroll-wheel 1.8s ease-in-out infinite;
                }
                @keyframes scroll-wheel {
                    60% {
                        translate: 0 10px;
                        opacity: 0;
                    }
                    100% {
                        opacity: 0;
                    }
                }

                /* ---------- Credentials (bento) ---------- */
                .bento {
                    display: grid;
                    grid-template-columns: repeat(4, minmax(0, 1fr));
                    gap: 16px;
                }

                .feature-card {
                    position: relative;
                    display: flex;
                    flex-direction: column;
                    gap: 14px;
                    padding: 24px;
                    border-radius: var(--radius-lg);
                    background: var(--surface);
                    border: 1px solid var(--border);
                    box-shadow: var(--shadow-xs);
                    transition:
                        box-shadow var(--dur) var(--ease-out),
                        border-color var(--dur),
                        transform var(--dur) var(--ease-out);
                }
                .feature-card:hover {
                    transform: translateY(-3px);
                    border-color: var(--brand-200);
                    box-shadow: var(--shadow-md);
                }

                .feature-card.is-hero {
                    grid-column: span 2;
                    grid-row: span 2;
                    justify-content: space-between;
                    background: var(--grad-ink);
                    color: #fff;
                    border-color: transparent;
                    overflow: hidden;
                }
                .feature-card.is-hero::after {
                    content: "";
                    position: absolute;
                    width: 320px;
                    height: 320px;
                    right: -100px;
                    top: -120px;
                    border-radius: 50%;
                    background: radial-gradient(circle, oklch(0.74 0.14 208 / 0.45), transparent 70%);
                    pointer-events: none;
                }
                .feature-card.is-wide {
                    grid-column: span 2;
                }

                .feature-icon {
                    display: grid;
                    place-items: center;
                    width: 48px;
                    height: 48px;
                    border-radius: 14px;
                    font-size: 1.15rem;
                    color: var(--icon-fg, var(--brand-600));
                    background: var(--icon-bg, var(--brand-50));
                    flex-shrink: 0;
                }
                .feature-icon.tone-green {
                    --icon-fg: oklch(0.55 0.15 152);
                    --icon-bg: oklch(0.96 0.04 152);
                }
                .feature-icon.tone-violet {
                    --icon-fg: oklch(0.52 0.2 295);
                    --icon-bg: oklch(0.96 0.03 295);
                }
                .feature-icon.tone-red {
                    --icon-fg: var(--danger-600);
                    --icon-bg: var(--danger-50);
                }
                .feature-icon.tone-amber {
                    --icon-fg: oklch(0.6 0.15 65);
                    --icon-bg: oklch(0.97 0.04 85);
                }
                .feature-icon.tone-teal {
                    --icon-fg: oklch(0.55 0.11 195);
                    --icon-bg: oklch(0.96 0.03 195);
                }
                .feature-icon.tone-glass {
                    --icon-fg: #fff;
                    --icon-bg: oklch(1 0 0 / 0.12);
                }

                .feature-label {
                    margin: 0;
                    font-family: var(--font-sans);
                    font-size: var(--fs-xs);
                    font-weight: 600;
                    letter-spacing: 0.08em;
                    text-transform: uppercase;
                    color: var(--text-muted);
                }
                .feature-value {
                    margin: 4px 0 0;
                    font-weight: 700;
                    font-size: 1.05rem;
                    color: var(--ink-900);
                    overflow-wrap: anywhere;
                }
                .feature-value.mono {
                    font-family: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, Consolas, monospace;
                    font-size: 0.98rem;
                    letter-spacing: 0.01em;
                }
                .feature-value a {
                    color: var(--brand-700);
                    transition: color var(--dur-fast);
                }
                .feature-value a:hover {
                    color: var(--brand-500);
                }
                .feature-value .stack {
                    display: block;
                }

                .copy-btn {
                    display: inline-grid;
                    place-items: center;
                    width: 30px;
                    height: 30px;
                    margin-left: 6px;
                    vertical-align: middle;
                    border-radius: 8px;
                    border: 1px solid var(--border);
                    background: var(--surface);
                    color: var(--ink-500);
                    cursor: pointer;
                    font-size: 0.8rem;
                    transition:
                        color var(--dur-fast),
                        border-color var(--dur-fast),
                        background-color var(--dur-fast);
                }
                .copy-btn:hover {
                    color: var(--brand-600);
                    border-color: var(--brand-200);
                    background: var(--brand-50);
                }

                .owner-name {
                    margin: 20px 0 0;
                    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.2rem);
                    font-weight: 800;
                }
                .owner-role {
                    margin: 6px 0 0;
                    color: oklch(1 0 0 / 0.7);
                }
                .owner-points {
                    position: relative;
                    z-index: 1;
                    display: flex;
                    flex-wrap: wrap;
                    gap: 8px;
                    list-style: none;
                    margin: 0;
                    padding: 0;
                }
                .owner-points li {
                    display: inline-flex;
                    align-items: center;
                    gap: 8px;
                    padding: 8px 12px;
                    border-radius: var(--radius-pill);
                    background: oklch(1 0 0 / 0.08);
                    border: 1px solid oklch(1 0 0 / 0.12);
                    font-size: var(--fs-sm);
                }
                .owner-points i {
                    color: var(--aqua-300);
                }

                /* ---------- Search ---------- */
                .search-box {
                    position: relative;
                    width: min(100%, 420px);
                }
                .search-box > i {
                    position: absolute;
                    left: 18px;
                    top: 50%;
                    translate: 0 -50%;
                    color: var(--ink-400);
                    pointer-events: none;
                }
                #productSearch {
                    width: 100%;
                    min-height: 52px;
                    padding: 0 56px 0 46px;
                    border-radius: var(--radius-pill);
                    border: 1px solid var(--border);
                    background: var(--surface);
                    font-size: var(--fs-sm);
                    box-shadow: var(--shadow-xs);
                    transition:
                        border-color var(--dur-fast),
                        box-shadow var(--dur);
                }
                #productSearch:focus {
                    outline: none;
                    border-color: var(--brand-500);
                    box-shadow: 0 0 0 4px oklch(0.63 0.18 252 / 0.18);
                }
                #productSearch::-webkit-search-cancel-button {
                    cursor: pointer;
                }

                .voice-btn,
                .voice-btn-inline {
                    display: grid;
                    place-items: center;
                    width: 40px;
                    height: 40px;
                    border-radius: 50%;
                    border: 0;
                    background: var(--ink-100);
                    color: var(--ink-700);
                    cursor: pointer;
                    transition:
                        background-color var(--dur-fast),
                        color var(--dur-fast);
                }
                .voice-btn {
                    position: absolute;
                    right: 6px;
                    top: 50%;
                    translate: 0 -50%;
                }
                .voice-btn:hover,
                .voice-btn-inline:hover {
                    background: var(--brand-100);
                    color: var(--brand-700);
                }
                .voice-btn.listening,
                .voice-btn-inline.listening {
                    background: var(--danger-500);
                    color: #fff;
                    animation: listening 1.2s ease-out infinite;
                }
                @keyframes listening {
                    0% {
                        box-shadow: 0 0 0 0 oklch(0.64 0.21 25 / 0.5);
                    }
                    100% {
                        box-shadow: 0 0 0 14px oklch(0.64 0.21 25 / 0);
                    }
                }

                /* ---------- Product grid & cards (markup rendered by JS) ---------- */
                .products-grid {
                    display: grid;
                    grid-template-columns: repeat(auto-fill, minmax(min(100%, 270px), 1fr));
                    gap: 20px;
                }

                .product-card {
                    --rx: 0deg;
                    --ry: 0deg;
                    --mx: 50%;
                    --my: 50%;
                    container-type: inline-size;
                    position: relative;
                    display: flex;
                    flex-direction: column;
                    border-radius: var(--radius-lg);
                    background: var(--surface);
                    border: 1px solid var(--border);
                    box-shadow: var(--shadow-xs);
                    overflow: hidden;
                    transform: perspective(900px) rotateX(var(--rx)) rotateY(var(--ry));
                    transition:
                        transform 0.4s var(--ease-out),
                        box-shadow var(--dur) var(--ease-out),
                        border-color var(--dur);
                }
                .product-card:hover {
                    border-color: var(--brand-200);
                    box-shadow: var(--shadow-lg);
                }
                .product-card.is-tilting {
                    transition:
                        transform 0.08s linear,
                        box-shadow var(--dur),
                        border-color var(--dur);
                }

                .product-spotlight {
                    position: absolute;
                    inset: 0;
                    z-index: 2;
                    pointer-events: none;
                    background: radial-gradient(
                        400px circle at var(--mx) var(--my),
                        oklch(0.74 0.14 208 / 0.12),
                        transparent 45%
                    );
                    opacity: 0;
                    transition: opacity var(--dur);
                }
                .product-card:hover .product-spotlight {
                    opacity: 1;
                }

                .product-image-container {
                    position: relative;
                    aspect-ratio: 4 / 3;
                    margin: 8px 8px 0;
                    border-radius: calc(var(--radius-lg) - 6px);
                    background:
                        radial-gradient(circle at 50% 60%, #fff 0%, transparent 70%),
                        linear-gradient(160deg, var(--brand-50), var(--ink-100));
                    overflow: hidden;
                }
                .product-image-container::before {
                    content: "";
                    position: absolute;
                    inset: 0;
                    background: var(--ink-100);
                    animation: skeleton 1.4s ease-in-out infinite;
                    transition: opacity var(--dur);
                }
                .product-image-container:has(.product-image.loaded)::before,
                .product-image-container:has(.product-image.is-broken)::before {
                    opacity: 0;
                    animation: none;
                }
                /* Set by the delegated image `error` listener when a product photo fails to load. */
                .product-image.is-broken {
                    display: none;
                }
                .product-image.is-broken + .product-image-fallback {
                    opacity: 1;
                }
                @keyframes skeleton {
                    50% {
                        opacity: 0.5;
                    }
                }
                .product-image {
                    position: relative;
                    width: 100%;
                    height: 100%;
                    padding: 18px;
                    object-fit: contain;
                    opacity: 0;
                    filter: drop-shadow(0 14px 18px oklch(0.2 0.03 262 / 0.18));
                    transition:
                        opacity 0.5s,
                        scale 0.6s var(--ease-out);
                }
                .product-image.loaded {
                    opacity: 1;
                }
                .product-card:hover .product-image {
                    scale: 1.06;
                }
                .product-image-fallback {
                    position: absolute;
                    inset: 0;
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    justify-content: center;
                    color: var(--ink-400);
                    font-size: var(--fs-sm);
                    opacity: 0;
                    pointer-events: none;
                }

                .product-card > .p-6 {
                    position: relative;
                    z-index: 3;
                    display: flex;
                    flex-direction: column;
                    flex: 1;
                    padding: 18px 20px 20px;
                }
                .product-card h3 {
                    margin: 0 0 6px;
                    font-size: 1.15rem;
                    font-weight: 800;
                    line-height: 1.25;
                    color: var(--ink-900);
                    transition: color var(--dur-fast);
                }
                .product-card:hover h3 {
                    color: var(--brand-700);
                }
                .product-card h3 + p {
                    margin: 0 0 16px;
                    font-size: var(--fs-sm);
                    color: var(--text-muted);
                    line-height: 1.5;
                }
                .product-card > .p-6 > .flex {
                    margin-top: auto;
                    flex-wrap: wrap;
                    gap: 10px;
                }
                .product-card .gradient-text {
                    font-family: var(--font-display);
                    font-size: 1.5rem;
                    font-weight: 800;
                    letter-spacing: -0.02em;
                    line-height: 1;
                    white-space: nowrap;
                }
                .product-card .gradient-text span {
                    margin-left: 2px;
                    font-family: var(--font-sans);
                    font-size: var(--fs-xs);
                    font-weight: 600;
                    color: var(--text-muted);
                    -webkit-text-fill-color: var(--text-muted);
                }
                .product-card .space-x-2 {
                    display: flex;
                    gap: 6px;
                }
                .product-card .space-x-2 > * {
                    margin: 0 !important;
                }
                .product-card a[href^="tel:"] {
                    display: inline-grid;
                    place-items: center;
                    width: 40px;
                    height: 40px;
                    padding: 0;
                    border-radius: 12px;
                    background: var(--brand-50);
                    border: 1px solid var(--brand-100);
                    color: var(--brand-700);
                    transition:
                        background-color var(--dur-fast),
                        color var(--dur-fast);
                }
                .product-card a[href^="tel:"]:hover {
                    background: var(--brand-600);
                    color: #fff;
                }

                .enquiry-trigger-btn {
                    position: relative;
                    overflow: hidden;
                    display: inline-flex;
                    align-items: center;
                    gap: 6px;
                    height: 40px;
                    padding: 0 14px;
                    border-radius: 12px;
                    border: 1px solid var(--border);
                    background: var(--surface);
                    color: var(--ink-800);
                    font-size: var(--fs-sm);
                    font-weight: 600;
                    cursor: pointer;
                    transition:
                        border-color var(--dur-fast),
                        color var(--dur-fast),
                        background-color var(--dur-fast);
                }
                .enquiry-trigger-btn:hover {
                    border-color: var(--deep-700);
                    background: var(--deep-700);
                    color: #fff;
                }

                .qty-section {
                    margin-top: 16px;
                    padding-top: 14px;
                    border-top: 1px dashed var(--border);
                }
                .qty-section > p {
                    margin: 0 0 8px;
                    font-size: 11px;
                    letter-spacing: 0.06em;
                    text-transform: uppercase;
                    color: var(--text-muted);
                }
                .qty-section .flex {
                    gap: 6px;
                    margin-bottom: 4px;
                }
                .qty-btn,
                .enquiry-qty-btn {
                    min-height: 34px;
                    padding: 0 12px;
                    border-radius: var(--radius-pill);
                    border: 1px solid var(--border);
                    background: var(--surface);
                    color: var(--ink-700);
                    font-size: var(--fs-xs);
                    font-weight: 700;
                    cursor: pointer;
                    transition:
                        background-color var(--dur-fast),
                        color var(--dur-fast),
                        border-color var(--dur-fast),
                        scale var(--dur) var(--ease-spring);
                }
                .qty-btn:hover,
                .enquiry-qty-btn:hover {
                    border-color: var(--brand-500);
                    color: var(--brand-700);
                }
                .qty-btn.active,
                .enquiry-qty-btn.active {
                    background: var(--deep-700);
                    border-color: var(--deep-700);
                    color: #fff;
                }
                .qty-btn:active,
                .enquiry-qty-btn:active {
                    scale: 0.94;
                }

                .add-to-cart-btn {
                    position: relative;
                    overflow: hidden;
                    isolation: isolate;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    gap: 10px;
                    width: 100%;
                    min-height: 48px;
                    margin-top: 16px;
                    border: 0;
                    border-radius: var(--radius-md);
                    background: var(--grad-brand);
                    color: #fff;
                    font-weight: 700;
                    cursor: pointer;
                    box-shadow: 0 6px 18px oklch(0.55 0.2 260 / 0.28);
                    transition:
                        box-shadow var(--dur),
                        translate var(--dur) var(--ease-out);
                }
                .add-to-cart-btn:hover {
                    translate: 0 -1px;
                    box-shadow: var(--shadow-brand);
                }
                .add-to-cart-btn::after {
                    content: "";
                    position: absolute;
                    inset: 0;
                    z-index: -1;
                    background: linear-gradient(110deg, transparent 30%, oklch(1 0 0 / 0.3) 50%, transparent 70%);
                    translate: -110% 0;
                    transition: translate 0.7s var(--ease-out);
                }
                .add-to-cart-btn:hover::after {
                    translate: 110% 0;
                }

                @container (max-width: 300px) {
                    .product-card .gradient-text {
                        font-size: 1.3rem;
                    }
                    .enquiry-trigger-btn {
                        padding: 0 10px;
                    }
                }

                /* Scroll-driven reveal (class added by JS when supported) */
                @supports (animation-timeline: view()) {
                    .scroll-reveal {
                        animation: reveal linear both;
                        animation-timeline: view();
                        animation-range: entry 0% entry 40%;
                    }
                    @keyframes reveal {
                        from {
                            opacity: 0;
                            translate: 0 32px;
                        }
                    }
                }

                .gradient-text {
                    background: var(--grad-brand);
                    -webkit-background-clip: text;
                    background-clip: text;
                    color: transparent;
                }

                /* ---------- How to order ---------- */
                .steps {
                    display: grid;
                    grid-template-columns: repeat(3, minmax(0, 1fr));
                    gap: 16px;
                    list-style: none;
                    margin: 0;
                    padding: 0;
                    counter-reset: step;
                }
                .step {
                    position: relative;
                    padding: 28px;
                    border-radius: var(--radius-lg);
                    background: var(--bg);
                    border: 1px solid var(--border);
                    counter-increment: step;
                }
                .step::before {
                    content: "0" counter(step);
                    position: absolute;
                    top: 22px;
                    right: 24px;
                    font-family: var(--font-display);
                    font-size: 2.6rem;
                    font-weight: 800;
                    line-height: 1;
                    color: var(--ink-200);
                }
                .step h3 {
                    margin: 18px 0 8px;
                    font-size: 1.15rem;
                    font-weight: 800;
                }
                .step p {
                    margin: 0;
                    color: var(--text-muted);
                    font-size: var(--fs-sm);
                }

                /* ---------- FAQ ---------- */
                .faq-layout {
                    display: grid;
                    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
                    gap: clamp(32px, 6vw, 80px);
                    align-items: start;
                }
                .faq-aside {
                    position: sticky;
                    top: calc(var(--header-h) + 24px);
                }
                .faq-aside .section-title {
                    text-align: left;
                }
                .faq-help {
                    margin-top: 28px;
                    padding: 22px;
                    border-radius: var(--radius-lg);
                    background: var(--surface);
                    border: 1px solid var(--border);
                }
                .faq-help p {
                    margin: 0 0 14px;
                    color: var(--text-muted);
                    font-size: var(--fs-sm);
                }
                .faq-help strong {
                    display: block;
                    color: var(--ink-900);
                    font-size: var(--fs-base);
                    margin-bottom: 4px;
                }
                .faq-list {
                    display: grid;
                    gap: 12px;
                }
                .faq-item {
                    border-radius: var(--radius-lg);
                    background: var(--surface);
                    border: 1px solid var(--border);
                    transition:
                        border-color var(--dur),
                        box-shadow var(--dur);
                }
                .faq-item:hover {
                    border-color: var(--ink-300);
                }
                .faq-item[open] {
                    border-color: var(--brand-200);
                    box-shadow: var(--shadow-md);
                }
                .faq-item summary {
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    gap: 16px;
                    padding: 20px 22px;
                    font-family: var(--font-display);
                    font-weight: 700;
                    font-size: 1.05rem;
                    cursor: pointer;
                    list-style: none;
                }
                .faq-item summary::-webkit-details-marker {
                    display: none;
                }
                .faq-icon {
                    position: relative;
                    flex-shrink: 0;
                    width: 32px;
                    height: 32px;
                    border-radius: 50%;
                    background: var(--ink-100);
                    transition:
                        background-color var(--dur),
                        rotate var(--dur) var(--ease-out);
                }
                .faq-icon::before,
                .faq-icon::after {
                    content: "";
                    position: absolute;
                    left: 50%;
                    top: 50%;
                    width: 12px;
                    height: 2px;
                    margin: -1px 0 0 -6px;
                    border-radius: 2px;
                    background: var(--ink-700);
                    transition:
                        rotate var(--dur) var(--ease-out),
                        background-color var(--dur);
                }
                .faq-icon::after {
                    rotate: 90deg;
                }
                .faq-item[open] .faq-icon {
                    background: var(--deep-700);
                    rotate: 180deg;
                }
                .faq-item[open] .faq-icon::before,
                .faq-item[open] .faq-icon::after {
                    background: #fff;
                }
                .faq-item[open] .faq-icon::after {
                    rotate: 0deg;
                }
                .faq-item p {
                    margin: 0;
                    padding: 0 22px 22px;
                    color: var(--text-muted);
                }
                .faq-item p a {
                    color: var(--brand-700);
                    font-weight: 600;
                }
                .faq-item::details-content {
                    block-size: 0;
                    overflow: clip;
                    transition:
                        block-size 0.35s var(--ease-out),
                        content-visibility 0.35s allow-discrete;
                }
                .faq-item[open]::details-content {
                    block-size: auto;
                }

                /* ---------- Contact CTA ---------- */
                .cta-panel {
                    position: relative;
                    isolation: isolate;
                    overflow: hidden;
                    display: grid;
                    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
                    gap: clamp(28px, 5vw, 64px);
                    align-items: center;
                    padding: clamp(32px, 6vw, 72px);
                    border-radius: var(--radius-xl);
                    background: var(--grad-ink);
                    color: #fff;
                }
                .cta-panel::before {
                    content: "";
                    position: absolute;
                    inset: auto -10% -60% auto;
                    z-index: -1;
                    width: 520px;
                    height: 520px;
                    border-radius: 50%;
                    background: radial-gradient(circle, oklch(0.55 0.2 260 / 0.55), transparent 65%);
                }
                .cta-panel::after {
                    content: "";
                    position: absolute;
                    inset: -40% auto auto -10%;
                    z-index: -1;
                    width: 420px;
                    height: 420px;
                    border-radius: 50%;
                    background: radial-gradient(circle, oklch(0.74 0.14 208 / 0.25), transparent 65%);
                }
                .cta-panel .section-title {
                    color: #fff;
                }
                .cta-panel .section-lead {
                    color: oklch(1 0 0 / 0.72);
                }
                .cta-actions {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 12px;
                    margin-top: 28px;
                }
                .contact-list {
                    display: grid;
                    gap: 12px;
                    list-style: none;
                    margin: 0;
                    padding: 0;
                }
                .contact-item {
                    display: flex;
                    align-items: center;
                    gap: 16px;
                    padding: 18px 20px;
                    border-radius: var(--radius-lg);
                    background: oklch(1 0 0 / 0.06);
                    border: 1px solid oklch(1 0 0 / 0.1);
                    transition:
                        background-color var(--dur),
                        border-color var(--dur),
                        translate var(--dur) var(--ease-out);
                }
                .contact-item:hover {
                    background: oklch(1 0 0 / 0.1);
                    border-color: oklch(1 0 0 / 0.2);
                    translate: 4px 0;
                }
                .contact-item .feature-icon {
                    --icon-fg: #fff;
                    --icon-bg: oklch(1 0 0 / 0.1);
                }
                .contact-item small {
                    display: block;
                    font-size: var(--fs-xs);
                    letter-spacing: 0.08em;
                    text-transform: uppercase;
                    color: oklch(1 0 0 / 0.6);
                }
                .contact-item span,
                .contact-item a {
                    font-weight: 600;
                    overflow-wrap: anywhere;
                }
                .contact-item a:hover {
                    color: var(--aqua-300);
                }

                /* ---------- Footer ---------- */
                .site-footer {
                    background: var(--deep-800);
                    color: oklch(1 0 0 / 0.72);
                    padding-block: clamp(48px, 7vw, 80px) 28px;
                    font-size: var(--fs-sm);
                }
                .footer-grid {
                    display: grid;
                    grid-template-columns: minmax(0, 1.5fr) repeat(3, minmax(0, 1fr));
                    gap: 40px;
                }
                .footer-brand-name {
                    margin: 0 0 10px;
                    font-size: 1.4rem;
                    font-weight: 800;
                    color: #fff;
                }
                .footer-about {
                    max-width: 36ch;
                    margin: 0 0 18px;
                }
                .footer-chip {
                    display: inline-flex;
                    align-items: center;
                    gap: 8px;
                    padding: 6px 12px;
                    border-radius: var(--radius-pill);
                    background: oklch(1 0 0 / 0.06);
                    border: 1px solid oklch(1 0 0 / 0.12);
                    color: #fff;
                    font-size: var(--fs-xs);
                    font-weight: 600;
                }
                .footer-chip-dot {
                    width: 7px;
                    height: 7px;
                    border-radius: 50%;
                    background: var(--success-500);
                    box-shadow: 0 0 0 3px oklch(0.7 0.17 152 / 0.25);
                }
                .footer-heading {
                    margin: 0 0 14px;
                    font-family: var(--font-sans);
                    font-size: var(--fs-xs);
                    font-weight: 700;
                    letter-spacing: 0.1em;
                    text-transform: uppercase;
                    color: #fff;
                }
                .footer-links {
                    display: grid;
                    gap: 10px;
                    list-style: none;
                    margin: 0;
                    padding: 0;
                }
                .footer-links a {
                    transition: color var(--dur-fast);
                }
                .footer-links a:hover {
                    color: #fff;
                }
                .footer-links .mono {
                    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
                    font-size: 0.8rem;
                    color: oklch(1 0 0 / 0.85);
                }
                .footer-links small {
                    display: block;
                    font-size: 11px;
                    color: oklch(1 0 0 / 0.5);
                }
                .footer-social {
                    display: flex;
                    gap: 10px;
                    margin-top: 20px;
                }
                .social-icon-link {
                    display: grid;
                    place-items: center;
                    width: 42px;
                    height: 42px;
                    border-radius: 12px;
                    background: oklch(1 0 0 / 0.06);
                    border: 1px solid oklch(1 0 0 / 0.1);
                    color: #fff;
                    transition:
                        background-color var(--dur-fast),
                        translate var(--dur) var(--ease-out);
                }
                .social-icon-link:hover {
                    background: var(--brand-600);
                    translate: 0 -2px;
                }
                .footer-bottom {
                    display: flex;
                    flex-wrap: wrap;
                    justify-content: space-between;
                    gap: 12px;
                    margin-top: 48px;
                    padding-top: 24px;
                    border-top: 1px solid oklch(1 0 0 / 0.08);
                    font-size: var(--fs-xs);
                    color: oklch(1 0 0 / 0.5);
                }
                .footer-bottom p {
                    margin: 0;
                }

                /* ---------- Back to top ---------- */
                #scrollToTop {
                    position: fixed;
                    right: 24px;
                    bottom: 24px;
                    z-index: 50;
                    display: grid;
                    place-items: center;
                    width: 48px;
                    height: 48px;
                    border: 0;
                    border-radius: 50%;
                    background: var(--deep-700);
                    color: #fff;
                    box-shadow: var(--shadow-md);
                    cursor: pointer;
                    transition:
                        opacity var(--dur),
                        translate var(--dur) var(--ease-out),
                        background-color var(--dur-fast),
                        visibility var(--dur);
                }
                #scrollToTop:hover {
                    background: var(--brand-600);
                }

                /* ---------- Floating assistant button ---------- */
                .ai-assistant-btn {
                    position: fixed;
                    right: 24px;
                    bottom: 84px;
                    z-index: 55;
                    display: grid;
                    place-items: center;
                    width: 56px;
                    height: 56px;
                    border: 0;
                    border-radius: 18px;
                    background: var(--grad-brand);
                    color: #fff;
                    font-size: 1.3rem;
                    box-shadow: var(--shadow-brand);
                    cursor: pointer;
                    transition:
                        scale var(--dur) var(--ease-spring),
                        border-radius var(--dur);
                }
                .ai-assistant-btn:hover {
                    scale: 1.06;
                    border-radius: 50%;
                }
                .ai-assistant-btn-ring {
                    position: absolute;
                    inset: -5px;
                    border-radius: 22px;
                    border: 2px solid var(--brand-500);
                    opacity: 0;
                    animation: ring-pulse 2.8s var(--ease-out) infinite;
                    pointer-events: none;
                }
                @keyframes ring-pulse {
                    0% {
                        opacity: 0.6;
                        scale: 0.95;
                    }
                    70%,
                    100% {
                        opacity: 0;
                        scale: 1.25;
                    }
                }

                /* ---------- Shared side panels (cart & assistant) ---------- */
                .cart-panel,
                .assistant-panel {
                    position: fixed;
                    z-index: 80;
                    display: flex;
                    flex-direction: column;
                    background: var(--surface);
                    border: 1px solid var(--border);
                    box-shadow: var(--shadow-lg);
                    overflow: hidden;
                    opacity: 1;
                    translate: 0 0;
                    transition:
                        opacity var(--dur) var(--ease-out),
                        translate 0.4s var(--ease-out),
                        visibility var(--dur);
                }

                .cart-panel {
                    top: calc(var(--header-h) + 12px);
                    right: 16px;
                    width: min(400px, calc(100vw - 32px));
                    max-height: calc(100dvh - var(--header-h) - 28px);
                    border-radius: var(--radius-xl);
                }

                .assistant-panel {
                    right: 24px;
                    bottom: 152px;
                    width: min(390px, calc(100vw - 32px));
                    height: min(560px, calc(100dvh - 180px));
                    border-radius: var(--radius-xl);
                }

                .cart-panel-header,
                .assistant-panel-header {
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    gap: 12px;
                    padding: 18px 20px;
                    border-bottom: 1px solid var(--border);
                }
                .assistant-panel-header {
                    background: var(--grad-ink);
                    color: #fff;
                    border-bottom: 0;
                }
                .panel-title {
                    display: flex;
                    align-items: center;
                    gap: 10px;
                    font-family: var(--font-display);
                    font-weight: 800;
                    font-size: 1.05rem;
                }
                .panel-title i {
                    color: var(--brand-600);
                }
                .panel-subtitle {
                    margin: 0;
                    font-size: var(--fs-xs);
                    color: var(--text-muted);
                    font-weight: 500;
                    font-family: var(--font-sans);
                }
                .assistant-panel-header .panel-subtitle {
                    color: oklch(1 0 0 / 0.65);
                }

                .panel-close-btn {
                    display: grid;
                    place-items: center;
                    width: 36px;
                    height: 36px;
                    border-radius: 50%;
                    border: 0;
                    background: var(--ink-100);
                    color: var(--ink-700);
                    cursor: pointer;
                    transition:
                        background-color var(--dur-fast),
                        rotate var(--dur) var(--ease-out);
                }
                .panel-close-btn:hover {
                    background: var(--ink-200);
                    rotate: 90deg;
                }
                .assistant-panel-header .panel-close-btn {
                    background: oklch(1 0 0 / 0.12);
                    color: #fff;
                }
                .assistant-panel-header .panel-close-btn:hover {
                    background: oklch(1 0 0 / 0.22);
                }

                /* Cart */
                .cart-items-list {
                    flex: 1;
                    overflow-y: auto;
                    overscroll-behavior: contain;
                    padding: 8px 12px;
                }
                .cart-item-row {
                    display: flex;
                    align-items: center;
                    gap: 12px;
                    padding: 12px 8px;
                    border-bottom: 1px solid var(--ink-100);
                    font-size: var(--fs-sm);
                    animation: rise-in 0.35s var(--ease-out);
                }
                .cart-item-row:last-child {
                    border-bottom: 0;
                }
                /* No !important needed now the row markup has no inline styles. */
                .cart-item-row img {
                    flex-shrink: 0;
                    width: 48px;
                    height: 48px;
                    padding: 4px;
                    border-radius: 10px;
                    background: var(--ink-100);
                    object-fit: contain;
                }
                .cart-item-qty-ctrl {
                    display: flex;
                    align-items: center;
                    gap: 6px;
                    flex-shrink: 0;
                }
                .cart-qty-btn {
                    display: grid;
                    place-items: center;
                    width: 28px;
                    height: 28px;
                    border-radius: 8px;
                    border: 1px solid var(--border);
                    background: var(--surface);
                    color: var(--ink-800);
                    font-weight: 700;
                    cursor: pointer;
                    transition:
                        background-color var(--dur-fast),
                        border-color var(--dur-fast);
                }
                .cart-qty-btn:hover:not(:disabled) {
                    border-color: var(--brand-500);
                    background: var(--brand-50);
                }
                .cart-qty-btn:disabled {
                    opacity: 0.4;
                    cursor: not-allowed;
                }
                .cart-item-qty-ctrl > span {
                    min-width: 18px;
                    text-align: center;
                    font-variant-numeric: tabular-nums;
                }
                .cart-item-remove {
                    display: grid;
                    place-items: center;
                    width: 28px;
                    height: 28px;
                    border-radius: 8px;
                    color: var(--danger-500) !important;
                    transition: background-color var(--dur-fast);
                }
                .cart-item-remove:hover {
                    background: var(--danger-50) !important;
                }
                .cart-empty-msg {
                    padding: 48px 16px;
                    text-align: center;
                    color: var(--text-muted);
                }
                .cart-empty-msg i {
                    display: block;
                    margin-bottom: 12px;
                    color: var(--ink-300);
                }
                .cart-panel-footer {
                    padding: 16px 20px 20px;
                    border-top: 1px solid var(--border);
                    background: var(--bg);
                }
                .cart-total-row {
                    display: flex;
                    align-items: baseline;
                    justify-content: space-between;
                    margin-bottom: 14px;
                }
                .cart-total-row span:first-child {
                    color: var(--text-muted);
                    font-size: var(--fs-sm);
                    font-weight: 600;
                }
                #cartTotal {
                    display: inline-block;
                    font-family: var(--font-display);
                    font-size: 1.4rem;
                    font-weight: 800;
                    font-variant-numeric: tabular-nums;
                }
                .cart-action-btn {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    gap: 10px;
                    width: 100%;
                    min-height: 50px;
                    border: 0;
                    border-radius: var(--radius-md);
                    background: var(--wa-600);
                    color: #fff;
                    font-weight: 700;
                    cursor: pointer;
                    transition: background-color var(--dur-fast);
                }
                .cart-action-btn:hover {
                    background: oklch(0.55 0.16 152);
                }
                .cart-clear-btn {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    gap: 6px;
                    width: 100%;
                    margin-top: 8px;
                    padding: 8px;
                    border: 0;
                    background: none;
                    color: var(--ink-400);
                    font-size: var(--fs-xs);
                    font-weight: 600;
                    cursor: pointer;
                    transition: color var(--dur-fast);
                }
                .cart-clear-btn:hover {
                    color: var(--danger-600);
                }

                /* Assistant */
                .assistant-avatar {
                    display: grid;
                    place-items: center;
                    width: 40px;
                    height: 40px;
                    border-radius: 12px;
                    background: var(--grad-brand);
                    color: #fff;
                }
                .assistant-messages {
                    flex: 1;
                    overflow-y: auto;
                    overscroll-behavior: contain;
                    display: flex;
                    flex-direction: column;
                    gap: 10px;
                    padding: 18px 16px;
                    background: var(--bg);
                }
                .assistant-msg {
                    max-width: 86%;
                    padding: 10px 14px;
                    border-radius: 16px;
                    font-size: var(--fs-sm);
                    line-height: 1.55;
                    animation: rise-in 0.3s var(--ease-out);
                    overflow-wrap: anywhere;
                }
                .assistant-msg.bot {
                    align-self: flex-start;
                    background: var(--surface);
                    border: 1px solid var(--border);
                    border-bottom-left-radius: 4px;
                    color: var(--ink-800);
                }
                .assistant-msg.user {
                    align-self: flex-end;
                    background: var(--deep-700);
                    color: #fff;
                    border-bottom-right-radius: 4px;
                }
                .assistant-msg a {
                    color: var(--brand-600);
                    font-weight: 600;
                    text-decoration: underline;
                }
                .assistant-msg.user a {
                    color: var(--aqua-300);
                }
                .assistant-quick-replies {
                    display: flex;
                    gap: 6px;
                    padding: 10px 12px;
                    overflow-x: auto;
                    scrollbar-width: none;
                    border-top: 1px solid var(--border);
                }
                .assistant-quick-replies:empty {
                    display: none;
                }
                .assistant-chip {
                    flex-shrink: 0;
                    padding: 7px 12px;
                    border-radius: var(--radius-pill);
                    border: 1px solid var(--brand-200);
                    background: var(--brand-50);
                    color: var(--brand-700);
                    font-size: var(--fs-xs);
                    font-weight: 600;
                    cursor: pointer;
                    white-space: nowrap;
                    transition:
                        background-color var(--dur-fast),
                        color var(--dur-fast);
                }
                .assistant-chip:hover {
                    background: var(--brand-600);
                    color: #fff;
                }
                .assistant-chip.is-wa {
                    align-self: flex-start;
                    margin-top: -4px;
                    border: none;
                    background: linear-gradient(135deg, #25d366, #128c7e);
                    color: #fff;
                }
                .assistant-input-row {
                    display: flex;
                    align-items: center;
                    gap: 8px;
                    padding: 12px;
                    border-top: 1px solid var(--border);
                }
                .assistant-input {
                    flex: 1;
                    min-width: 0;
                    min-height: 44px;
                    padding: 0 16px;
                    border-radius: var(--radius-pill);
                    border: 1px solid var(--border);
                    background: var(--bg);
                    font-size: var(--fs-sm);
                    transition:
                        border-color var(--dur-fast),
                        box-shadow var(--dur);
                }
                .assistant-input:focus {
                    outline: none;
                    border-color: var(--brand-500);
                    box-shadow: 0 0 0 4px oklch(0.63 0.18 252 / 0.15);
                }
                .assistant-send-btn {
                    display: grid;
                    place-items: center;
                    width: 44px;
                    height: 44px;
                    border-radius: 50%;
                    border: 0;
                    background: var(--grad-brand);
                    color: #fff;
                    cursor: pointer;
                    flex-shrink: 0;
                    transition: scale var(--dur) var(--ease-spring);
                }
                .assistant-send-btn:hover {
                    scale: 1.08;
                }
                .voice-btn-inline {
                    flex-shrink: 0;
                    width: 44px;
                    height: 44px;
                }

                /* ---------- Modals (native <dialog>) ---------- */
                dialog.sc-modal {
                    width: min(100% - 32px, 480px);
                    max-width: none;
                    max-height: calc(100dvh - 32px);
                    margin: auto;
                    padding: 0;
                    border: 0;
                    border-radius: var(--radius-xl);
                    background: transparent;
                    color: var(--text);
                    overflow: visible;
                    opacity: 1;
                    scale: 1;
                    transition:
                        opacity var(--dur) var(--ease-out),
                        scale var(--dur) var(--ease-out),
                        display var(--dur) allow-discrete,
                        overlay var(--dur) allow-discrete;
                }
                dialog.sc-modal:not([open]) {
                    opacity: 0;
                    scale: 0.96;
                }
                @starting-style {
                    dialog.sc-modal[open] {
                        opacity: 0;
                        scale: 0.96;
                    }
                }
                dialog.sc-modal::backdrop {
                    background: oklch(0.3 0.1 262 / 0.55);
                    backdrop-filter: blur(6px);
                    transition:
                        background-color var(--dur),
                        display var(--dur) allow-discrete,
                        overlay var(--dur) allow-discrete;
                }
                @starting-style {
                    dialog.sc-modal[open]::backdrop {
                        background: oklch(0.3 0.1 262 / 0);
                    }
                }
                /* Lock page scroll while any modal dialog (enquiry, quick view, ⌘K…) is open —
                   pure CSS, so no JS has to remember to undo it. */
                html:has(dialog:modal) {
                    overflow: hidden;
                }

                .enquiry-modal-box,
                .added-cart-box,
                .remove-confirm-box {
                    position: relative;
                    max-height: calc(100dvh - 32px);
                    overflow-y: auto;
                    overscroll-behavior: contain;
                    border-radius: var(--radius-xl);
                    background: var(--surface);
                    box-shadow: var(--shadow-lg);
                    outline: none;
                }

                /* Enquiry */
                .enquiry-modal-header {
                    position: sticky;
                    top: 0;
                    z-index: 2;
                    display: flex;
                    align-items: center;
                    gap: 14px;
                    padding: 20px 22px;
                    background: var(--grad-ink);
                    color: #fff;
                }
                .enquiry-header-icon {
                    display: grid;
                    place-items: center;
                    width: 44px;
                    height: 44px;
                    flex-shrink: 0;
                    border-radius: 14px;
                    background: var(--grad-brand);
                    font-size: 1.05rem;
                }
                .enquiry-modal-header h2 {
                    margin: 0;
                    font-size: 1.2rem;
                    font-weight: 800;
                }
                .enquiry-modal-header p {
                    margin: 2px 0 0;
                    font-size: var(--fs-xs);
                    color: oklch(1 0 0 / 0.7);
                }
                .enquiry-close-btn {
                    display: grid;
                    place-items: center;
                    width: 38px;
                    height: 38px;
                    margin-left: auto;
                    flex-shrink: 0;
                    border: 0;
                    border-radius: 50%;
                    background: oklch(1 0 0 / 0.12);
                    color: #fff;
                    cursor: pointer;
                    transition:
                        background-color var(--dur-fast),
                        rotate var(--dur) var(--ease-out);
                }
                .enquiry-close-btn:hover {
                    background: oklch(1 0 0 / 0.22);
                    rotate: 90deg;
                }
                .enquiry-body {
                    padding: 22px;
                }
                .enquiry-product-preview {
                    display: flex;
                    align-items: center;
                    gap: 14px;
                    margin-bottom: 20px;
                    padding: 12px;
                    border-radius: var(--radius-lg);
                    background: var(--bg);
                    border: 1px solid var(--border);
                }
                .enquiry-product-preview img {
                    width: 68px;
                    height: 68px;
                    flex-shrink: 0;
                    padding: 6px;
                    border-radius: 14px;
                    background: #fff;
                    object-fit: contain;
                }
                .enquiry-product-preview p {
                    margin: 0;
                }
                .enquiry-qty-buttons {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 6px;
                }
                .enquiry-body label {
                    font-size: var(--fs-sm);
                    color: var(--ink-700);
                }
                .enquiry-input,
                .enquiry-textarea {
                    width: 100%;
                    min-height: 46px;
                    padding: 10px 14px;
                    border-radius: var(--radius-md);
                    border: 1px solid var(--border);
                    background: var(--surface);
                    font-size: var(--fs-sm);
                    color: var(--ink-900);
                    transition:
                        border-color var(--dur-fast),
                        box-shadow var(--dur);
                }
                .enquiry-textarea {
                    min-height: 84px;
                    resize: vertical;
                    field-sizing: content;
                }
                .enquiry-input:focus,
                .enquiry-textarea:focus {
                    outline: none;
                    border-color: var(--brand-500);
                    box-shadow: 0 0 0 4px oklch(0.63 0.18 252 / 0.15);
                }
                .enquiry-input[readonly] {
                    background: var(--bg);
                    color: var(--ink-600);
                }
                .enquiry-field-wrap:has(.enquiry-error:not(.hidden)) .enquiry-input {
                    border-color: var(--danger-500);
                    box-shadow: 0 0 0 4px oklch(0.64 0.21 25 / 0.12);
                }
                .enquiry-phone-group {
                    position: relative;
                }
                .enquiry-phone-group::after {
                    content: "\2713";
                    position: absolute;
                    right: 14px;
                    top: 50%;
                    translate: 0 -50%;
                    display: grid;
                    place-items: center;
                    width: 22px;
                    height: 22px;
                    border-radius: 50%;
                    background: var(--success-500);
                    color: #fff;
                    font-size: 12px;
                    font-weight: 800;
                    opacity: 0;
                    scale: 0.5;
                    transition:
                        opacity var(--dur),
                        scale var(--dur) var(--ease-spring);
                }
                .enquiry-phone-group.is-valid::after {
                    opacity: 1;
                    scale: 1;
                }
                .enquiry-phone-group.is-valid .enquiry-input {
                    border-color: var(--success-500);
                }
                .enquiry-row-2 {
                    display: grid;
                    grid-template-columns: 1fr 1fr;
                    gap: 12px;
                }
                .workshop-change-btn {
                    padding: 2px 10px;
                    border-radius: var(--radius-pill);
                    border: 1px solid var(--brand-200);
                    background: var(--brand-50);
                    color: var(--brand-700);
                    font-size: var(--fs-xs);
                    font-weight: 700;
                    cursor: pointer;
                }
                .is-near {
                    color: var(--danger-600);
                }
                .enquiry-submit-btn,
                .enquiry-pdf-btn {
                    position: relative;
                    overflow: hidden;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    gap: 10px;
                    width: 100%;
                    min-height: 52px;
                    border-radius: var(--radius-md);
                    font-weight: 700;
                    cursor: pointer;
                    transition:
                        background-color var(--dur-fast),
                        border-color var(--dur-fast),
                        box-shadow var(--dur);
                }
                .enquiry-submit-btn {
                    margin-top: 6px;
                    border: 0;
                    background: var(--wa-600);
                    color: #fff;
                    box-shadow: 0 8px 22px oklch(0.6 0.16 152 / 0.3);
                }
                .enquiry-submit-btn:hover {
                    background: oklch(0.55 0.16 152);
                }
                .enquiry-pdf-btn {
                    margin-top: 10px;
                    border: 1px solid var(--border);
                    background: var(--surface);
                    color: var(--ink-800);
                }
                .enquiry-pdf-btn:hover {
                    border-color: var(--danger-500);
                    color: var(--danger-600);
                }
                .enquiry-pdf-btn:disabled {
                    opacity: 0.6;
                    cursor: progress;
                }

                .pdf-flyer {
                    position: fixed;
                    z-index: 9999;
                    width: 46px;
                    height: 58px;
                    margin: 0;
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    justify-content: center;
                    gap: 3px;
                    pointer-events: none;
                    filter: drop-shadow(0 10px 18px oklch(0.2 0.03 262 / 0.35));
                }
                .pdf-flyer::before {
                    content: "";
                    position: absolute;
                    inset: 0;
                    background: #fff;
                    border-radius: 6px;
                    clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 14px, 100% 100%, 0 100%);
                }
                .pdf-flyer i {
                    position: relative;
                    color: var(--danger-600);
                    font-size: 1.35rem;
                }
                .pdf-flyer span {
                    position: relative;
                    padding: 1px 5px;
                    border-radius: 3px;
                    background: var(--danger-600);
                    color: #fff;
                    font-size: 0.6rem;
                    font-weight: 800;
                    letter-spacing: 0.05em;
                }

                /* Added-to-cart */
                .added-cart-box {
                    padding: 28px 24px 24px;
                    text-align: center;
                }
                .added-cart-success {
                    display: grid;
                    place-items: center;
                    width: 52px;
                    height: 52px;
                    margin: 0 auto 14px;
                    border-radius: 50%;
                    background: oklch(0.96 0.05 152);
                    color: var(--wa-600);
                    font-size: 1.3rem;
                    animation: bump 0.5s var(--ease-spring);
                }
                .added-cart-close-btn {
                    position: absolute;
                    top: 14px;
                    right: 14px;
                }
                .added-cart-product-name {
                    margin: 0;
                    font-size: 1.3rem;
                    font-weight: 800;
                }
                .added-cart-msg {
                    margin: 4px 0 20px;
                    color: var(--text-muted);
                    font-size: var(--fs-sm);
                }
                .added-cart-body {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    gap: 24px;
                    padding: 16px;
                    border-radius: var(--radius-lg);
                    background: var(--bg);
                    border: 1px solid var(--border);
                }
                .added-cart-img-wrap img {
                    width: 96px;
                    height: 96px;
                    object-fit: contain;
                }
                .added-cart-qty p {
                    margin: 0 0 8px;
                    font-size: var(--fs-xs);
                    font-weight: 700;
                    letter-spacing: 0.08em;
                    text-transform: uppercase;
                    color: var(--text-muted);
                }
                .added-cart-qty-ctrl {
                    display: flex;
                    align-items: center;
                    border-radius: var(--radius-pill);
                    border: 1px solid var(--border);
                    background: var(--surface);
                    overflow: hidden;
                }
                .added-cart-qty-ctrl button {
                    width: 40px;
                    height: 40px;
                    border: 0;
                    background: none;
                    font-size: 1.1rem;
                    font-weight: 700;
                    cursor: pointer;
                    transition: background-color var(--dur-fast);
                }
                .added-cart-qty-ctrl button:hover:not(:disabled) {
                    background: var(--brand-50);
                    color: var(--brand-700);
                }
                .added-cart-qty-ctrl button:disabled {
                    opacity: 0.35;
                    cursor: not-allowed;
                }
                .added-cart-qty-ctrl input {
                    width: 40px;
                    border: 0;
                    background: none;
                    text-align: center;
                    font-weight: 800;
                    font-variant-numeric: tabular-nums;
                }
                .added-cart-line {
                    margin: 18px 0 4px;
                    font-size: var(--fs-sm);
                    color: var(--ink-600);
                }
                .added-cart-subtotal {
                    margin: 0 0 20px;
                    font-size: var(--fs-sm);
                    color: var(--ink-600);
                }
                .added-cart-subtotal b {
                    color: var(--ink-900);
                    font-size: 1.05rem;
                }
                .added-cart-actions {
                    display: grid;
                    grid-template-columns: 1fr 1fr;
                    gap: 10px;
                }
                .added-cart-actions button {
                    position: relative;
                    overflow: hidden;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    gap: 8px;
                    min-height: 48px;
                    border-radius: var(--radius-md);
                    font-weight: 700;
                    cursor: pointer;
                    transition:
                        background-color var(--dur-fast),
                        border-color var(--dur-fast);
                }
                .added-cart-continue-btn {
                    border: 1px solid var(--border);
                    background: var(--surface);
                    color: var(--ink-800);
                }
                .added-cart-continue-btn:hover {
                    border-color: var(--ink-400);
                    background: var(--bg);
                }
                .added-cart-viewcart-btn {
                    border: 0;
                    background: var(--deep-700);
                    color: #fff;
                }
                .added-cart-viewcart-btn:hover {
                    background: var(--brand-700);
                }

                /* Remove confirm */
                .remove-confirm-box {
                    padding: 28px 24px 24px;
                    text-align: center;
                }
                .remove-confirm-icon {
                    display: grid;
                    place-items: center;
                    width: 56px;
                    height: 56px;
                    margin: 0 auto 14px;
                    border-radius: 50%;
                    background: var(--danger-50);
                    color: var(--danger-600);
                    font-size: 1.3rem;
                }
                .remove-confirm-title {
                    margin: 0;
                    font-family: var(--font-display);
                    font-size: 1.25rem;
                    font-weight: 800;
                }
                .remove-confirm-msg {
                    margin: 8px 0 22px;
                    color: var(--text-muted);
                    font-size: var(--fs-sm);
                }
                .remove-confirm-msg b {
                    color: var(--ink-900);
                }
                .remove-confirm-ok-btn {
                    border: 0;
                    background: var(--danger-600);
                    color: #fff;
                }
                .remove-confirm-ok-btn:hover {
                    background: oklch(0.5 0.2 27);
                }
            }

            /* -------------------------------------------------------- responsive */
            @layer responsive {
                @media (max-width: 1100px) {
                    .site-nav {
                        display: none;
                    }
                    .menu-btn {
                        display: inline-grid;
                    }
                    .bento {
                        grid-template-columns: repeat(2, minmax(0, 1fr));
                    }
                    .footer-grid {
                        grid-template-columns: repeat(2, minmax(0, 1fr));
                    }
                }

                @media (max-width: 900px) {
                    .hero-inner,
                    .faq-layout,
                    .cta-panel {
                        grid-template-columns: minmax(0, 1fr);
                    }
                    .hero-visual {
                        max-width: 520px;
                        margin-inline: auto;
                        width: 100%;
                    }
                    .faq-aside {
                        position: static;
                    }
                    .steps {
                        grid-template-columns: minmax(0, 1fr);
                    }
                }

                @media (max-width: 640px) {
                    :root {
                        --header-h: 64px;
                    }
                    .header-inner {
                        min-height: 64px;
                        gap: 12px;
                    }
                    .header-call span,
                    .brand-tag {
                        display: none;
                    }
                    .header-call {
                        width: 44px;
                        padding: 0;
                        justify-content: center;
                    }
                    .hero-visual,
                    .hero-scroll-cue {
                        display: none;
                    }
                    .hero-actions .btn {
                        flex: 1 1 100%;
                    }
                    .hero-stats {
                        grid-template-columns: repeat(2, minmax(0, 1fr));
                    }
                    .bento {
                        grid-template-columns: minmax(0, 1fr);
                    }
                    .feature-card.is-hero,
                    .feature-card.is-wide {
                        grid-column: auto;
                        grid-row: auto;
                    }
                    .footer-grid {
                        grid-template-columns: minmax(0, 1fr);
                    }
                    .section-head.is-split .search-box {
                        width: 100%;
                    }
                    #scrollToTop {
                        right: 16px;
                        bottom: 16px;
                        width: 44px;
                        height: 44px;
                    }
                    .ai-assistant-btn {
                        right: 16px;
                        bottom: 72px;
                        width: 52px;
                        height: 52px;
                    }
                    .cart-panel,
                    .assistant-panel {
                        inset: auto 0 0 0;
                        width: 100%;
                        max-height: 85dvh;
                        border-radius: var(--radius-xl) var(--radius-xl) 0 0;
                    }
                    .assistant-panel {
                        height: 80dvh;
                    }
                    dialog.sc-modal {
                        width: 100%;
                        margin: auto 0 0;
                        max-height: 92dvh;
                    }
                    .enquiry-modal-box,
                    .added-cart-box,
                    .remove-confirm-box {
                        max-height: 92dvh;
                        border-radius: var(--radius-xl) var(--radius-xl) 0 0;
                    }
                    .enquiry-row-2 {
                        grid-template-columns: minmax(0, 1fr);
