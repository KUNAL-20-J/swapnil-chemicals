            // Single delegated listener handles every data-action element, including
            // ones rendered later via innerHTML (product cards, cart rows, qty buttons).
            function handleGlobalClick(e) {
                const target = e.target.closest("[data-action]");
                if (!target) return;
                const productId = Number(target.dataset.productId);
                const delta = Number(target.dataset.delta);
                switch (target.dataset.action) {
                    case "toggle-cart":
                        toggleCart();
                        break;
                    case "toggle-assistant":
                        toggleAssistant();
                        break;
                    case "copy":
                        copyText(target.dataset.copyText, target);
                        break;
                    case "open-cart-enquiry":
                        openCartEnquiry();
                        break;
                    case "clear-cart":
                        clearCart();
                        break;
                    case "close-enquiry":
                        closeEnquiryModal();
                        break;
                    case "submit-enquiry":
                        submitEnquiry();
                        break;
                    case "close-added-cart":
                        closeAddedCartModal();
                        break;
                    case "added-cart-qty":
                        changeAddedCartQty(delta);
                        break;
                    case "view-cart-from-added":
                        viewCartFromAddedModal(e);
                        break;
                    case "close-remove-confirm":
                        closeRemoveConfirmModal();
                        break;
                    case "confirm-remove":
                        confirmRemoveFromCart(e);
                        break;
                    case "cart-qty":
                        changeCartQty(target.dataset.key, delta, e);
                        break;
                    case "remove-from-cart":
                        removeFromCart(target.dataset.key, e);
                        break;
                    case "submit-cart-enquiry":
                        submitCartEnquiry();
                        break;
                    case "download-cart-pdf":
                        downloadCartPdf(target);
                        break;
                    case "select-qty":
                        selectQty(target);
                        break;
                    case "open-enquiry":
                        openEnquiryModal(productId);
                        break;
                    case "browse-products": {
                        toggleCart();
                        const productsSection = document.getElementById("products");
                        if (productsSection) productsSection.scrollIntoView({ behavior: "smooth" });
                        break;
                    }
                    case "add-to-cart":
                        addToCart(productId);
                        break;
                    default:
                        break;
                }
            }
            document.addEventListener("click", handleGlobalClick);

            // load/error don't bubble, but the capture phase still sees them on the way down.
            // These two listeners replace every inline onload/onerror attribute on the page —
            // including images rendered later — so no markup carries inline event handlers.
            document.addEventListener(
                "load",
                ({ target }) => {
                    if (target instanceof HTMLImageElement && target.matches(".product-image")) {
                        target.classList.add("loaded");
                    }
                },
                { capture: true }
            );
            document.addEventListener(
                "error",
                ({ target }) => {
                    if (!(target instanceof HTMLImageElement)) return;
                    if (target.matches(".product-image")) {
                        target.classList.add("is-broken"); // CSS hides it and reveals the fallback
                    } else if (target.dataset.fallbackIcon) {
                        // ⌘K result thumbnails: swap the broken image for its Font Awesome icon.
                        const icon = document.createElement("i");
                        icon.className = `fas ${target.dataset.fallbackIcon}`;
                        icon.setAttribute("aria-hidden", "true");
                        target.replaceWith(icon);
                    } else if (target.closest(".est-prod")) {
                        target.style.visibility = "hidden";
                    }
                },
                { capture: true }
            );

            // This script sits at the end of <body>, so #productsGrid already exists —
            // render now so image requests start without waiting for DOMContentLoaded.
            renderProducts();
            renderTradeList();

            document.addEventListener("DOMContentLoaded", () => {
                initProductSearch();
                initVoiceSearch();
                initVoiceAssistant();
                initScrollEffects();
                initHeaderHeightVar();
                initCardReveal();
                initOffscreenAnimationPause();
                initRipples();
                initMobileNav();
                const yearEl = document.getElementById("copyrightYear");
                if (yearEl) yearEl.textContent = String(new Date().getFullYear());
                cart = restoreCart(storage.get(APP.CART_STORAGE_KEY, {}));
                updateCartUI();
            });
        </script>
        <script>
            // Market-style extras: category chips drive the existing search box; mobile bar mirrors the cart count.
            (function () {
                const input = document.getElementById("productSearch");
                const chips = document.querySelectorAll(".category-chips .chip");
                function setActive(chip) {
                    chips.forEach((c) => {
                        const on = c === chip;
                        c.classList.toggle("is-active", on);
                        c.setAttribute("aria-pressed", String(on));
                    });
                }
                chips.forEach((chip) => {
                    chip.addEventListener("click", () => {
                        if (!input) return;
                        input.value = chip.dataset.chipQuery || "";
                        input.dispatchEvent(new Event("input", { bubbles: true }));
                        setActive(chip);
                    });
                });
                if (input) {
                    input.addEventListener("input", () => {
                        const match = Array.from(chips).find((c) => (c.dataset.chipQuery || "") === input.value.trim());
                        setActive(match || null);
                    });
                }

                const src = document.getElementById("cartBadge");
                const dst = document.getElementById("actionbarBadge");
                if (src && dst) {
                    const sync = () => {
                        const n = parseInt(src.textContent, 10) || 0;
                        dst.textContent = String(n);
                        dst.hidden = n === 0 || src.hidden;
                    };
                    new MutationObserver(sync).observe(src, {
                        childList: true,
                        characterData: true,
                        subtree: true,
                        attributes: true,
                        attributeFilter: ["hidden"],
                    });
                    sync();
                }
            })();
        </script>

        <script>
            // =====================================================================
            // 2027 layer: ⌘K command palette, product quick view,
            // bulk estimator, scroll-spy, share links and app badge.
            // Reuses the catalogue + cart helpers declared in the main script
            // (products, cart, persistCart, updateCartUI, formatCurrency, …).
            // =====================================================================
            (function () {
                "use strict";

                const reduceMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;
                const canTransition = () => typeof document.startViewTransition === "function" && !reduceMotion();
                const byId = (id) => document.getElementById(id);
                const productById = (id) => products.find((p) => p.id === Number(id));
                const packSizes = (p) => (p.hasLtOptions ? p.qtyOptions || LT_OPTIONS : [1]);
                const packLabel = (p, size) => {
                    if (!p.hasLtOptions) return "1 piece";
                    const label = (p.qtyLabel || "Lt").trim();
                    return `${size} ${label}`;
                };
                const packTotal = (p, size, packs = 1) => p.price * size * packs;

                // ------------------------------------------------------------ toast
                // Shared with the main script (showToast), so there is one toast implementation.
                const toast = (message) => showToast(message, { duration: 2200 });

                // ------------------------------------------------------------ cart helper
                function addPacksToCart(product, size, packs) {
                    const count = Math.max(1, Math.min(999, Math.floor(Number(packs)) || 1));
                    const key = `${product.id}_${size}`;
                    if (cart[key]) cart[key].qty += count;
                    else cart[key] = { product, qty: count, selectedQty: size };
                    persistCart();
                    updateCartUI();
                    if (typeof openAddedCartModal === "function") openAddedCartModal(key);
                }

                // ------------------------------------------------------------ dialogs
                // Page scroll is locked by CSS (html:has(dialog:modal)), so nothing to undo on close.
                function openY(dialog) {
                    if (!dialog || dialog.open) return;
                    dialog.showModal();
                }
                function closeY(dialog) {
                    if (dialog?.open) dialog.close();
                }
                // Fallback for browsers without closedby="any" / Invoker Commands.
                document.querySelectorAll(".y-dialog").forEach((dialog) => {
                    dialog.addEventListener("click", (e) => {
                        if (e.target === dialog || e.target.closest("[data-y-close]")) closeY(dialog);
                    });
                });

                // ------------------------------------------------------------ quick view
                const qv = byId("quickView");
                let qvProduct = null;

                function renderPackOptions(fieldset, product, name, onChange) {
                    if (!fieldset) return;
                    const legend = fieldset.querySelector("legend")?.outerHTML || "";
                    fieldset.innerHTML =
                        legend +
                        packSizes(product)
                            .map(
                                (size, i) => `<label class="pack-opt">
                                    <input type="radio" name="${name}" value="${size}"${i === 0 ? " checked" : ""}>
                                    <b>${escapeHtml(packLabel(product, size))}</b>
                                    <span>${formatCurrency(packTotal(product, size))}</span>
                                </label>`
                            )
                            .join("");
                    if (onChange) fieldset.onchange = onChange;
                }
                const checkedPack = (fieldset) => Number(fieldset?.querySelector("input:checked")?.value) || 1;

                function fillQuickView(product) {
                    qvProduct = product;
                    const media = byId("qvMedia");
                    const img = byId("qvImg");
                    media.classList.remove("is-broken");
                    img.onerror = () => media.classList.add("is-broken");
                    img.src = product.image;
                    img.alt = product.name;
                    byId("qvTitle").textContent = product.name;
                    byId("qvDesc").textContent = product.description;
                    byId("qvPrice").innerHTML = `${formatCurrency(product.price)} <small>/ ${escapeHtml(product.unit)}</small>`;
                    renderPackOptions(byId("qvPacks"), product, "qvPack");
                }

                function openQuickView(productId, sourceEl) {
                    const product = productById(productId);
                    if (!product || !qv) return;
                    const cardImg =
                        sourceEl?.closest(".product-card")?.querySelector(".product-image") ||
                        document.querySelector(`.product-card[data-product-id="${product.id}"] .product-image`);
                    const qvImg = byId("qvImg");
                    const show = () => {
                        fillQuickView(product);
                        openY(qv);
                        if (history.replaceState) history.replaceState(null, "", `#product-${product.id}`);
                    };
                    // Morph the card image into the dialog image (View Transitions API).
                    if (canTransition() && cardImg && cardImg.offsetParent && sourceEl?.closest(".product-card")) {
                        cardImg.style.viewTransitionName = "qv-image";
                        const vt = document.startViewTransition(() => {
                            cardImg.style.viewTransitionName = "";
                            qvImg.style.viewTransitionName = "qv-image";
                            show();
                        });
                        vt.finished.finally(() => (qvImg.style.viewTransitionName = ""));
                    } else {
                        show();
                    }
                }

                qv?.addEventListener("close", () => {
                    if (location.hash.startsWith("#product-") && history.replaceState) {
                        history.replaceState(null, "", location.pathname + location.search);
                    }
                });
                byId("qvAdd")?.addEventListener("click", () => {
                    if (!qvProduct) return;
                    const size = checkedPack(byId("qvPacks"));
                    closeY(qv);
                    addPacksToCart(qvProduct, size, 1);
                });
                byId("qvEnquire")?.addEventListener("click", () => {
                    if (!qvProduct) return;
                    const id = qvProduct.id;
                    closeY(qv);
                    if (typeof openEnquiryModal === "function") openEnquiryModal(id);
                });
                byId("qvShare")?.addEventListener("click", async () => {
                    if (!qvProduct) return;
                    const url = `${location.origin}${location.pathname}#product-${qvProduct.id}`;
                    const data = {
                        title: `${qvProduct.name} — Swapnil Chemicals`,
                        text: `${qvProduct.name}: ${qvProduct.description}. ${formatCurrency(qvProduct.price)}/${qvProduct.unit}`,
                        url,
                    };
                    try {
                        if (navigator.share && (!navigator.canShare || navigator.canShare(data))) {
                            await navigator.share(data);
                            return;
                        }
                        await navigator.clipboard.writeText(url);
                        toast("Product link copied");
                    } catch (err) {
                        if (err?.name !== "AbortError") toast("Couldn't share — copy the address bar link instead");
                    }
                });

                // Quick-view button on every product card. Cards are re-rendered by search,
                // so the button is added after each render instead of editing the template.
                const grid = byId("productsGrid");
                function decorateCards() {
                    grid?.querySelectorAll(".product-card").forEach((card) => {
                        const box = card.querySelector(".product-image-container");
                        if (!box || box.querySelector(".qv-btn")) return;
                        const name = card.querySelector("h3")?.textContent || "product";
                        box.insertAdjacentHTML(
                            "beforeend",
                            `<button type="button" class="qv-btn" data-action="quick-view" data-product-id="${card.dataset.productId}" aria-label="Quick view: ${escapeHtml(name)}"><i class="fas fa-expand" aria-hidden="true"></i>Quick view</button>`
                        );
                    });
                }
                if (grid) {
                    decorateCards();
                    new MutationObserver(decorateCards).observe(grid, { childList: true });
                }

                // Animate search/filter results with a view transition (cards glide into place).
                if (typeof filterProducts === "function" && typeof document.startViewTransition === "function") {
                    const originalFilter = filterProducts;
                    const nameCards = () =>
                        grid?.querySelectorAll(".product-card").forEach((c) => {
                            c.style.viewTransitionName = `pc-${c.dataset.productId}`;
                        });
                    const unnameCards = () =>
                        grid?.querySelectorAll(".product-card").forEach((c) => (c.style.viewTransitionName = ""));
                    // eslint-disable-next-line no-global-assign
                    filterProducts = function (query) {
                        const inView = grid && grid.getBoundingClientRect().top < window.innerHeight;
                        if (reduceMotion() || !inView) return originalFilter(query);
                        nameCards();
                        const vt = document.startViewTransition(() => {
                            originalFilter(query);
                            nameCards();
                        });
                        vt.finished.finally(unnameCards);
                    };
                }

                // ------------------------------------------------------------ bulk estimator
                const est = {
                    products: byId("estProducts"),
                    packs: byId("estPacks"),
                    total: byId("estTotal"),
                    breakdown: byId("estBreakdown"),
                    product: products[0],
                };
                function updateEstimate() {
                    const p = est.product;
                    if (!p || !est.total) return;
                    const size = checkedPack(est.packs);
                    const total = packTotal(p, size);
                    est.total.textContent = formatCurrency(total);
                    const unit = p.hasLtOptions ? (p.qtyLabel || "Lt").trim() : "pc";
                    est.breakdown.textContent = p.hasLtOptions
                        ? `${size} ${unit} × ${formatCurrency(p.price)}/${unit === "pcs" ? "pc" : unit}`
                        : `1 × ${formatCurrency(p.price)} per piece`;
                }
                function selectEstProduct(id) {
                    const p = productById(id);
                    if (!p) return;
                    est.product = p;
                    est.products?.querySelectorAll(".est-prod").forEach((b) =>
                        b.setAttribute("aria-pressed", String(Number(b.dataset.id) === p.id))
                    );
                    renderPackOptions(est.packs, p, "estPack", updateEstimate);
                    updateEstimate();
                }
                if (est.products) {
                    est.products.innerHTML = products
                        .map((p) => {
                            const variant = products.filter((x) => x.name === p.name).length > 1 ? ` · ${formatCurrency(p.price)}` : "";
                            return `<button type="button" class="est-prod" data-id="${p.id}" aria-pressed="false"><img src="${escapeHtml(p.image)}" alt="" loading="lazy" decoding="async">${escapeHtml(p.name)}${variant}</button>`;
                        })
                        .join("");
                    est.products.addEventListener("click", (e) => {
                        const b = e.target.closest(".est-prod");
                        if (b) selectEstProduct(b.dataset.id);
                    });
                    selectEstProduct(products[0].id);
                }
                byId("estForm")?.addEventListener("submit", (e) => e.preventDefault());
                byId("estAddBtn")?.addEventListener("click", () => {
                    if (est.product) addPacksToCart(est.product, checkedPack(est.packs), 1);
                });
                byId("estQuoteBtn")?.addEventListener("click", () => {
                    const p = est.product;
                    if (!p) return;
                    const size = checkedPack(est.packs);
                    const lines = [
                        "Hello Swapnil Chemicals, I'd like a quote:",
                        "",
                        `Product: ${p.name} (${formatCurrency(p.price)}/${p.unit})`,
                        `Pack: ${packLabel(p, size)}`,
                        `Estimated total (list price): ${formatCurrency(packTotal(p, size))}`,
                        "",
                        "Please confirm final price and delivery.",
                    ];
                    safeOpenNewTab(buildWhatsAppUrl(lines.join("\n")));
                });

                // ------------------------------------------------------------ command palette
                const cmdk = byId("cmdk");
                const cmdkInput = byId("cmdkInput");
                const cmdkList = byId("cmdkList");
                let cmdkItems = [];
                let cmdkIndex = 0;

                const go = (hash) => () => {
                    const el = document.querySelector(hash);
                    el?.scrollIntoView({ behavior: reduceMotion() ? "auto" : "smooth" });
                };
                const COMMANDS = [
                    ...products.map((p) => ({
                        group: "Products",
                        title: p.name,
                        sub: `${formatCurrency(p.price)} / ${p.unit} · ${p.description}`,
                        img: p.image,
                        icon: "fa-box",
                        keywords: `${p.name} ${p.description} product`,
                        run: () => openQuickView(p.id),
                    })),
                    { group: "Go to", title: "All products", icon: "fa-boxes-stacked", keywords: "shop catalogue range", run: go("#products") },
                    { group: "Go to", title: "Bulk estimator", icon: "fa-calculator", keywords: "price calculator quote wholesale bulk", run: go("#estimator") },
                    { group: "Go to", title: "Car-care routine", icon: "fa-list-ol", keywords: "guide steps how use", run: go("#routine") },
                    { group: "Go to", title: "Company & registrations", icon: "fa-building", keywords: "gst msme udyam brn owner about", run: go("#business-details") },
                    { group: "Go to", title: "FAQ", icon: "fa-circle-question", keywords: "questions help payment", run: go("#faq") },
                    { group: "Go to", title: "Contact", icon: "fa-envelope", keywords: "address location jaipur", run: go("#contact") },
                    { group: "Actions", title: "Open cart", icon: "fa-bag-shopping", keywords: "cart basket checkout invoice pdf", run: () => toggleCart() },
                    { group: "Actions", title: "Chat on WhatsApp", icon: "fa-comment", keywords: "whatsapp message chat", run: () => safeOpenNewTab(`https://wa.me/${APP.WA_NUMBER}`) },
                    { group: "Actions", title: "Call 93524 70085", icon: "fa-phone", keywords: "phone call mobile", run: () => (location.href = "tel:+919352470085") },
                    { group: "Actions", title: "Email us", icon: "fa-at", keywords: "email mail", run: () => (location.href = "mailto:swapnilchemicals10@gmail.com") },
                    { group: "Actions", title: "Ask the assistant", icon: "fa-robot", keywords: "ai assistant bot help", run: () => toggleAssistant() },
                ];

                function rankCommands(q) {
                    const words = q.toLowerCase().split(/\s+/).filter(Boolean);
                    if (!words.length) return COMMANDS;
                    return COMMANDS.map((c) => {
                        const hay = `${c.title} ${c.keywords || ""}`.toLowerCase();
                        let score = 0;
                        for (const w of words) {
                            if (c.title.toLowerCase().startsWith(w)) score += 5;
                            else if (hay.includes(w)) score += 3;
                            else if (hay.split(/\s+/).some((h) => fuzzyWordsMatch(h, w))) score += 1;
                            else return null;
                        }
                        return { c, score };
                    })
                        .filter(Boolean)
                        .sort((a, b) => b.score - a.score)
                        .map((x) => x.c);
                }

                function renderCmdk() {
                    const q = cmdkInput.value.trim();
                    cmdkItems = rankCommands(q);
                    cmdkIndex = 0;
                    if (!cmdkItems.length) {
                        cmdkList.innerHTML = `<li class="cmdk-empty">Nothing found for “${escapeHtml(q)}”. Try “polish”, “towel” or “GST”.</li>`;
                        cmdkInput.removeAttribute("aria-activedescendant");
                        return;
                    }
                    let lastGroup = "";
                    cmdkList.innerHTML = cmdkItems
                        .map((c, i) => {
                            const header = !q && c.group !== lastGroup ? `<li class="cmdk-group" role="presentation">${c.group}</li>` : "";
                            lastGroup = c.group;
                            const ico = c.img
                                ? `<img src="${escapeHtml(c.img)}" alt="" loading="lazy" decoding="async" data-fallback-icon="${escapeHtml(c.icon)}">`
                                : `<i class="fas ${c.icon}" aria-hidden="true"></i>`;
                            return `${header}<li class="cmdk-item" role="option" id="cmdk-${i}" data-i="${i}" aria-selected="${i === 0}">
                                <span class="cmdk-ico">${ico}</span>
                                <span class="cmdk-text"><b>${escapeHtml(c.title)}</b>${c.sub ? `<small>${escapeHtml(c.sub)}</small>` : ""}</span>
                                <i class="fas fa-arrow-turn-down fa-rotate-90 cmdk-go" aria-hidden="true"></i>
                            </li>`;
                        })
                        .join("");
                    cmdkInput.setAttribute("aria-activedescendant", "cmdk-0");
                }
                function moveCmdk(delta) {
                    if (!cmdkItems.length) return;
                    cmdkIndex = (cmdkIndex + delta + cmdkItems.length) % cmdkItems.length;
                    cmdkList.querySelectorAll(".cmdk-item").forEach((el) => {
                        const on = Number(el.dataset.i) === cmdkIndex;
                        el.setAttribute("aria-selected", String(on));
                        if (on) el.scrollIntoView({ block: "nearest" });
                    });
                    cmdkInput.setAttribute("aria-activedescendant", `cmdk-${cmdkIndex}`);
                }
                function runCmdk(i) {
                    const c = cmdkItems[i];
                    if (!c) return;
                    closeY(cmdk);
                    // Let the palette close before opening the next dialog/scrolling.
                    requestAnimationFrame(() => c.run());
                }
                function openCmdk() {
                    if (!cmdk) return;
                    cmdkInput.value = "";
                    renderCmdk();
                    openY(cmdk);
                    cmdkInput.focus();
                }
                cmdkInput?.addEventListener("input", renderCmdk);
                cmdkInput?.addEventListener("keydown", (e) => {
                    if (e.key === "ArrowDown") {
                        e.preventDefault();
                        moveCmdk(1);
                    } else if (e.key === "ArrowUp") {
                        e.preventDefault();
                        moveCmdk(-1);
                    } else if (e.key === "Enter") {
                        e.preventDefault();
                        runCmdk(cmdkIndex);
                    }
                });
                cmdkList?.addEventListener("click", (e) => {
                    const item = e.target.closest(".cmdk-item");
                    if (item) runCmdk(Number(item.dataset.i));
                });
                cmdkList?.addEventListener("pointermove", (e) => {
                    const item = e.target.closest(".cmdk-item");
                    if (item && Number(item.dataset.i) !== cmdkIndex) moveCmdk(Number(item.dataset.i) - cmdkIndex);
                });
                document.addEventListener("keydown", (e) => {
                    const typing = e.target.closest?.("input, textarea, select, [contenteditable='true']");
                    if ((e.key === "k" || e.key === "K") && (e.metaKey || e.ctrlKey)) {
                        e.preventDefault();
                        cmdk?.open ? closeY(cmdk) : openCmdk();
                    } else if (e.key === "/" && !typing && !document.querySelector("dialog[open]")) {
                        e.preventDefault();
                        openCmdk();
                    }
                });
                const kbd = document.querySelector(".cmdk-trigger kbd");
                // navigator.platform is deprecated; prefer User-Agent Client Hints where available.
                const platform = navigator.userAgentData?.platform ?? navigator.userAgent;
                if (kbd && !/mac|iphone|ipad|ios/i.test(platform)) kbd.textContent = "Ctrl K";

                // ------------------------------------------------------------ delegated actions
                document.addEventListener("click", (e) => {
                    const t = e.target.closest("[data-action]");
                    if (!t) return;
                    switch (t.dataset.action) {
                        case "quick-view":
                            e.preventDefault();
                            openQuickView(t.dataset.productId, t);
                            break;
                        case "open-cmdk":
                            openCmdk();
                            break;
                        default:
                            break;
                    }
                });

                // ------------------------------------------------------------ scroll-spy
                const navLinks = Array.from(document.querySelectorAll(".site-nav a[href^='#']"));
                const spyTargets = navLinks.map((a) => document.querySelector(a.getAttribute("href"))).filter(Boolean);
                if ("IntersectionObserver" in window && spyTargets.length) {
                    const visible = new Map();
                    const spy = new IntersectionObserver(
                        (entries) => {
                            entries.forEach((en) => visible.set(en.target.id, en.isIntersecting));
                            const current = spyTargets.find((s) => visible.get(s.id));
                            navLinks.forEach((a) => {
                                if (current && a.getAttribute("href") === `#${current.id}`) a.setAttribute("aria-current", "true");
                                else a.removeAttribute("aria-current");
                            });
                        },
                        { rootMargin: "-45% 0px -50% 0px" }
                    );
                    spyTargets.forEach((s) => spy.observe(s));
                }

                // ------------------------------------------------------------ app badge (installed PWA)
                const badge = byId("cartBadge");
                if (badge && "setAppBadge" in navigator) {
                    const syncBadge = () => {
                        const n = parseInt(badge.textContent, 10) || 0;
                        (n > 0 ? navigator.setAppBadge(n) : navigator.clearAppBadge()).catch(() => {});
                    };
                    new MutationObserver(syncBadge).observe(badge, { childList: true, characterData: true, subtree: true });
                }

                // ------------------------------------------------------------ deep links (#product-3)
                function openFromHash() {
                    const m = /^#product-(\d+)$/.exec(location.hash);
                    if (m && productById(m[1])) openQuickView(m[1]);
                }
                if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", openFromHash);
                else openFromHash();
                window.addEventListener("hashchange", openFromHash);
            })();
        </script>
