                TIME_SLOTS: Object.freeze([
                    { startHour: 10, label: "10:00 AM – 12:00 PM" },
                    { startHour: 12, label: "12:00 PM – 2:00 PM" },
                    { startHour: 14, label: "2:00 PM – 4:00 PM" },
                ]),
            });

            function isValidIndianMobile(value) {
                return /^[6-9]\d{9}$/.test(String(value || "").trim());
            }

            function safeParseJSON(raw, fallback) {
                try {
                    const parsed = JSON.parse(raw);
                    return parsed ?? fallback;
                } catch {
                    return fallback;
                }
            }

            // localStorage can throw (private mode, full quota, blocked site data) - never let that break the page.
            const storage = {
                get(key, fallback) {
                    try {
                        const raw = localStorage.getItem(key);
                        return raw === null ? fallback : safeParseJSON(raw, fallback);
                    } catch {
                        return fallback;
                    }
                },
                set(key, value) {
                    try {
                        localStorage.setItem(key, JSON.stringify(value));
                    } catch {
                        // Not persisted; the in-memory state still works for this visit.
                    }
                },
                remove(key) {
                    try {
                        localStorage.removeItem(key);
                    } catch {
                        // Nothing to clean up if storage is unavailable.
                    }
                },
            };

            function persistCart() {
                storage.set(APP.CART_STORAGE_KEY, cart);
            }

            function safeOpenNewTab(url) {
                window.open(url, "_blank", "noopener,noreferrer");
            }

            function buildWhatsAppUrl(message) {
                return `https://wa.me/${APP.WA_NUMBER}?text=${encodeURIComponent(message)}`;
            }

            // Escapes all five HTML-significant characters. The old textContent→innerHTML trick
            // left `"` and `'` untouched, which is unsafe inside attributes such as alt="…" or
            // aria-label="…" — every template below interpolates into attributes.
            const HTML_ESCAPES = Object.freeze({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" });
            function escapeHtml(str) {
                return String(str ?? "").replace(/[&<>"']/g, (ch) => HTML_ESCAPES[ch]);
            }

            // Non-blocking status message (replaces window.alert). #yToast is a manual popover, so
            // it renders in the top layer — above an open modal <dialog> — and role="status"
            // makes screen readers announce it.
            let toastTimer;
            function showToast(message, { duration = 2600 } = {}) {
                const el = document.getElementById("yToast");
                if (!el || typeof el.showPopover !== "function") return;
                el.textContent = message;
                try {
                    // Re-show so the toast moves above any dialog opened since it last appeared.
                    if (el.matches(":popover-open")) el.hidePopover();
                    // A modal dialog makes everything outside it inert (and hidden from screen
                    // readers), so host the toast inside whichever modal is open.
                    const host = document.querySelector("dialog:modal") ?? document.body;
                    if (el.parentElement !== host) host.append(el);
                    el.showPopover();
                } catch {
                    return;
                }
                clearTimeout(toastTimer);
                toastTimer = setTimeout(() => {
                    try {
                        el.hidePopover();
                    } catch {
                        // Already hidden.
                    }
                }, duration);
            }

            const currencyFormatter = new Intl.NumberFormat("en-IN", {
                style: "currency",
                currency: APP.CURRENCY,
                maximumFractionDigits: 0,
            });

            function formatCurrency(amount) {
                return currencyFormatter.format(amount);
            }

            function debounce(fn, delay) {
                let timeoutId;
                return (...args) => {
                    clearTimeout(timeoutId);
                    timeoutId = setTimeout(() => fn(...args), delay);
                };
            }

            async function copyText(text, btn) {
                try {
                    if (!navigator.clipboard || !window.isSecureContext) {
                        throw new Error("Clipboard API unavailable outside a secure context");
                    }
                    await navigator.clipboard.writeText(text);
                    if (btn) {
                        const original = btn.innerHTML;
                        btn.disabled = true;
                        btn.innerHTML = '<i class="fas fa-check" aria-hidden="true"></i>';
                        setTimeout(() => {
                            btn.innerHTML = original;
                            btn.disabled = false;
                        }, 1400);
                    }
                } catch (err) {
                    if (btn) btn.title = "Copy failed — please select the text manually";
                }
            }


