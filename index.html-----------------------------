                    min-height: 3lh;
                }
                :focus-visible {
                    outline: 2px solid var(--focus);
                    outline-offset: 3px;
                }

                /* ---------------------------------------------------- header extras */
                .site-nav a,
                .header-call {
                    white-space: nowrap;
                }
                .site-nav a {
                    padding-inline: 12px;
                }
                @media (max-width: 1360px) {
                    .header-call span {
