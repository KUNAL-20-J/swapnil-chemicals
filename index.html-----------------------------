            /* ----------------------------------------------------------- utilities */
            @layer utilities {
                .hidden {
                    display: none;
                }
                .visually-hidden {
                    position: absolute;
                    width: 1px;
                    height: 1px;
                    padding: 0;
                    margin: -1px;
                    overflow: hidden;
                    clip: rect(0 0 0 0);
                    white-space: nowrap;
                    border: 0;
                }
                .anim-paused,
                .anim-paused *,
                .anim-paused *::before,
                .anim-paused *::after {
                    animation-play-state: paused !important;
                }
                @supports not selector(:popover-open) {
                    .menu-btn,
                    .mobile-nav {
                        display: none !important;
                    }
                }
            }

            /* -------------------------------------------------------------- states */
            @layer states {
                /* Panels toggle the Tailwind-style `hidden` class from JS; animate instead of snapping. */
                .cart-panel.hidden,
                .assistant-panel.hidden {
                    display: flex;
                    visibility: hidden;
                    opacity: 0;
                    translate: 0 16px;
                    pointer-events: none;
                }
                #scrollToTop.hidden {
                    display: grid;
                    visibility: hidden;
                    opacity: 0;
                    translate: 0 12px;
                    pointer-events: none;
                }
                @media (max-width: 640px) {
                    .cart-panel.hidden,
                    .assistant-panel.hidden {
                        translate: 0 100%;
                    }
                    body.cart-open .ai-assistant-btn {
                        visibility: hidden;
                    }
                }
            }

            /* ---------------------------------------------------------------- gloss
               Glossy finish layer (Nov 2026). Declared last, so it wins over the
               layers above. Delete this whole block to revert to the flat look.
               ---------------------------------------------------------------------- */
            @layer gloss {
                :root {
                    --gloss-top: linear-gradient(180deg, oklch(1 0 0 / 0.32) 0%, oklch(1 0 0 / 0.08) 48%, oklch(1 0 0 / 0) 52%);
                    --gloss-soft: linear-gradient(180deg, oklch(1 0 0 / 0.14) 0%, oklch(1 0 0 / 0) 45%);
                    --gloss-edge: inset 0 1px 0 oklch(1 0 0 / 0.45), inset 0 -1px 0 oklch(0.2 0.05 262 / 0.12);
                    --glow-brand: 0 14px 34px oklch(0.55 0.2 260 / 0.3);
                }

                /* Soft blue wash behind the whole page instead of flat grey */
                body {
                    background:
                        radial-gradient(1100px 520px at 0% -5%, var(--brand-100), transparent 60%),
                        radial-gradient(900px 480px at 100% 10%, oklch(0.95 0.04 205), transparent 60%),
                        var(--bg);
                }

                /* ---------- Header: frosted glass ---------- */
                .site-header {
                    background: oklch(1 0 0 / 0.7);
                    backdrop-filter: saturate(1.8) blur(18px);
                    -webkit-backdrop-filter: saturate(1.8) blur(18px);
                    box-shadow: inset 0 -1px 0 oklch(1 0 0 / 0.7);
                }
                .site-header.scrolled {
                    background: oklch(1 0 0 / 0.82);
                    box-shadow: inset 0 -1px 0 oklch(1 0 0 / 0.7), 0 8px 24px oklch(0.4 0.12 262 / 0.08);
                }

                /* ---------- Glossy buttons ---------- */
                .btn-primary {
                    background: var(--gloss-top), var(--grad-brand);
                    box-shadow: var(--gloss-edge), var(--glow-brand);
                }
                .btn-primary:hover {
                    background: var(--gloss-top), linear-gradient(135deg, var(--brand-500) 0%, var(--aqua-300) 100%);
                    box-shadow: var(--gloss-edge), 0 18px 44px oklch(0.55 0.2 260 / 0.45);
                }
                .btn-whatsapp {
                    background: var(--gloss-top), linear-gradient(135deg, var(--wa-500), var(--wa-600));
                    box-shadow: var(--gloss-edge), 0 12px 28px oklch(0.6 0.16 152 / 0.3);
                }
                .btn-whatsapp:hover {
                    background: var(--gloss-top), linear-gradient(135deg, oklch(0.76 0.19 150), var(--wa-500));
                }
                .btn-glass {
                    background: linear-gradient(180deg, oklch(1 0 0 / 0.22), oklch(1 0 0 / 0.06));
                    box-shadow: inset 0 1px 0 oklch(1 0 0 / 0.4);
                    backdrop-filter: blur(12px) saturate(1.4);
                }
                .btn-glass:hover {
                    background: linear-gradient(180deg, oklch(1 0 0 / 0.3), oklch(1 0 0 / 0.12));
                }
                .btn-light {
                    background: linear-gradient(180deg, #fff 0%, var(--brand-50) 100%);
                    box-shadow: inset 0 1px 0 #fff, var(--shadow-sm);
                }
                .header-call,
                #scrollToTop {
                    background: var(--gloss-top), linear-gradient(135deg, var(--deep-700), var(--brand-600));
                    box-shadow: var(--gloss-edge), 0 8px 20px oklch(0.5 0.18 260 / 0.3);
                }
                .header-call:hover,
                #scrollToTop:hover {
                    background: var(--gloss-top), linear-gradient(135deg, var(--brand-600), var(--aqua-500));
                }

                /* ---------- Hero: light reflection + slow shimmer ---------- */
                .hero::before {
                    content: "";
                    position: absolute;
                    inset: 0 0 auto 0;
                    height: 60%;
                    z-index: -1;
                    background: linear-gradient(180deg, oklch(1 0 0 / 0.14), oklch(1 0 0 / 0));
                    pointer-events: none;
                }
                .hero::after {
                    content: "";
                    position: absolute;
                    inset: -20% -40%;
                    z-index: -1;
                    background: linear-gradient(115deg, transparent 42%, oklch(1 0 0 / 0.09) 50%, transparent 58%);
                    animation: gloss-sweep 9s ease-in-out infinite;
                    pointer-events: none;
                }
                @keyframes gloss-sweep {
                    0%, 35% { translate: -40% 0; }
                    100% { translate: 40% 0; }
                }
                .hero-stats div {
                    background: linear-gradient(180deg, oklch(1 0 0 / 0.2), oklch(1 0 0 / 0.06));
                    backdrop-filter: blur(10px);
                    -webkit-backdrop-filter: blur(10px);
                    box-shadow: inset 0 1px 0 oklch(1 0 0 / 0.35);
                }

                /* ---------- Cards: glossy white with blue glow on hover ---------- */
                .feature-card:not(.is-hero),
                .product-card {
                    background: linear-gradient(180deg, #fff 0%, oklch(0.985 0.01 250) 100%);
                    border-color: oklch(0.92 0.02 255);
                    box-shadow: inset 0 1px 0 #fff, var(--shadow-sm);
                }
                .feature-card:not(.is-hero):hover,
                .product-card:hover {
                    border-color: var(--brand-200);
                    box-shadow: inset 0 1px 0 #fff, 0 2px 6px oklch(0.5 0.15 260 / 0.06), 0 22px 48px oklch(0.55 0.2 260 / 0.16);
                }

                /* ---------- Dark-blue panels: add top reflection + light rim ---------- */
                .feature-card.is-hero,
                .cta-panel,
                .assistant-panel-header,
                .enquiry-modal-header {
                    background: var(--gloss-soft), var(--grad-ink);
                    box-shadow: inset 0 1px 0 oklch(1 0 0 / 0.25);
                }
                .cta-panel {
                    border: 1px solid oklch(1 0 0 / 0.14);
                    box-shadow: inset 0 1px 0 oklch(1 0 0 / 0.3), 0 30px 70px oklch(0.45 0.17 260 / 0.28);
                }

                /* ---------- Footer: blue gradient instead of flat ---------- */
                .site-footer {
                    background:
                        radial-gradient(800px 300px at 15% 0%, oklch(0.6 0.15 230 / 0.25), transparent 70%),
                        linear-gradient(180deg, oklch(0.44 0.15 258), var(--deep-800));
                    box-shadow: inset 0 1px 0 oklch(1 0 0 / 0.15);
                }

                @media (prefers-reduced-motion: reduce) {
                    .hero::after {
                        animation: none;
                    }
                }
            }

            /* --------------------------------------------------------------- market
               Storefront polish (Nov 2026): announcement bar, trust strip, category
               chips, product badges, mobile action bar. Delete block to revert.
               ---------------------------------------------------------------------- */
            @layer market {
                /* ---------- Announcement bar ---------- */
                .announce-bar {
                    background: linear-gradient(90deg, var(--deep-800), var(--brand-600) 55%, var(--aqua-500));
                    color: #fff;
                    font-size: var(--fs-xs);
                    font-weight: 500;
                }
                .announce-inner {
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    gap: 16px;
                    min-height: 38px;
                }
                .announce-text {
                    display: flex;
                    align-items: center;
                    gap: 8px;
                    margin: 0;
                    min-width: 0;
                }
                .announce-text span {
                    overflow: hidden;
                    text-overflow: ellipsis;
                    white-space: nowrap;
                }
                .announce-links {
                    display: flex;
                    gap: 18px;
                    flex-shrink: 0;
                }
                .announce-links a {
                    display: inline-flex;
                    align-items: center;
                    gap: 6px;
                    color: #fff;
                    opacity: 0.92;
                    transition: opacity var(--dur-fast);
                }
                .announce-links a:hover {
                    opacity: 1;
                    text-decoration: underline;
                    text-underline-offset: 3px;
                }

                /* ---------- Section headings: accent bar under titles ---------- */
                .section-title {
                    letter-spacing: -0.02em;
                    line-height: 1.15;
                }
                .section-head:not(.is-split) .section-title::after,
                .section-head.is-split .section-title::after,
                .faq-aside .section-title::after {
                    content: "";
                    display: block;
                    width: 56px;
                    height: 4px;
                    margin-top: 14px;
                    border-radius: var(--radius-pill);
                    background: var(--grad-brand);
                }
                .section-head:not(.is-split) {
                    text-align: center;
                    margin-inline: auto;
                }
                .section-head:not(.is-split) .section-title::after {
                    margin-inline: auto;
                }

                /* ---------- Trust strip ---------- */
                .trust-strip {
                    position: relative;
                    z-index: 2;
                    margin-top: -1px;
                    padding-block: 28px;
                    background: var(--surface);
                    border-bottom: 1px solid var(--border);
                }
                .trust-grid {
                    display: grid;
                    grid-template-columns: repeat(4, minmax(0, 1fr));
                    gap: 16px;
                    margin: 0;
                    padding: 0;
                    list-style: none;
                }
                .trust-item {
                    display: flex;
                    align-items: center;
                    gap: 14px;
                    padding: 14px 16px;
                    border-radius: var(--radius-md);
                    background: linear-gradient(180deg, #fff, var(--brand-50));
                    border: 1px solid var(--brand-100);
                    box-shadow: inset 0 1px 0 #fff, var(--shadow-xs);
                    transition: transform var(--dur) var(--ease-out), box-shadow var(--dur);
                }
                .trust-item:hover {
                    transform: translateY(-2px);
                    box-shadow: inset 0 1px 0 #fff, 0 12px 28px oklch(0.55 0.2 260 / 0.12);
                }
                .trust-item b {
                    display: block;
                    font-size: var(--fs-sm);
                    color: var(--ink-900);
                }
                .trust-item small {
                    display: block;
                    margin-top: 2px;
                    font-size: var(--fs-xs);
                    color: var(--text-muted);
                }
                .trust-icon {
                    display: grid;
                    place-items: center;
                    flex-shrink: 0;
                    width: 44px;
                    height: 44px;
                    border-radius: 12px;
                    color: #fff;
                    font-size: 18px;
                    background: var(--gloss-top), var(--grad-brand);
                    box-shadow: var(--gloss-edge), 0 6px 14px oklch(0.55 0.2 260 / 0.25);
                }
                .trust-icon.is-wa {
                    background: var(--gloss-top), linear-gradient(135deg, var(--wa-500), var(--wa-600));
                    box-shadow: var(--gloss-edge), 0 6px 14px oklch(0.6 0.16 152 / 0.25);
                }

                /* ---------- Category chips ---------- */
                .category-chips {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 10px;
                    margin: 0 0 28px;
                }
                .chip {
                    display: inline-flex;
                    align-items: center;
                    gap: 8px;
                    min-height: 40px;
                    padding: 8px 18px;
                    border-radius: var(--radius-pill);
                    border: 1px solid var(--border);
                    background: linear-gradient(180deg, #fff, var(--ink-50));
                    color: var(--ink-700);
                    font-size: var(--fs-sm);
                    font-weight: 600;
                    cursor: pointer;
                    box-shadow: inset 0 1px 0 #fff, var(--shadow-xs);
                    transition: color var(--dur-fast), border-color var(--dur-fast), box-shadow var(--dur), translate var(--dur) var(--ease-out);
                }
                .chip:hover {
                    color: var(--brand-700);
                    border-color: var(--brand-200);
                    translate: 0 -1px;
                }
                .chip.is-active {
                    color: #fff;
                    border-color: transparent;
                    background: var(--gloss-top), var(--grad-brand);
                    box-shadow: var(--gloss-edge), 0 8px 20px oklch(0.55 0.2 260 / 0.28);
                }
                .chip:focus-visible {
                    outline: 2px solid var(--focus);
                    outline-offset: 2px;
                }

                /* ---------- Product cards: badge, price, buttons ---------- */
                .product-badge {
                    position: absolute;
                    top: 12px;
                    left: 12px;
                    z-index: 3;
                    display: inline-flex;
                    align-items: center;
                    gap: 6px;
                    padding: 5px 10px;
                    border-radius: var(--radius-pill);
                    background: oklch(1 0 0 / 0.85);
                    backdrop-filter: blur(8px);
                    -webkit-backdrop-filter: blur(8px);
                    border: 1px solid oklch(1 0 0 / 0.9);
                    color: var(--brand-700);
                    font-size: 11px;
                    font-weight: 700;
                    letter-spacing: 0.02em;
                    box-shadow: var(--shadow-sm);
                }
                .product-card h3 {
                    letter-spacing: -0.01em;
                }
                .add-to-cart-btn {
                    background: var(--gloss-top), var(--grad-brand);
                    box-shadow: var(--gloss-edge), 0 8px 20px oklch(0.55 0.2 260 / 0.28);
                }
                .enquiry-trigger-btn {
                    box-shadow: inset 0 1px 0 #fff, var(--shadow-xs);
                }

                /* ---------- Footer bottom line ---------- */
                .footer-bottom {
                    border-top-color: oklch(1 0 0 / 0.16);
                }

                /* ---------- Mobile action bar (phones only) ---------- */
                .mobile-actionbar {
                    display: none;
                }
                @media (max-width: 768px) {
                    .mobile-actionbar {
                        position: fixed;
                        inset: auto 0 0 0;
                        z-index: 45;
                        display: grid;
                        grid-template-columns: repeat(4, 1fr);
                        padding: 6px 8px calc(6px + env(safe-area-inset-bottom));
                        background: oklch(1 0 0 / 0.86);
                        backdrop-filter: saturate(1.8) blur(16px);
                        -webkit-backdrop-filter: saturate(1.8) blur(16px);
                        border-top: 1px solid var(--border);
                        box-shadow: 0 -8px 24px oklch(0.4 0.12 262 / 0.08);
                    }
                    .mobile-actionbar a,
                    .mobile-actionbar button {
                        position: relative;
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                        justify-content: center;
                        gap: 3px;
                        min-height: 52px;
                        border: 0;
                        border-radius: 12px;
                        background: none;
                        color: var(--ink-700);
                        font-size: 11px;
                        font-weight: 600;
                        cursor: pointer;
                    }
                    .mobile-actionbar i {
                        font-size: 18px;
                        color: var(--brand-600);
                    }
                    .mobile-actionbar .is-wa i {
                        color: var(--wa-600);
                    }
                    .mobile-actionbar a:active,
                    .mobile-actionbar button:active {
                        background: var(--brand-50);
                    }
                    .actionbar-badge {
                        position: absolute;
                        top: 4px;
                        left: calc(50% + 6px);
                        min-width: 18px;
                        height: 18px;
                        padding: 0 5px;
                        border-radius: var(--radius-pill);
                        background: var(--danger-500);
                        color: #fff;
                        font-size: 10px;
                        line-height: 18px;
                        text-align: center;
                    }
                    .actionbar-badge[hidden] {
                        display: none;
                    }
                    body {
                        padding-bottom: calc(66px + env(safe-area-inset-bottom));
                    }
                    #scrollToTop {
                        bottom: calc(82px + env(safe-area-inset-bottom));
                    }
                    .ai-assistant-btn {
                        bottom: calc(138px + env(safe-area-inset-bottom));
                    }
                    body.cart-open .mobile-actionbar {
                        display: none;
                    }
                    .trust-grid {
                        grid-template-columns: repeat(2, minmax(0, 1fr));
                    }
                    .announce-mail {
                        display: none;
                    }
                }
                @media (max-width: 640px) {
                    .announce-links {
                        display: none;
                    }
                    .announce-inner {
                        justify-content: center;
                    }
                    .trust-item {
                        flex-direction: column;
                        align-items: flex-start;
                        gap: 10px;
                        padding: 12px;
                    }
                    .category-chips {
                        flex-wrap: nowrap;
                        overflow-x: auto;
                        scrollbar-width: none;
                        margin-inline: calc(var(--gutter) * -1);
                        padding-inline: var(--gutter);
                        padding-bottom: 4px;
                    }
                    .chip {
                        flex-shrink: 0;
                    }
                }
                @media (max-width: 1024px) and (min-width: 769px) {
                    .trust-grid {
                        grid-template-columns: repeat(2, minmax(0, 1fr));
                    }
                }
            }

            /* =====================================================================
               2027 layer — command palette, quick view, bulk estimator,
               care routine, scroll-driven motion. Declared last, so it wins over
               every earlier layer without !important.
               ===================================================================== */
            @view-transition {
                navigation: auto;
            }

            @layer y2027 {
                /* ---------------------------------------------------- typography polish */
                h1, h2, h3, .section-title, .hero-title {
                    text-wrap: balance;
                }
                p, li, .section-lead {
