            function initCustomerFields(p) {
                const phoneEl = document.getElementById(`${p}-phone`);
                const hintEl = document.getElementById(`${p}-customer-hint`);
                const workshopEl = document.getElementById(`${p}-workshop`);
                const choiceEl = document.getElementById(`${p}-workshop-choice`);
                const editBtn = document.getElementById(`${p}-workshop-edit`);
                const dateEl = document.getElementById(`${p}-date`);
                const slotEl = document.getElementById(`${p}-slot`);
                if (!phoneEl || !hintEl || !workshopEl || !choiceEl || !editBtn || !dateEl || !slotEl) return;

                const fillSlots = () => {
                    const previous = slotEl.value;
                    const slots = availableSlots(dateEl.value);
                    slotEl.replaceChildren(
                        new Option(slots.length ? "Select a slot" : "No slots left", ""),
                        ...slots.map((slot) => new Option(slot.label, slot.label))
                    );
                    if (slots.some((slot) => slot.label === previous)) slotEl.value = previous;
                };
                dateEl.addEventListener("change", () => {
                    fillSlots();
                    document.getElementById(`${p}-date-error`)?.classList.add("hidden");
                });
                slotEl.addEventListener("change", () =>
                    document.getElementById(`${p}-slot-error`)?.classList.add("hidden")
                );
                fillSlots();

                const defaultHint = hintEl.textContent;
                const phoneDigits = () => phoneEl.value.replace(/\D/g, "").slice(0, 10);
                let lookupId = 0;

                const setWorkshop = (name, fromRecords) => {
                    workshopEl.value = name;
                    workshopEl.readOnly = fromRecords;
                    workshopEl.dataset.source = fromRecords ? "khatabook" : "";
                    editBtn.classList.toggle("hidden", !fromRecords);
                };

                const hideChoices = () => {
                    choiceEl.replaceChildren();
                    choiceEl.classList.add("hidden");
                };

                const lookup = async (digits) => {
                    const id = ++lookupId;
                    hintEl.textContent = "Checking our customer records…";
                    const results = await fetchWorkshops({ phone: digits });
                    // Ignore stale answers if the number changed while we were waiting.
                    if (id !== lookupId || phoneDigits() !== digits) return;
                    hideChoices();
                    if (results === null) {
                        hintEl.textContent =
                            "Couldn't check our customer records right now - please type your workshop name below.";
                        return;
                    }
                    const names = results.map((r) => r.name).filter(Boolean);
                    if (!names.length) {
                        if (workshopEl.dataset.source === "khatabook") setWorkshop("", false);
                        hintEl.textContent = "This number isn't in our records - please type your workshop name below.";
                        return;
