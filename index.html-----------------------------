            // Purely decorative: a PDF sheet arcs from the button up to the top-right corner,
            // where browsers surface finished downloads.
            function flyPdfToDownloads(btn) {
                if (!btn || prefersReducedMotion() || typeof Element.prototype.animate !== "function") return;
                const srcRect = btn.getBoundingClientRect();
                if (srcRect.width === 0 || srcRect.height === 0) return;

                const flyer = document.createElement("div");
                flyer.className = "pdf-flyer";
                flyer.setAttribute("aria-hidden", "true");
                flyer.innerHTML = '<i class="fas fa-file-arrow-down"></i><span>PDF</span>';
                // The button lives inside a modal <dialog> (top layer); anything appended to <body>
                // would render underneath it, so the flyer goes into the dialog itself.
                (btn.closest("dialog") || document.body).appendChild(flyer);

                const startX = srcRect.left + srcRect.width / 2 - 23;
                const startY = srcRect.top + srcRect.height / 2 - 29;
                flyer.style.left = `${startX}px`;
                flyer.style.top = `${startY}px`;

                const dx = window.innerWidth - 60 - startX;
                const dy = 16 - startY;

                const animation = flyer.animate(
                    [
                        { transform: "translate(0, 0) scale(0.4) rotate(0deg)", opacity: 0 },
                        { transform: "translate(0, -24px) scale(1.15) rotate(-6deg)", opacity: 1, offset: 0.18 },
                        {
                            transform: `translate(${dx * 0.45}px, ${dy * 0.25 - 70}px) scale(1) rotate(8deg)`,
                            opacity: 1,
                            offset: 0.55,
                        },
                        { transform: `translate(${dx}px, ${dy}px) scale(0.3) rotate(18deg)`, opacity: 0.2 },
                    ],
                    { duration: 1100, easing: "cubic-bezier(0.45, 0, 0.25, 1)", fill: "forwards" }
                );
                const cleanup = () => flyer.remove();
                animation.onfinish = cleanup;
                animation.oncancel = cleanup;
            }

            // The grid is below the hero, so every image is lazy: the browser still starts them well
            // before they scroll into view, without competing with the first paint.
