                    btn.innerHTML = '<i class="fas fa-spinner fa-spin" aria-hidden="true"></i> Preparing PDF...';
                }
                try {
                    const JsPDF = await loadJsPdf();
                    // Plain boxed layout in the style of a Tally tax invoice: black text and ruled cells.
                    const doc = new JsPDF({ unit: "mm", format: "a4", compress: true });
                    const pageW = doc.internal.pageSize.getWidth();
                    const pageH = doc.internal.pageSize.getHeight();
                    const L = 10;
                    const R = pageW - 10;
                    const W = R - L; // 190 mm on A4
                    const boxTop = 14;
                    const boxBottom = pageH - 14; // jurisdiction lines sit under the box
                    const midX = L + 95; // left party blocks | right invoice details grid
                    const gridMid = midX + (R - midX) / 2;
                    const pad = 1.6;

                    const font = (style, size) => {
                        doc.setFont("helvetica", style);
                        doc.setFontSize(size);
                    };
                    const hLine = (x1, x2, yy) => doc.line(x1, yy, x2, yy);
                    const vLine = (xx, y1, y2) => doc.line(xx, y1, xx, y2);
                    // First line of `str` that fits in `width` with the current font.
                    const fit = (str, width) => doc.splitTextToSize(String(str || ""), width)[0] || "";
                    const round2 = (n) => Math.round((n + Number.EPSILON) * 100) / 100;
                    const money = (n) => pdfAmountFormatter.format(n);
                    doc.setTextColor(0, 0, 0);
                    doc.setDrawColor(0, 0, 0);
                    doc.setLineWidth(0.25);

                    // Customer details are read straight from the enquiry form; nothing here is required.
                    const fieldValue = (id) => document.getElementById(id)?.value.trim() || "";
                    const phone = fieldValue("cart-enquiry-phone").replace(/\D/g, "");
                    const customer = {
                        workshop: pdfText(fieldValue("cart-enquiry-workshop")),
                        phone: phone ? `${APP.COUNTRY_CODE} ${phone}` : "",
                        address: pdfText(fieldValue("cart-enquiry-details").replace(/\s*,?\s*\n\s*/g, ", ")),
                        date: fieldValue("cart-enquiry-date"),
                        slot: pdfText(fieldValue("cart-enquiry-slot")),
                    };

                    const now = new Date();
                    const pad2 = (n) => String(n).padStart(2, "0");
                    const year = now.getFullYear();
                    const fyStart = now.getMonth() >= 3 ? year : year - 1; // Indian financial year starts in April
                    const finYear = `${fyStart}-${String(fyStart + 1).slice(2)}`;
                    const invoiceNo = `SC/${finYear}/${pad2(now.getMonth() + 1)}${pad2(now.getDate())}${pad2(now.getHours())}${pad2(now.getMinutes())}`;
                    const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
                    const invoiceDate = `${pad2(now.getDate())}-${MONTHS[now.getMonth()]}-${String(year).slice(2)}`;

                    // ---- Line items (no tax breakup; amounts are the website prices) ----
                    const rows = keys.map((key) => {
                        const { product, qty: packs, selectedQty } = cart[key];
                        const qty = selectedQty * packs;
                        return {
                            name: pdfText(product.name) || "-",
                            qty,
                            unit: pdfText(cartUnitLabel(product)),
                            unitRate: product.price,
                            amount: round2(product.price * qty),
                        };
                    });
                    // The total is exactly what the customer pays for the cart.
                    const grandTotal = round2(rows.reduce((s, r) => s + r.amount, 0));
                    const units = new Set(rows.map((r) => r.unit));
                    const totalQty = units.size === 1 ? `${rows.reduce((s, r) => s + r.qty, 0)} ${[...units][0]}` : "";

                    // ---- Footer sizes (needed up front to know where the item table must stop) ----
                    font("bold", 9);
                    const amountWords = doc.splitTextToSize(amountInWords(grandTotal), W - pad * 2);
                    const wordsH = 5 + amountWords.length * 4 + 1.2;
                    const lowerH = 28;
                    const sigH = 16;
                    const totalRowH = 7;
                    const footerH = totalRowH + wordsH + lowerH + sigH;
                    const lastLimit = boxBottom - footerH; // item table ends here on the last page
                    const contRowH = 7;
                    const fullLimit = boxBottom - contRowH; // ... or here on a page that continues

                    const drawTitle = () => {
                        font("bold", 12);
                        doc.text(INVOICE_TITLE, pageW / 2, boxTop - 3.5, { align: "center" });
                        font("italic", 7.5);
                        doc.text("(ORIGINAL FOR RECIPIENT)", R, boxTop - 3.5, { align: "right" });
                    };

                    // ---- Page 1 header: seller / consignee / buyer (left), invoice details grid (right) ----
                    const lh = 3.6;
                    const blockW = midX - L - pad * 2;
                    const sellerLines = [
                        ["bold", 9, INVOICE_SELLER.name.toUpperCase()],
                        ...INVOICE_SELLER.addressLines.map((t) => ["normal", 8, t]),
                        ["normal", 8, `GSTIN/UIN : ${INVOICE_SELLER.gstin}`],
                        ["normal", 8, `State Name : ${INVOICE_SELLER.stateName}, Code : ${INVOICE_SELLER.stateCode}`],
                        ["normal", 8, `Contact : ${INVOICE_SELLER.phones}`],
                        ["normal", 8, `E-Mail : ${INVOICE_SELLER.email}`],
                    ];
                    font("normal", 8);
                    const addressLines = customer.address ? doc.splitTextToSize(customer.address, blockW).slice(0, 3) : [];
                    const partyLines = (title) => [
                        ["normal", 7.5, title],
                        ["bold", 9, (customer.workshop || "Customer").toUpperCase()],
                        ...addressLines.map((t) => ["normal", 8, t]),
                        ...(customer.phone ? [["normal", 8, `Contact : ${customer.phone}`]] : []),
                    ];
                    const blockH = (lines) => 1.2 + lines.length * lh + 1.4;
                    const drawBlock = (lines, top) => {
                        lines.forEach(([style, size, text], i) => {
                            font(style, size);
                            doc.text(fit(text, blockW), L + pad, top + 4 + i * lh);
                        });
                        return top + blockH(lines);
                    };
                    const consigneeLines = partyLines("Consignee (Ship to)");
                    const buyerLines = partyLines("Buyer (Bill to)");

                    const gridRows = [
                        [
                            ["Invoice No.", invoiceNo],
                            ["Dated", invoiceDate],
                        ],
                        [
                            ["Delivery Note", ""],
                            ["Mode/Terms of Payment", ""],
                        ],
                        [
                            ["Reference No. & Date", ""],
                            ["Other References", "Online Cart Enquiry"],
                        ],
                        [
                            ["Buyer's Order No.", ""],
                            ["Dated", ""],
                        ],
                        [
                            ["Preferred Delivery Date", customer.date ? formatDisplayDate(customer.date) : ""],
                            ["Time Slot", customer.slot],
                        ],
                        [
                            ["Dispatched through", ""],
                            ["Destination", ""],
                        ],
                    ];
                    const cellH = 9;
                    const gridH = gridRows.length * cellH;
                    const leftH = blockH(sellerLines) + blockH(consigneeLines) + blockH(buyerLines);
                    const headerH = Math.max(leftH, gridH + 13);

                    drawTitle();
                    let y = drawBlock(sellerLines, boxTop);
                    hLine(L, midX, y);
                    y = drawBlock(consigneeLines, y);
                    hLine(L, midX, y);
                    drawBlock(buyerLines, y);

                    const cellW = gridMid - midX - pad * 2;
                    gridRows.forEach((cells, i) => {
                        const top = boxTop + i * cellH;
                        cells.forEach(([label, value], j) => {
                            const x = (j ? gridMid : midX) + pad;
                            font("normal", 7.5);
                            doc.text(label, x, top + 3.2);
                            font("bold", 8.5);
                            doc.text(fit(value, cellW), x, top + 7.3);
                        });
                        hLine(midX, R, top + cellH);
                    });
                    vLine(gridMid, boxTop, boxTop + gridH);
                    font("normal", 7.5);
                    doc.text("Terms of Delivery", midX + pad, boxTop + gridH + 3.2);
                    font("bold", 8.5);
                    doc.text(
                        doc
                            .splitTextToSize(`Subject to confirmation by ${INVOICE_SELLER.name} on WhatsApp`, R - midX - pad * 2)
                            .slice(0, 2),
                        midX + pad,
                        boxTop + gridH + 7.3
                    );
                    vLine(midX, boxTop, boxTop + headerH);
                    y = boxTop + headerH;
                    hLine(L, R, y);

                    // ---- Item table ----
                    const cols = [10, 104, 24, 20, 10, 22]; // adds up to W
                    const cx = cols.reduce((acc, w, i) => [...acc, acc[i] + w], [L]);
                    const colMid = (i) => (cx[i] + cx[i + 1]) / 2;
                    const heads = [["Sl", "No."], ["Description of Goods"], ["Quantity"], ["Rate"], ["per"], ["Amount"]];
                    let tableTop = y;
                    const drawTableHeader = () => {
                        tableTop = y;
                        font("normal", 7.5);
                        heads.forEach((h, i) => {
                            if (h.length === 1) doc.text(h[0], colMid(i), y + 5, { align: "center" });
                            else {
                                doc.text(h[0], colMid(i), y + 3.4, { align: "center" });
                                doc.text(h[1], colMid(i), y + 6.8, { align: "center" });
                            }
                        });
                        y += 8;
                        hLine(L, R, y);
                        y += 1;
                    };
                    const drawColumnLines = (from, to) => cx.slice(1, -1).forEach((x) => vLine(x, from, to));

                    // Closes the current page with a "continued" row and starts the next one with a slim header.
                    const breakPage = () => {
                        const contY = boxBottom - contRowH;
                        drawColumnLines(tableTop, contY);
                        hLine(L, R, contY);
                        font("italic", 8);
                        doc.text("continued ...", R - pad, contY + 4.6, { align: "right" });
                        doc.rect(L, boxTop, W, boxBottom - boxTop);
                        doc.addPage();
                        drawTitle();
                        font("bold", 9);
                        doc.text(INVOICE_SELLER.name.toUpperCase(), L + pad, boxTop + 5.8);
                        font("normal", 8);
                        doc.text(`Invoice No. ${invoiceNo}    Dated ${invoiceDate}    (continued)`, R - pad, boxTop + 5.8, {
                            align: "right",
                        });
                        y = boxTop + 9;
                        hLine(L, R, y);
                        drawTableHeader();
                    };

                    drawTableHeader();
                    rows.forEach((r, i) => {
                        font("bold", 8.5);
                        const nameLines = doc.splitTextToSize(r.name, cols[1] - pad * 2);
                        const rowH = Math.max(6, nameLines.length * 3.6 + 2.4);
                        if (y + rowH > fullLimit) breakPage();
                        const b = y + 4.2;
                        font("normal", 8.5);
                        doc.text(String(i + 1), colMid(0), b, { align: "center" });
                        doc.text(money(r.unitRate), cx[4] - pad, b, { align: "right" });
                        doc.text(r.unit, colMid(4), b, { align: "center" });
                        font("bold", 8.5);
                        doc.text(nameLines, cx[1] + pad, b);
                        doc.text(`${r.qty} ${r.unit}`, cx[3] - pad, b, { align: "right" });
                        doc.text(money(r.amount), cx[6] - pad, b, { align: "right" });
                        y += rowH;
                    });
                    // The footer needs more room than a continuing page leaves; move it to a new page if needed.
                    if (y > lastLimit) breakPage();

                    // ---- Totals and footer, pinned to the bottom of the last page ----
                    let fy = lastLimit;
                    drawColumnLines(tableTop, fy + totalRowH);
                    hLine(L, R, fy);
                    font("normal", 8.5);
                    doc.text("Total", cx[2] - pad, fy + 4.8, { align: "right" });
                    font("bold", 8.5);
                    doc.text(totalQty, cx[3] - pad, fy + 4.8, { align: "right" });
                    font("bold", 9.5);
                    doc.text(`Rs. ${money(grandTotal)}`, cx[6] - pad, fy + 4.8, { align: "right" });
                    fy += totalRowH;
                    hLine(L, R, fy);

                    font("normal", 7.5);
                    doc.text("Amount Chargeable (in words)", L + pad, fy + 3.5);
                    font("italic", 7.5);
                    doc.text("E. & O.E", R - pad, fy + 3.5, { align: "right" });
                    font("bold", 9);
                    doc.text(amountWords, L + pad, fy + 7.8);
                    fy += wordsH;
                    hLine(L, R, fy);

                    // Company details + declaration (left)
                    const lowTop = fy;
                    [
                        ["Company's GSTIN/UIN", INVOICE_SELLER.gstin],
                        ["Company's PAN", INVOICE_SELLER.pan],
                        ["Udyam Reg. No.", INVOICE_SELLER.udyam],
                    ].forEach(([label, value], i) => {
                        const b = lowTop + 3.8 + i * 3.8;
                        font("normal", 8);
                        doc.text(label, L + pad, b);
                        doc.text(":", L + pad + 31, b);
                        font("bold", 8);
                        doc.text(value, L + pad + 33, b);
                    });
                    font("normal", 7.5);
                    doc.text("Declaration", L + pad, lowTop + 17);
                    doc.text(
                        doc.splitTextToSize(
                            "We declare that this invoice shows the actual price of the goods described and that all particulars are true and correct.",
                            blockW
                        ),
                        L + pad,
                        lowTop + 20.5
                    );

                    fy = lowTop + lowerH;

                    // Signature row
                    hLine(L, R, fy);
                    vLine(midX, fy, fy + sigH);
                    font("normal", 7.5);
                    doc.text("Customer's Seal and Signature", L + pad, fy + 3.5);
                    font("bold", 8.5);
                    doc.text(`for ${INVOICE_SELLER.name.toUpperCase()}`, R - pad, fy + 3.8, { align: "right" });
                    font("normal", 7.5);
                    doc.text("Authorised Signatory", R - pad, fy + sigH - 2, { align: "right" });
                    doc.rect(L, boxTop, W, boxBottom - boxTop);

                    // ---- Below the box on every page ----
                    const pageCount = doc.getNumberOfPages();
                    for (let p = 1; p <= pageCount; p++) {
                        doc.setPage(p);
                        font("normal", 8);
                        doc.text(`SUBJECT TO ${INVOICE_SELLER.jurisdiction.toUpperCase()} JURISDICTION`, pageW / 2, boxBottom + 4.5, {
                            align: "center",
                        });
                        doc.text(`This is a Computer Generated ${INVOICE_TITLE}`, pageW / 2, boxBottom + 8.5, { align: "center" });
                        if (pageCount > 1) {
                            font("normal", 7.5);
                            doc.text(`Page ${p} of ${pageCount}`, R, boxBottom + 8.5, { align: "right" });
                        }
                    }

                    doc.save(`Swapnil-Chemicals-Invoice-${invoiceNo.replace(/\//g, "-")}.pdf`);
                    flyPdfToDownloads(btn);
                } catch (err) {
                    console.error("Cart PDF generation failed:", err);
                    showToast("Couldn't create the PDF. Check your internet connection and try again.", {
                        duration: 4500,
                    });
                } finally {
                    if (btn) {
                        btn.disabled = false;
                        btn.innerHTML = originalHtml;
                    }
                }
