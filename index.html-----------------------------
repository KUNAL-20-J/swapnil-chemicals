            // One passive, rAF-throttled scroll listener for the header shadow, back-to-top button
            // and (only where CSS scroll timelines are unavailable) the progress bar.
            function initScrollEffects() {
                const header = document.querySelector("header.nav-blur");
                const toTop = document.getElementById("scrollToTop");
                const bar = document.getElementById("scrollProgress");
                const barNeedsJs = Boolean(bar) && getComputedStyle(bar).animationName === "none";
                let ticking = false;

                const update = () => {
                    ticking = false;
                    const y = window.scrollY;
                    header?.classList.toggle("scrolled", y > 24);
                    toTop?.classList.toggle("hidden", y <= 300);
                    if (barNeedsJs) {
                        const scrollable = document.documentElement.scrollHeight - window.innerHeight;
                        bar.style.transform = `scaleX(${scrollable > 0 ? Math.min(1, y / scrollable) : 0})`;
                    }
                };
                const requestUpdate = () => {
                    if (ticking) return;
                    ticking = true;
                    requestAnimationFrame(update);
                };

                window.addEventListener("scroll", requestUpdate, { passive: true });
                window.addEventListener("resize", requestUpdate, { passive: true });
                toTop?.addEventListener("click", () =>
                    window.scrollTo({ top: 0, behavior: prefersReducedMotion() ? "auto" : "smooth" })
                );
                update();
            }

            // Keeps --header-h equal to the sticky header's height so anchors aren't hidden under it.
            function initHeaderHeightVar() {
                const header = document.querySelector("header.nav-blur");
                if (!header || !("ResizeObserver" in window)) return;
                new ResizeObserver(([entry]) => {
                    const height = entry.borderBoxSize?.[0]?.blockSize ?? header.offsetHeight;
                    document.documentElement.style.setProperty("--header-h", `${Math.round(height)}px`);
                }).observe(header);
            }

            function initScrollAnimations() {
                const cards = document.querySelectorAll(".product-card, .feature-card");
                const obs = new IntersectionObserver(
                    (e) =>
                        e.forEach((entry) => {
                            if (entry.isIntersecting) {
                                entry.target.style.opacity = "1";
                                entry.target.style.translate = "0 0";
                                obs.unobserve(entry.target);
                            }
                        }),
                    {
                        threshold: 0.1,
                    }
                );
                cards.forEach((c) => {
                    // Animate `translate` (not `transform`) so hover lift/tilt transforms still apply.
                    c.style.opacity = "0";
                    c.style.translate = "0 30px";
                    c.style.transition =
                        "opacity 0.6s ease, translate 0.6s ease, transform 0.35s ease, box-shadow 0.35s ease";
                    obs.observe(c);
                });
            }

            function prefersReducedMotion() {
                return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            }

            function hasFinePointer() {
                return window.matchMedia("(hover: hover) and (pointer: fine)").matches;
            }

            // Infinite decorative animations keep the GPU busy even when off-screen; pause them there.
            function initOffscreenAnimationPause() {
                if (!("IntersectionObserver" in window)) return;
                const targets = document.querySelectorAll(".hero-gradient, .site-footer");
                const obs = new IntersectionObserver((entries) =>
                    entries.forEach((entry) => entry.target.classList.toggle("anim-paused", !entry.isIntersecting))
                );
                targets.forEach((el) => obs.observe(el));
            }

            // Hero "Trade price list": one row per product name (variants collapse to their lowest
            // price), built from the same catalogue as the cards so the two can never disagree.
            function renderTradeList() {
                const list = document.getElementById("tradeList");
                if (!list) return;
                const byName = new Map();
                products.forEach((p) => {
                    const current = byName.get(p.name);
                    if (!current) byName.set(p.name, { product: p, variants: 1 });
                    else {
                        current.variants += 1;
                        if (p.price < current.product.price) current.product = p;
                    }
                });
                list.innerHTML = [...byName.values()]
                    .map(({ product: p, variants }) => {
                        const opts = p.hasLtOptions ? p.qtyOptions || LT_OPTIONS : null;
                        const unit = cartUnitLabel(p);
                        const packs = opts
                            ? `${Math.min(...opts)}–${Math.max(...opts)} ${unit} packs`
                            : "Sold per piece";
                        const per = p.unit === "Lt" ? "per Lt" : "per piece";
                        const from = variants > 1 ? "from " : "";
                        return `<li><button type="button" class="trade-row" data-action="quick-view" data-product-id="${p.id}" aria-label="${escapeHtml(`${p.name}, ${from}${formatCurrency(p.price)} ${per}. Open quick view`)}">
                            <span class="trade-name">${escapeHtml(p.name)}</span>
                            <span class="trade-packs">${escapeHtml(packs)}${variants > 1 ? ` · ${variants} variants` : ""}</span>
                            <span class="trade-price">${from ? '<small class="trade-from">from</small>' : ""}${escapeHtml(formatCurrency(p.price))}<small>${per}</small></span>
                        </button></li>`;
                    })
                    .join("");
            }

            const RIPPLE_SELECTOR =
                ".btn-shine, .add-to-cart-btn, .enquiry-trigger-btn, .enquiry-submit-btn, .added-cart-viewcart-btn";

            function initRipples() {
                if (prefersReducedMotion()) return;
                document.addEventListener("pointerdown", (e) => {
                    const btn = e.target.closest(RIPPLE_SELECTOR);
                    if (!btn) return;
                    const rect = btn.getBoundingClientRect();
                    const size = Math.max(rect.width, rect.height) * 2;
                    const ripple = document.createElement("span");
                    ripple.className = "ripple";
                    ripple.setAttribute("aria-hidden", "true");
                    ripple.style.cssText = `width:${size}px;height:${size}px;left:${e.clientX - rect.left - size / 2}px;top:${e.clientY - rect.top - size / 2}px`;
                    btn.appendChild(ripple);
                    setTimeout(() => ripple.remove(), 700);
                });
            }

