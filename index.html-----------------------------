            function readCustomerFields(p) {
                const phoneEl = document.getElementById(`${p}-phone`);
                const workshopEl = document.getElementById(`${p}-workshop`);
                const dateEl = document.getElementById(`${p}-date`);
                const slotEl = document.getElementById(`${p}-slot`);
                if (!phoneEl || !workshopEl || !dateEl || !slotEl) return null;

                const phone = phoneEl.value.trim();
                if (!isValidIndianMobile(phone)) {
                    showFieldError(document.getElementById(`${p}-phone-error`), phoneEl);
                    return null;
                }

                const date = dateEl.value;
                if (!date || date < dateEl.min || date > dateEl.max) {
                    showFieldError(document.getElementById(`${p}-date-error`), dateEl);
                    return null;
                }

                const slot = slotEl.value;
                if (!slot || !availableSlots(date).some((s) => s.label === slot)) {
                    // The chosen slot may have passed while the form was open - refresh the list.
                    dateEl.dispatchEvent(new Event("change"));
                    showFieldError(document.getElementById(`${p}-slot-error`), slotEl);
                    return null;
                }

                const workshop = workshopEl.value.trim();
                saveCustomer(phone, workshop);
                return {
                    workshop,
                    phone,
                    registered: workshopEl.dataset.source === "khatabook",
