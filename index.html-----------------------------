                }
                .cmdk-trigger:hover {
                    border-color: var(--brand-200);
                    color: var(--brand-600);
                }
                .cmdk-trigger kbd,
                .cmdk-foot kbd {
                    white-space: nowrap;
                    font: 600 11px/1 var(--font-sans);
                    padding: 5px 7px;
                    border-radius: 7px;
                    background: var(--surface-2);
                    border: 1px solid var(--border);
