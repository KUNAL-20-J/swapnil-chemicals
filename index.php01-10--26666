        <script type="application/json" id="appData"><?= json_for_script($appData) ?></script>

        <script type="module" nonce="<?= e($nonce) ?>">
            // ============================== Data & config ==============================
            const { config: CONFIG, products: CATALOG } = JSON.parse(document.getElementById("appData").textContent);
            const PRODUCTS = new Map(CATALOG.map((p) => [p.id, p]));

            const APP = Object.freeze({
                CART_KEY: "sc_cart_auto",
                // This device's last-used WhatsApp number & workshop, so the next enquiry fills itself in.
                CUSTOMER_KEY: "sc_customer",
                COUNTRY_CODE: "+91",
                LOOKUP_URL: `${location.pathname}?action=workshop-lookup`,
                LOOKUP_TIMEOUT_MS: 8000,
                MAX_PACKS: 999,
                BOOKING_DAYS_AHEAD: 30,
                // A slot can be booked for today only until its start hour.
                TIME_SLOTS: Object.freeze([
                    { startHour: 10, label: "10:00 AM – 12:00 PM" },
                    { startHour: 12, label: "12:00 PM – 2:00 PM" },
                    { startHour: 14, label: "2:00 PM – 4:00 PM" },
                ]),
            });

            // ============================== Helpers ==============================
            const $ = (selector, root = document) => root.querySelector(selector);
            const $$ = (selector, root = document) => [...root.querySelectorAll(selector)];

            const prefersReducedMotion = () => matchMedia("(prefers-reduced-motion: reduce)").matches;
            const hasFinePointer = () => matchMedia("(hover: hover) and (pointer: fine)").matches;
            const isValidIndianMobile = (value) => /^[6-9]\d{9}$/.test(String(value ?? "").trim());
            const plural = (n, word) => `${n} ${word}${n === 1 ? "" : "s"}`;

            const currencyFormatter = new Intl.NumberFormat("en-IN", {
                style: "currency",
                currency: "INR",
                maximumFractionDigits: 0,
            });
            const formatCurrency = (amount) => currencyFormatter.format(amount);

            // "5 Lt", "10 pcs", "1 piece"
            function formatQty(qty, label) {
                if (label === "pcs") return qty === 1 ? "1 piece" : `${qty} pcs`;
                return `${qty} ${label}`;
            }

            const unitLabel = (product) => (product.qtyLabel === "pcs" ? "pc" : product.qtyLabel);

            const HTML_ESCAPES = { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" };
            const escapeHtml = (value) => String(value ?? "").replace(/[&<>"']/g, (c) => HTML_ESCAPES[c]);

            function debounce(fn, delay) {
                let timeoutId;
                return (...args) => {
                    clearTimeout(timeoutId);
                    timeoutId = setTimeout(() => fn(...args), delay);
                };
            }

            // localStorage can throw (private mode, blocked storage) - the page must work without it.
            const storage = {
                read(key, fallback) {
                    try {
                        const raw = localStorage.getItem(key);
                        return raw ? (JSON.parse(raw) ?? fallback) : fallback;
                    } catch {
                        return fallback;
                    }
                },
                write(key, value) {
                    try {
                        localStorage.setItem(key, JSON.stringify(value));
                    } catch {
                        // Storage unavailable - state just won't persist across visits.
                    }
                },
                remove(key) {
                    try {
                        localStorage.removeItem(key);
                    } catch {
                        // Ignore - nothing to clean up.
                    }
                },
            };

            const openInNewTab = (url) => window.open(url, "_blank", "noopener,noreferrer");
            const whatsappUrl = (message) => `https://wa.me/${CONFIG.waNumber}?text=${encodeURIComponent(message)}`;

            function bump(el) {
                if (!el || prefersReducedMotion()) return;
                el.animate([{ scale: 1 }, { scale: 1.4, offset: 0.4 }, { scale: 1 }], {
                    duration: 350,
                    easing: "cubic-bezier(0.34, 1.56, 0.64, 1)",
                });
            }

            async function copyText(text, btn) {
                try {
                    await navigator.clipboard.writeText(text);
                    const original = [...btn.childNodes].map((n) => n.cloneNode(true));
                    const label = btn.getAttribute("aria-label");
                    const check = document.createElement("i");
                    check.className = "fa-solid fa-check";
                    check.setAttribute("aria-hidden", "true");
                    btn.replaceChildren(check);
                    btn.setAttribute("aria-label", "Copied");
                    btn.disabled = true;
                    setTimeout(() => {
                        btn.replaceChildren(...original);
                        btn.setAttribute("aria-label", label ?? "");
                        btn.disabled = false;
                    }, 1400);
                } catch {
                    // Clipboard API needs HTTPS + permission.
                    btn.title = "Copy failed — please select the text manually";
                }
            }

            // ============================== UPI ==============================
            // Tapping the QR hands the upi:// link to the phone, which opens Google Pay / PhonePe /
            // whichever UPI app is installed. Desktops have no UPI app, so there we ask them to scan.
            // The amount ("am") is only added when a merchant code is configured (see PHP config):
            // Google Pay / NPCI decline a pre-filled-amount P2P link after the PIN is entered.
            // The page can only open the app; the payment result is decided by the bank / UPI app.
            const UPI_PREFILL_AMOUNT = /^\d{4}$/.test(CONFIG.upiMerchantCode);

            // Unique per link, so the UPI app / bank does not treat a repeat as a duplicate.
            const upiTxnRef = () =>
                `SC${Date.now().toString(36).toUpperCase()}${crypto.getRandomValues(new Uint16Array(1))[0]}`;

            // "pa" is left unencoded on purpose: some UPI apps reject "%40" in the VPA.
            function buildUpiUrl(amount, note) {
                const params = [`pa=${CONFIG.upiId}`, `pn=${encodeURIComponent(CONFIG.brand)}`];
                const amt = Number(amount);
                if (UPI_PREFILL_AMOUNT && Number.isFinite(amt) && amt > 0) {
                    params.push(`mc=${CONFIG.upiMerchantCode}`, `tr=${upiTxnRef()}`, `am=${amt.toFixed(2)}`);
                    if (note) params.push(`tn=${encodeURIComponent(String(note).slice(0, 50))}`);
                }
                params.push("cu=INR");
                return `upi://pay?${params.join("&")}`;
            }

            const upiQrSrc = (upiUrl) =>
                `https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=${encodeURIComponent(upiUrl)}`;

            function upiHintText(amount) {
                const amt = formatCurrency(amount);
                return UPI_PREFILL_AMOUNT
                    ? `📷 Scan or tap the QR to pay ${amt} (amount auto-filled) via Google Pay / PhonePe / any UPI app`
                    : `📷 Scan or tap the QR, then enter ${amt} in Google Pay / PhonePe / any UPI app`;
            }

            function updateUpiCard(card, amount, note) {
                if (!card) return;
                const url = buildUpiUrl(amount, note);
                const link = $("[data-upi-link]", card);
                const qr = $("[data-upi-qr]", card);
                const hint = $("[data-upi-hint]", card);
                if (link) link.href = url;
                if (qr) {
                    const src = upiQrSrc(url);
                    if (qr.src !== src) qr.src = src;
                }
                if (hint) hint.textContent = upiHintText(amount);
            }

            function openUpiApp(event, link) {
                const hint = $("[data-upi-hint]", link.closest("[data-upi]") ?? document);
                const isMobile = navigator.userAgentData?.mobile ?? /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
                if (!isMobile) {
                    event.preventDefault();
                    if (hint) hint.textContent = "📱 Please scan this QR with Google Pay / PhonePe on your phone.";
                    return;
                }
                // If no UPI app picks up the link, the page stays visible — tell the customer.
                // If it did open, the browser gets no payment status back, so ask for the screenshot / UTR.
                let appOpened = false;
                const onVisibility = () => {
                    if (document.hidden) {
                        appOpened = true;
                        return;
                    }
                    if (!appOpened) return;
                    document.removeEventListener("visibilitychange", onVisibility);
                    if (hint) {
                        hint.textContent =
                            `✅ Paid? Please send the payment screenshot / UTR with your WhatsApp enquiry. ` +
                            `❌ Failed or "not debited"? Try another bank account, or pay to UPI ID ${CONFIG.upiAltId}.`;
                    }
                };
                document.addEventListener("visibilitychange", onVisibility);
                setTimeout(() => {
                    if (appOpened) return;
                    document.removeEventListener("visibilitychange", onVisibility);
                    if (hint) hint.textContent = `No UPI app opened? Install Google Pay / PhonePe, or pay to UPI ID ${CONFIG.upiId}.`;
                }, 2500);
            }

            // ============================== Cart state ==============================
            // key "<productId>_<packSize>" -> { productId, selectedQty (pack size), qty (number of packs) }
            const cart = new Map();
            const cartKey = (productId, selectedQty) => `${productId}_${selectedQty}`;

            // Rebuild saved items against the live catalogue, so stale or edited storage
            // can't inject markup, outdated prices or pack sizes we no longer sell.
            function loadCart() {
                const saved = storage.read(APP.CART_KEY, {});
                if (!saved || typeof saved !== "object") return;
                for (const item of Object.values(saved)) {
                    // Accepts the old format ({ product: {...} }) as well as the current one.
                    const productId = Number(item?.productId ?? item?.product?.id);
                    const product = PRODUCTS.get(productId);
                    const qty = Math.floor(Number(item?.qty));
                    const selectedQty = Math.floor(Number(item?.selectedQty));
                    if (!product || !(qty >= 1) || !(selectedQty >= 1)) continue;
                    const validPack = product.qtyOptions.length ? product.qtyOptions.includes(selectedQty) : selectedQty === 1;
                    if (!validPack) continue;
                    const key = cartKey(productId, selectedQty);
                    const packs = Math.min((cart.get(key)?.qty ?? 0) + qty, APP.MAX_PACKS);
                    cart.set(key, { productId, selectedQty, qty: packs });
                }
            }

            const saveCart = () => storage.write(APP.CART_KEY, Object.fromEntries(cart));

            function cartSummary() {
                const lines = [...cart].map(([key, item]) => {
                    const product = PRODUCTS.get(item.productId);
                    const totalQty = item.selectedQty * item.qty;
                    return { key, product, ...item, totalQty, lineTotal: product.price * totalQty };
                });
                return {
                    lines,
                    packs: lines.reduce((sum, line) => sum + line.qty, 0),
                    total: lines.reduce((sum, line) => sum + line.lineTotal, 0),
                };
            }

            function setPacks(key, packs) {
                const item = cart.get(key);
                if (!item || packs < 1 || packs > APP.MAX_PACKS) return false;
                item.qty = packs;
                saveCart();
                renderCart();
                return true;
            }

            // ============================== Cart UI ==============================
            const cartPanel = $("#cartPanel");
            const cartRowTemplate = $("#cartRowTemplate");

            function createCartRow(line) {
                const row = cartRowTemplate.content.firstElementChild.cloneNode(true);
                row.dataset.key = line.key;
                const img = $(".cart-row__img", row);
                img.src = line.product.image;
                const name = $(".cart-row__name", row);
                name.textContent = line.product.name;
                name.title = line.product.name;
                $('[data-delta="-1"]', row).setAttribute("aria-label", `Decrease ${line.product.name}`);
                $('[data-delta="1"]', row).setAttribute("aria-label", `Increase ${line.product.name}`);
                $(".cart-row__remove", row).setAttribute("aria-label", `Remove ${line.product.name} from cart`);
                return row;
            }

            function updateCartRow(row, line) {
                const unit = line.product.qtyLabel;
                $(".cart-row__meta", row).textContent = `${formatQty(line.totalQty, unit)} • ${formatCurrency(line.lineTotal)}`;
                $("output", row).textContent = String(line.qty);
                $('[data-delta="-1"]', row).disabled = line.qty <= 1;
            }

            // Keyed update: existing rows stay in place, so focus on a +/− button isn't lost.
            function renderCartRows(lines) {
                const list = $("#cartItems");
                const existing = new Map([...list.children].map((row) => [row.dataset.key, row]));
                lines.forEach((line, index) => {
                    const row = existing.get(line.key) ?? createCartRow(line);
                    existing.delete(line.key);
                    updateCartRow(row, line);
                    if (list.children[index] !== row) list.insertBefore(row, list.children[index] ?? null);
                });
                existing.forEach((row) => row.remove());
            }

            function renderCart() {
                const { lines, packs, total } = cartSummary();

                const badge = $("#cartBadge");
                badge.hidden = packs === 0;
                if (badge.textContent !== String(packs)) {
                    badge.textContent = String(packs);
                    if (packs) bump(badge);
                }
                $("#cartButton").setAttribute("aria-label", packs ? `Open cart, ${plural(packs, "item")}` : "Open cart");

                $("#cartEmpty").hidden = packs > 0;
                $("#cartFooter").hidden = packs === 0;
                renderCartRows(lines);
                if (!packs) return;

                const totalEl = $("#cartTotal");
                const formatted = formatCurrency(total);
                if (totalEl.textContent !== formatted) {
                    totalEl.textContent = formatted;
                    bump(totalEl);
                }
                $("#cartSendLabel").textContent = `Send Enquiry • ${formatted}`;
                updateUpiCard($("#cartUpi"), Math.round(total), `${CONFIG.brand} order ${plural(packs, "item")}`);
            }

            function showCart() {
                if (!cartPanel.matches(":popover-open")) cartPanel.showPopover();
            }

            function clearCart() {
                cart.clear();
                storage.remove(APP.CART_KEY);
                renderCart();
                cartPanel.hidePopover();
            }

            // ============================== Add to cart ==============================
            async function flyToCart(sourceImg) {
                const cartBtn = $("#cartButton");
                if (!sourceImg || !cartBtn || prefersReducedMotion()) return;
                const from = sourceImg.getBoundingClientRect();
                const to = cartBtn.getBoundingClientRect();
                if (!from.width || !from.height) return;

                const flyer = sourceImg.cloneNode(false);
                flyer.removeAttribute("loading");
                flyer.className = "fly-to-cart";
                flyer.alt = "";
                Object.assign(flyer.style, {
                    left: `${from.left}px`,
                    top: `${from.top}px`,
                    width: `${from.width}px`,
                    height: `${from.height}px`,
                });
                document.body.append(flyer);

                const dx = to.left + to.width / 2 - (from.left + from.width / 2);
                const dy = to.top + to.height / 2 - (from.top + from.height / 2);
                try {
                    await flyer.animate(
                        [
                            { transform: "translate(0, 0) scale(1)", opacity: 1 },
                            { transform: `translate(${dx}px, ${dy}px) scale(0.12)`, opacity: 0.3 },
                        ],
                        { duration: 550, easing: "cubic-bezier(0.34, 0, 0.64, 1)" }
                    ).finished;
                } catch {
                    // Animation cancelled - nothing to do.
                } finally {
                    flyer.remove();
                }
            }

            async function addToCart(productId, button) {
                const product = PRODUCTS.get(productId);
                if (!product || button?.dataset.busy) return;
                const card = button?.closest(".product-card");
                const selectedQty = (card && Number($('input[type="radio"]:checked', card)?.value)) || 1;
                const key = cartKey(productId, selectedQty);

                if (button) button.dataset.busy = "true";
                try {
                    const media = card && $(".product-card__media.is-loaded", card);
                    await flyToCart(media && $(".product-card__img", media));
                } finally {
                    if (button) delete button.dataset.busy;
                }

                const item = cart.get(key);
                if (item) item.qty = Math.min(item.qty + 1, APP.MAX_PACKS);
                else cart.set(key, { productId, selectedQty, qty: 1 });
                saveCart();
                renderCart();
                openAddedDialog(key);
            }

