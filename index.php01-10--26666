// ---------- Khatabook workshop lookup ----------
if (($_GET['action'] ?? '') === 'workshop-lookup') {
    header('Content-Type: application/json; charset=utf-8');
    header('Cache-Control: no-store');
    header('X-Content-Type-Options: nosniff');

    // POST keeps customer phone numbers out of URLs, access logs and caches.
    if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') {
        http_response_code(405);
        header('Allow: POST');
        echo '{"results":[]}';
        exit;
    }

    $input = json_decode((string) file_get_contents('php://input', false, null, 0, 1024), true);
    $raw = is_array($input) && is_scalar($input['phone'] ?? null) ? (string) $input['phone'] : '';
    $phone = substr(preg_replace('/\D/', '', $raw) ?? '', -10);

    $results = [];
    if (preg_match('/^[6-9]\d{9}$/', $phone) === 1) {
        foreach (KHATABOOK_CUSTOMERS as [$name, $number]) {
            if ($number === $phone) {
                $results[] = ['name' => $name];
            }
        }
    }
    echo json_encode(['results' => $results], JSON_UNESCAPED_UNICODE);
    exit;
}

