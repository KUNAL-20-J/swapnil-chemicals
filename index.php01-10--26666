            // ============================== Booking date & time slot ==============================
            function toLocalISODate(date) {
                const pad = (n) => String(n).padStart(2, "0");
                return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
            }

            const formatDisplayDate = (isoDate) =>
                new Date(`${isoDate}T00:00:00`).toLocaleDateString("en-IN", {
                    weekday: "short",
                    day: "numeric",
                    month: "short",
                    year: "numeric",
                });

            function availableSlots(isoDate) {
                const now = new Date();
                if (isoDate !== toLocalISODate(now)) return APP.TIME_SLOTS;
                return APP.TIME_SLOTS.filter((slot) => slot.startHour > now.getHours());
            }

            function bookingDateRange() {
                const first = new Date();
                if (!availableSlots(toLocalISODate(first)).length) first.setDate(first.getDate() + 1);
                const last = new Date(first);
                last.setDate(last.getDate() + APP.BOOKING_DAYS_AHEAD);
                return { min: toLocalISODate(first), max: toLocalISODate(last) };
            }

            // ============================== Customer fields (Khatabook lookup) ==============================
            const fields = {
                phone: $("#enquiryPhone"),
                phoneError: $("#enquiryPhoneError"),
                hint: $("#enquiryPhoneHint"),
                workshop: $("#enquiryWorkshop"),
                choice: $("#enquiryWorkshopChoice"),
                edit: $("#enquiryWorkshopEdit"),
                date: $("#enquiryDate"),
                dateError: $("#enquiryDateError"),
                slot: $("#enquirySlot"),
                slotError: $("#enquirySlotError"),
                details: $("#enquiryDetails"),
            };
            const DEFAULT_HINT = fields.hint.textContent;
            let lookupController = null;

            const phoneDigits = () => fields.phone.value.replace(/\D/g, "").slice(0, 10);

            function loadSavedCustomer() {
                const saved = storage.read(APP.CUSTOMER_KEY, {});
                return {
                    phone: isValidIndianMobile(saved?.phone) ? String(saved.phone) : "",
                    workshop: typeof saved?.workshop === "string" ? saved.workshop.slice(0, 120) : "",
                };
