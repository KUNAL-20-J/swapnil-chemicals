            // Resolves to workshop names, [] for an unknown number, or null when the lookup is
            // unavailable (offline, timeout, or no PHP backend). Throws only when superseded.
            async function fetchWorkshops(phone, signal) {
                try {
                    const res = await fetch(APP.LOOKUP_URL, {
                        method: "POST",
                        headers: { "Content-Type": "application/json", Accept: "application/json" },
                        body: JSON.stringify({ phone }),
                        credentials: "same-origin",
                        signal: AbortSignal.any([signal, AbortSignal.timeout(APP.LOOKUP_TIMEOUT_MS)]),
                    });
                    if (!res.ok) return null;
                    const data = await res.json();
                    if (!Array.isArray(data?.results)) return null;
                    return data.results.map((r) => String(r?.name ?? "").trim()).filter(Boolean);
                } catch (err) {
                    if (signal.aborted) throw err;
                    return null;
                }
            }

            async function lookupWorkshop(digits) {
                lookupController?.abort();
                const controller = (lookupController = new AbortController());
                fields.hint.textContent = "Checking our customer records…";

                let names;
                try {
                    names = await fetchWorkshops(digits, controller.signal);
                } catch {
                    return; // A newer lookup replaced this one.
                }
                if (controller !== lookupController || phoneDigits() !== digits) return;

                hideWorkshopChoices();
                if (names === null) {
                    fields.hint.textContent = "Couldn't check our customer records right now - please type your workshop name below.";
                    return;
                }
                if (!names.length) {
                    if (fields.workshop.dataset.source === "khatabook") setWorkshop("", false);
                    fields.hint.textContent = "This number isn't in our records - please type your workshop name below.";
                    return;
                }
                setWorkshop(names[0], true);
                if (names.length > 1) {
                    fields.choice.replaceChildren(...names.map((name) => new Option(name, name)));
                    fields.choice.hidden = false;
                    fields.hint.textContent = "This number has more than one workshop with us - pick yours below.";
                } else {
                    fields.hint.textContent = "Workshop name filled in from our customer records.";
                }
            }

            function fillSlots() {
                const previous = fields.slot.value;
                const slots = availableSlots(fields.date.value);
                fields.slot.replaceChildren(
                    new Option(slots.length ? "Select a slot" : "No slots left", ""),
                    ...slots.map((slot) => new Option(slot.label, slot.label))
                );
                if (slots.some((slot) => slot.label === previous)) fields.slot.value = previous;
            }

            function showFieldError(errorEl, inputEl) {
                errorEl.hidden = false;
                if (!prefersReducedMotion()) {
                    errorEl.animate([{ translate: "-4px 0" }, { translate: "4px 0" }, { translate: "0 0" }], {
                        duration: 240,
                        iterations: 2,
                    });
                }
                inputEl.focus();
            }

            function initCustomerFields() {
                fields.phone.addEventListener("input", () => {
                    const digits = phoneDigits();
                    if (digits !== fields.phone.value) fields.phone.value = digits;
                    if (isValidIndianMobile(digits)) {
                        fields.phoneError.hidden = true;
                        lookupWorkshop(digits);
                        return;
                    }
                    lookupController?.abort();
                    lookupController = null;
                    hideWorkshopChoices();
                    if (fields.workshop.dataset.source === "khatabook") setWorkshop("", false);
                    fields.hint.textContent = DEFAULT_HINT;
                });

                fields.choice.addEventListener("change", () => (fields.workshop.value = fields.choice.value));

                fields.edit.addEventListener("click", () => {
                    hideWorkshopChoices();
                    setWorkshop(fields.workshop.value, false);
                    fields.hint.textContent = "You can now edit the workshop name.";
                    fields.workshop.focus();
                });

                fields.date.addEventListener("change", () => {
                    fillSlots();
                    fields.dateError.hidden = true;
                });
                fields.slot.addEventListener("change", () => (fields.slotError.hidden = true));
            }

            // Called every time the dialog opens: dates and slots move with the clock.
            function prepareCustomerFields() {
                for (const el of [fields.phoneError, fields.dateError, fields.slotError]) el.hidden = true;
                fields.details.value = "";

                const { min, max } = bookingDateRange();
                fields.date.min = min;
                fields.date.max = max;
                if (!fields.date.value || fields.date.value < min || fields.date.value > max) fields.date.value = min;
                fields.dateError.textContent = `Pick a date from ${formatDisplayDate(min)} to ${formatDisplayDate(max)}`;
                fillSlots();

                // Returning customer on this device: fill in straight away, then re-check
                // the number against the latest Khatabook list.
                if (!fields.phone.value) {
                    const saved = loadSavedCustomer();
                    if (saved.phone) {
                        fields.phone.value = saved.phone;
                        setWorkshop(saved.workshop, false);
                        lookupWorkshop(saved.phone);
                    }
                }
            }

            function readCustomerFields() {
                const phone = fields.phone.value.trim();
                if (!isValidIndianMobile(phone)) {
                    showFieldError(fields.phoneError, fields.phone);
                    return null;
                }

                const date = fields.date.value;
                if (!date || date < fields.date.min || date > fields.date.max) {
                    showFieldError(fields.dateError, fields.date);
                    return null;
                }

                const slot = fields.slot.value;
                if (!slot || !availableSlots(date).some((s) => s.label === slot)) {
                    // The chosen slot may have passed while the form was open - refresh the list.
                    fillSlots();
                    showFieldError(fields.slotError, fields.slot);
                    return null;
                }

                const workshop = fields.workshop.value.trim();
                storage.write(APP.CUSTOMER_KEY, { phone, workshop });
                return { phone, workshop, registered: fields.workshop.dataset.source === "khatabook", date, slot };
            }

