            function setWorkshop(name, fromRecords) {
                fields.workshop.value = name;
                fields.workshop.readOnly = fromRecords;
                fields.workshop.dataset.source = fromRecords ? "khatabook" : "";
                fields.edit.hidden = !fromRecords;
