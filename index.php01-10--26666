            // ============================== Product search ==============================
            const SEARCH_SYNONYMS = {
                cloth: "towel",
                rag: "towel",
                wiper: "towel",
                shine: "polish",
                shiner: "polish",
                spray: "gun",
                sprayer: "gun",
                cleaning: "wash",
                clean: "wash",
                shampoo: "wash",
            };

            function levenshteinDistance(a, b) {
                if (a === b) return 0;
                if (!a.length) return b.length;
                if (!b.length) return a.length;
                let prevRow = Array.from({ length: b.length + 1 }, (_, i) => i);
                for (let i = 1; i <= a.length; i++) {
                    let prevDiag = prevRow[0];
                    prevRow[0] = i;
                    for (let j = 1; j <= b.length; j++) {
                        const temp = prevRow[j];
                        prevRow[j] = Math.min(prevRow[j] + 1, prevRow[j - 1] + 1, prevDiag + (a[i - 1] === b[j - 1] ? 0 : 1));
                        prevDiag = temp;
                    }
                }
                return prevRow[b.length];
            }

            function fuzzyWordsMatch(a, b) {
                if (a === b || a.includes(b) || b.includes(a)) return true;
                const maxDistance = Math.min(a.length, b.length) > 5 ? 2 : 1;
                return levenshteinDistance(a, b) <= maxDistance;
            }

            function scoreProduct(product, queryWords) {
                const haystack = `${product.name} ${product.description}`.toLowerCase();
                const haystackWords = haystack.split(/\s+/);
                let score = 0;
                for (const word of queryWords) {
                    const variants = SEARCH_SYNONYMS[word] ? [word, SEARCH_SYNONYMS[word]] : [word];
                    for (const variant of variants) {
                        if (haystack.includes(variant)) score += 3;
                        else if (haystackWords.some((hw) => fuzzyWordsMatch(hw, variant))) score += 1;
                    }
                }
                return score;
            }

            // Cards are server-rendered; search just ranks, reorders and hides them.
            function initProductSearch() {
                const input = $("#productSearch");
                const grid = $("#productsGrid");
                const cards = $$(".product-card", grid);
                const status = $("#productsStatus");
                const empty = $("#productsEmpty");

                const run = () => {
                    const raw = input.value.trim();
                    const query = raw.toLowerCase();
                    if (!query) {
                        grid.append(...cards);
                        cards.forEach((card) => (card.hidden = false));
                        empty.hidden = true;
                        status.textContent = "";
                        return;
                    }
                    const words = query.split(/\s+/).filter(Boolean);
                    const ranked = cards
                        .map((card) => ({ card, score: scoreProduct(PRODUCTS.get(Number(card.dataset.productId)), words) }))
                        .sort((a, b) => b.score - a.score);
                    grid.append(...ranked.map((entry) => entry.card));
                    ranked.forEach(({ card, score }) => (card.hidden = score === 0));

                    const matches = ranked.filter((entry) => entry.score > 0).length;
                    empty.hidden = matches > 0;
                    $("#productsEmptyQuery").textContent = raw;
                    status.textContent = matches ? `${plural(matches, "product")} found` : "No products found";
                };

                input.addEventListener("input", debounce(run, 150));
            }

            function initProductImages() {
                for (const img of $$(".product-card__img")) {
                    const media = img.closest(".product-card__media");
                    const loaded = () => media.classList.add("is-loaded");
                    const broken = () => media.classList.add("is-broken");
                    if (img.complete) {
                        (img.naturalWidth ? loaded : broken)();
                    } else {
                        img.addEventListener("load", loaded, { once: true });
                        img.addEventListener("error", broken, { once: true });
                    }
                }
            }

            // ============================== Voice input ==============================
            const SpeechRecognitionCtor = window.SpeechRecognition ?? window.webkitSpeechRecognition;

            function attachVoiceInput(button, input, { idleLabel, onTranscript } = {}) {
                if (!button || !input || !SpeechRecognitionCtor) return;
                button.hidden = false;
                let listening = false;

                button.addEventListener("click", () => {
                    if (listening) return;
                    const recognizer = new SpeechRecognitionCtor();
                    recognizer.lang = "en-IN";
                    recognizer.interimResults = false;
                    recognizer.maxAlternatives = 1;

                    recognizer.addEventListener("result", (event) => {
                        const transcript = event.results[0][0].transcript;
                        input.value = transcript;
                        input.dispatchEvent(new Event("input", { bubbles: true }));
                        onTranscript?.(transcript);
                    });
                    // Microphone denied or nothing heard - fail quietly, the input stays editable by hand.
                    recognizer.addEventListener("end", () => {
                        listening = false;
                        button.classList.remove("is-listening");
                        button.setAttribute("aria-label", idleLabel);
                    });

                    try {
                        recognizer.start();
                        listening = true;
                        button.classList.add("is-listening");
                        button.setAttribute("aria-label", "Listening…");
                    } catch {
                        listening = false;
                    }
                });
            }

            // ============================== Assistant ==============================
            const assistantPanel = $("#assistantPanel");
            const assistantMessages = $("#assistantMessages");
            let assistantStarted = false;

            function appendAssistantMessage(role, html) {
                const message = document.createElement("div");
                message.className = `assistant-msg assistant-msg--${role}`;
                message.innerHTML = html;
                assistantMessages.append(message);
                assistantMessages.scrollTop = assistantMessages.scrollHeight;
            }

            const uniqueProducts = () => [...new Map(CATALOG.map((p) => [`${p.name}|${p.price}|${p.unit}`, p])).values()];
            const productLine = (p) => `<b>${escapeHtml(p.name)}</b> — ${formatCurrency(p.price)} / ${escapeHtml(p.unit)}`;
            const telLink = (phone) => `<a href="tel:+91${phone}">${phone}</a>`;

            function buildAssistantReply(rawText) {
                const text = rawText.toLowerCase().trim();
                const [phone1, phone2] = CONFIG.phones;
                const emailLink = `<a href="mailto:${CONFIG.email}">${CONFIG.email}</a>`;

                if (/\b(hi|hello|hey|namaste)\b/.test(text)) {
                    return "Hello! How can I help you today? You can ask about our products, prices, bulk orders, payment or contact details.";
                }
                if (/\b(bye|thanks|thank you|thank)\b/.test(text)) {
                    return "You're welcome! Feel free to reach out anytime. 🙏";
                }
                if (/\b(product|catalog|range|items?)\b/.test(text) || /what.*(sell|make|manufacture)/.test(text)) {
                    const lines = uniqueProducts().map(productLine).join("<br>");
                    return `Here's our product range:<br><br>${lines}<br><br>Tap "Add to Cart" or "Enquiry" on any product card above for quantity options.`;
                }
                if (/\b(price|cost|rate|rates|pricing|how much)\b/.test(text)) {
                    const matches = CATALOG.filter((p) => text.includes(p.name.toLowerCase()));
                    if (matches.length) {
                        const suffix =
                            matches.length > 1
                                ? 'Let us know which variant you need, or ask about "bulk orders" for larger quantities.'
                                : 'Larger quantities are available for bulk orders — ask me about "bulk orders" for details.';
                        return `${matches.map(productLine).join("<br>")}<br><br>${suffix}`;
                    }
                    return `Here are our current prices:<br><br>${uniqueProducts().map(productLine).join("<br>")}`;
                }
                if (/\b(bulk|wholesale|distributor|discount|large quantity|retail)\b/.test(text)) {
                    return `We supply both bulk and retail quantities. For bulk/wholesale pricing, please call us at ${telLink(phone1)} or ${telLink(phone2)}, or use the "Enquiry" button on a product to send your requirement on WhatsApp.`;
                }
                if (/\b(contact|phone|number|call|reach|mobile)\b/.test(text)) {
                    return `You can reach ${escapeHtml(CONFIG.brand)} at:<br>📞 ${telLink(phone1)}<br>📞 ${telLink(phone2)}<br>✉️ ${emailLink}`;
                }
                if (/\b(email|mail)\b/.test(text)) {
                    return `Our email is ${emailLink}`;
                }
                if (/\b(where|location|address|based|jaipur|city)\b/.test(text)) {
                    return "We're based in Jaipur, Rajasthan, and supply both bulk and retail orders.";
                }
                if (/\b(gst|msme|udyam|brn|registration|license|legal|certificate)\b/.test(text)) {
                    return `${escapeHtml(CONFIG.brand)} is a registered business:<br>GST: <b>08CIJPS1734A1ZE</b><br>MSME: <b>MSME/2020/6194</b><br>Udyam: <b>UDYAM-RJ-17-0022468</b><br>BRN: <b>8005220072000968</b>`;
                }
                if (/\b(pay|payment|upi|gpay|google pay)\b/.test(text)) {
                    return `You can pay via Google Pay / UPI to <b>${phone1}</b>, or scan the QR code in the Contact section. Call us to discuss other payment arrangements.`;
                }
                if (/\b(order|buy|purchase)\b/.test(text)) {
                    return 'To order: pick a product above, choose a quantity, and tap "Add to Cart" (then scan the UPI QR and send your enquiry from the cart), or tap "Enquiry" to send your requirement directly to us on WhatsApp.';
                }
                return null;
            }

            function handleAssistantQuery(rawText) {
                const question = String(rawText ?? "").trim();
                if (!question) return;
                appendAssistantMessage("user", escapeHtml(question));
                const reply = buildAssistantReply(question);
                if (reply) {
                    appendAssistantMessage("bot", reply);
                    return;
                }
                appendAssistantMessage(
                    "bot",
                    "I can help with product info, pricing, bulk orders, payment and contact details. For anything else, let's connect you with our team directly on WhatsApp."
                );
                const button = document.createElement("button");
                button.type = "button";
                button.className = "chip chip--whatsapp";
                button.innerHTML = '<i class="fa-brands fa-whatsapp" aria-hidden="true"></i> Ask on WhatsApp';
                button.addEventListener("click", () =>
                    openInNewTab(whatsappUrl(`Hi ${CONFIG.brand}, I have a question: ${question}`))
                );
                assistantMessages.append(button);
                assistantMessages.scrollTop = assistantMessages.scrollHeight;
            }

            function initAssistant() {
                assistantPanel.addEventListener("toggle", (event) => {
                    if (event.newState !== "open" || assistantStarted) return;
                    assistantStarted = true;
                    appendAssistantMessage(
                        "bot",
                        `Hi! 👋 I'm the ${escapeHtml(CONFIG.brand)} assistant. I can help with product info, pricing, bulk orders, payment & contact details. What would you like to know?`
                    );
                });

                const input = $("#assistantInput");
                $("#assistantForm").addEventListener("submit", (event) => {
                    event.preventDefault();
                    handleAssistantQuery(input.value);
                    input.value = "";
                });

                attachVoiceInput($("#voiceAssistantBtn"), input, {
                    idleLabel: "Ask by voice",
                    onTranscript: (transcript) => {
                        handleAssistantQuery(transcript);
                        input.value = "";
                    },
                });
            }

            // ============================== Popovers: light dismiss & Escape ==============================
            // Panels are popover="manual" so opening a modal dialog (remove-confirm, enquiry) from inside
            // the cart doesn't auto-close it; outside clicks and Escape are handled here instead.
            const panels = [cartPanel, assistantPanel];

            function initPanels() {
                cartPanel.addEventListener("beforetoggle", (event) => {
                    if (event.newState === "open") renderCart();
                });

                document.addEventListener("click", (event) => {
                    // composedPath() is captured at dispatch, so it still holds the ancestors of
                    // a target that a click handler has since removed or replaced.
                    const path = event.composedPath();
                    if ($("dialog:modal") || path.some((el) => el instanceof HTMLDialogElement)) return;
                    for (const panel of panels) {
                        if (!panel.matches(":popover-open")) continue;
                        const invoker = path.some((el) => el instanceof Element && el.getAttribute("popovertarget") === panel.id);
                        if (path.includes(panel) || invoker) continue;
                        panel.hidePopover();
                    }
                });

                document.addEventListener("keydown", (event) => {
                    if (event.key !== "Escape" || $("dialog:modal")) return;
                    panels.findLast((panel) => panel.matches(":popover-open"))?.hidePopover();
                });
            }

            // Backdrop click closes a dialog (fallback for browsers without closedby="any").
            function initDialogs() {
                for (const dialog of $$("dialog.modal")) {
                    dialog.addEventListener("click", (event) => {
                        if (event.target !== dialog) return;
                        const r = dialog.getBoundingClientRect();
                        const inside =
                            event.clientX >= r.left && event.clientX <= r.right && event.clientY >= r.top && event.clientY <= r.bottom;
                        if (!inside) dialog.close();
                    });
                }
            }

            // ============================== Scroll effects ==============================
            function initScrollEffects() {
                const fab = $("#scrollToTop");
                new IntersectionObserver(([entry]) => {
                    fab.classList.toggle("is-visible", !entry.isIntersecting && entry.boundingClientRect.top < 0);
                }).observe($("#scrollSentinel"));
                fab.addEventListener("click", () => {
                    window.scrollTo({ top: 0, behavior: prefersReducedMotion() ? "auto" : "smooth" });
                    $("#main-content").focus({ preventScroll: true });
                });

                // Progress bar + header condense run on CSS scroll timelines; JS only where unsupported.
                if (CSS.supports("animation-timeline: scroll()")) return;
                const header = $(".site-header");
                const bar = $("#scrollProgress");
                let ticking = false;
                const update = () => {
                    ticking = false;
                    const scrollable = document.documentElement.scrollHeight - innerHeight;
                    bar.style.scale = `${scrollable > 0 ? scrollY / scrollable : 0} 1`;
                    header.classList.toggle("is-scrolled", scrollY > 24);
                };
                const schedule = () => {
                    if (ticking) return;
                    ticking = true;
                    requestAnimationFrame(update);
                };
                addEventListener("scroll", schedule, { passive: true });
                addEventListener("resize", schedule, { passive: true });
                update();
            }

            // ============================== Decorative effects ==============================
            // Foam bubbles rising through the hero; skipped for reduced motion.
            function initHeroBubbles() {
                const wrap = $("#heroBubbles");
                if (!wrap || prefersReducedMotion()) return;
                const count = innerWidth < 768 ? 10 : 20;
                const bubbles = Array.from({ length: count }, () => {
                    const bubble = document.createElement("span");
                    bubble.className = "bubble";
                    bubble.style.setProperty("--s", `${8 + Math.random() * 38}px`);
                    bubble.style.setProperty("--x", `${Math.random() * 100}%`);
                    bubble.style.setProperty("--dur", `${9 + Math.random() * 10}s`);
                    bubble.style.setProperty("--delay", `${-Math.random() * 18}s`);
                    bubble.style.setProperty("--drift", `${(Math.random() - 0.5) * 120}px`);
                    return bubble;
                });
                wrap.append(...bubbles);
            }

            // Delegated on the grid so it keeps working after search reorders the cards.
            function initCardTilt() {
                const grid = $("#productsGrid");
                if (!grid || prefersReducedMotion() || !hasFinePointer()) return;
                const MAX_TILT_DEG = 5;
                grid.addEventListener("pointermove", (event) => {
                    const card = event.target.closest(".product-card");
                    if (!card) return;
                    const rect = card.getBoundingClientRect();
                    const px = (event.clientX - rect.left) / rect.width;
                    const py = (event.clientY - rect.top) / rect.height;
                    card.style.setProperty("--mx", `${px * 100}%`);
                    card.style.setProperty("--my", `${py * 100}%`);
                    card.style.setProperty("--ry", `${(px - 0.5) * MAX_TILT_DEG * 2}deg`);
                    card.style.setProperty("--rx", `${(0.5 - py) * MAX_TILT_DEG * 2}deg`);
                    card.classList.add("is-tilting");
                });
                grid.addEventListener("pointerout", (event) => {
                    const card = event.target.closest(".product-card");
                    if (!card || card.contains(event.relatedTarget)) return;
                    card.classList.remove("is-tilting");
                    card.style.setProperty("--rx", "0deg");
                    card.style.setProperty("--ry", "0deg");
                });
            }

            function initMagneticButtons() {
                if (prefersReducedMotion() || !hasFinePointer()) return;
                for (const el of $$(".magnetic")) {
                    el.addEventListener("pointermove", (event) => {
                        const rect = el.getBoundingClientRect();
                        el.style.setProperty("--tx", `${(event.clientX - rect.left - rect.width / 2) * 0.18}px`);
                        el.style.setProperty("--ty", `${(event.clientY - rect.top - rect.height / 2) * 0.25}px`);
                    });
                    el.addEventListener("pointerleave", () => {
                        el.style.setProperty("--tx", "0px");
                        el.style.setProperty("--ty", "0px");
                    });
                }
            }

            function initRipples() {
                if (prefersReducedMotion()) return;
                document.addEventListener("pointerdown", (event) => {
                    const btn = event.target.closest(".btn");
                    if (!btn) return;
                    const rect = btn.getBoundingClientRect();
                    const size = Math.max(rect.width, rect.height) * 2;
                    const ripple = document.createElement("span");
                    ripple.className = "ripple";
                    ripple.setAttribute("aria-hidden", "true");
                    Object.assign(ripple.style, {
                        width: `${size}px`,
                        height: `${size}px`,
                        left: `${event.clientX - rect.left - size / 2}px`,
                        top: `${event.clientY - rect.top - size / 2}px`,
                    });
                    btn.append(ripple);
                    ripple.addEventListener("animationend", () => ripple.remove(), { once: true });
                });
            }

            // ============================== Click delegation ==============================
            // One listener for every [data-action] element, including rows created later.
            document.addEventListener("click", (event) => {
                const target = event.target.closest("[data-action]");
                if (!target) return;
                const productId = Number(target.dataset.productId);
                const delta = Number(target.dataset.delta);
                const rowKey = target.closest("[data-key]")?.dataset.key;

                switch (target.dataset.action) {
                    case "copy":
                        copyText(target.dataset.copyText, target);
                        break;
                    case "upi-pay":
                        openUpiApp(event, target);
                        break;
                    case "add-to-cart":
                        addToCart(productId, target);
                        break;
                    case "open-enquiry":
                        openProductEnquiry(productId, target);
                        break;
                    case "open-cart-enquiry":
                        openCartEnquiry();
                        break;
                    case "clear-cart":
                        clearCart();
                        break;
                    case "cart-qty":
                        if (rowKey) setPacks(rowKey, (cart.get(rowKey)?.qty ?? 0) + delta);
                        break;
                    case "remove-from-cart":
                        if (rowKey) requestRemove(rowKey);
                        break;
                    case "confirm-remove":
                        confirmRemove();
                        break;
                    case "added-qty":
                        if (addedKey && setPacks(addedKey, (cart.get(addedKey)?.qty ?? 0) + delta)) refreshAddedDialog();
                        break;
                    case "view-cart":
                        viewCart();
                        break;
                    case "close-dialog":
                        target.closest("dialog")?.close();
                        break;
                    case "assistant-ask":
                        handleAssistantQuery(target.dataset.query);
                        break;
                    default:
                        break;
                }
            });

            // ============================== Boot ==============================
            // Module scripts run after the document is parsed - no DOMContentLoaded needed.
            loadCart();
            renderCart();
            initProductImages();
            initProductSearch();
            attachVoiceInput($("#voiceSearchBtn"), $("#productSearch"), { idleLabel: "Search by voice" });
            initCustomerFields();
            initAssistant();
            initPanels();
            initDialogs();
            initScrollEffects();
            initHeroBubbles();
            initCardTilt();
            initMagneticButtons();
            initRipples();
        </script>
    </body>
</html>
