                    background-image:
                        linear-gradient(rgb(255 255 255 / 0.06) 1px, transparent 1px),
                        linear-gradient(90deg, rgb(255 255 255 / 0.06) 1px, transparent 1px);
                    background-size: 56px 56px;
                    mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 20%, transparent 75%);
                }

                .hero__bubbles {
                    z-index: 1;
                }

                .aurora-orb {
                    position: absolute;
                    border-radius: 50%;
                    filter: blur(70px);
                    opacity: 0.55;
                    mix-blend-mode: screen;
                    animation: aurora-drift 18s ease-in-out infinite alternate;

                    &:nth-child(1) {
                        inline-size: 460px;
                        aspect-ratio: 1;
                        inset-block-start: -120px;
                        inset-inline-start: -80px;
                        background: #a855f7;
                    }

                    &:nth-child(2) {
                        inline-size: 380px;
                        aspect-ratio: 1;
                        inset-block-start: 30%;
                        inset-inline-end: -100px;
                        background: #06b6d4;
                        animation-duration: 22s;
                        animation-delay: -6s;
                    }

                    &:nth-child(3) {
                        inline-size: 320px;
                        aspect-ratio: 1;
                        inset-block-end: -120px;
                        inset-inline-start: 35%;
                        background: var(--cta-light);
                        opacity: 0.35;
                        animation-duration: 26s;
                        animation-delay: -12s;
                    }
                }

                .bubble {
                    position: absolute;
                    inset-block-end: -60px;
                    inset-inline-start: var(--x);
                    inline-size: var(--s);
                    aspect-ratio: 1;
                    border-radius: 50%;
                    background: radial-gradient(
                        circle at 30% 30%,
                        rgb(255 255 255 / 0.85) 0 8%,
                        rgb(255 255 255 / 0.18) 22%,
                        rgb(165 243 252 / 0.08) 60%,
                        rgb(255 255 255 / 0.25) 100%
                    );
                    border: 1px solid rgb(255 255 255 / 0.25);
                    animation: bubble-rise var(--dur) linear var(--delay) infinite;
                }

                .hero__content {
                    position: relative;
                    z-index: 10;
                    max-inline-size: 64rem;
                    margin-inline: auto;
                    padding-block: clamp(4rem, 8vw, 6rem);
                    text-align: center;
                    opacity: 1;
                    translate: 0 0;
                    transition:
                        opacity 0.7s var(--ease-standard),
                        translate 0.7s var(--ease-standard);
                }

                .hero__chip {
                    display: inline-flex;
                    align-items: center;
                    gap: 0.625rem;
                    padding: 0.5rem 1.125rem;
                    border-radius: var(--radius-full);
                    font-size: 0.85rem;
                    font-weight: 600;
                    color: #e0e7ff;
                    background: rgb(255 255 255 / 0.08);
                    border: 1px solid rgb(255 255 255 / 0.18);
                    backdrop-filter: blur(10px);

                    & .status-dot {
                        position: relative;
                    }
                }

                .hero__title {
                    margin-block: 1.5rem;
                    font-size: clamp(2.25rem, 1.4rem + 4.2vw, 4.5rem);
                    font-weight: 700;
                    line-height: 1.1;
                }

                .hero__lead {
                    max-inline-size: 48rem;
                    margin: 0 auto 2.5rem;
                    font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.25rem);
                    line-height: 1.7;
                    color: rgb(226 232 240 / 0.92);
                }

                .hero__actions {
                    display: flex;
                    flex-wrap: wrap;
                    justify-content: center;
                    gap: 1rem 1.5rem;
                }

                .hero__trust {
                    display: flex;
                    flex-wrap: wrap;
                    justify-content: center;
                    gap: 0.625rem 0.875rem;
                    margin-block-start: 2.75rem;

                    & li {
                        display: inline-flex;
                        align-items: center;
                        gap: 0.5rem;
                        padding: 0.5rem 0.875rem;
                        border-radius: 0.75rem;
                        font-size: 0.85rem;
                        font-weight: 500;
                        color: var(--ink-200);
                        background: rgb(255 255 255 / 0.06);
                        border: 1px solid rgb(255 255 255 / 0.12);
                        transition:
                            background-color 0.3s ease,
                            translate 0.3s ease;

                        &:hover {
                            background: rgb(255 255 255 / 0.12);
                            translate: 0 -2px;
                        }
                    }

                    & i {
                        color: #67e8f9;
                    }
                }

                .hero__scroll-cue {
                    position: absolute;
                    inset-inline-start: 50%;
                    inset-block-end: 78px;
                    z-index: 10;
                    translate: -50% 0;

                    @media (height <= 980px), (width <= 640px) {
                        display: none;
                    }
                }

                .scroll-mouse {
                    position: relative;
                    display: block;
                    inline-size: 26px;
                    block-size: 42px;
                    border: 2px solid rgb(255 255 255 / 0.5);
                    border-radius: 14px;

                    &::after {
                        content: "";
                        position: absolute;
                        inset-block-start: 7px;
                        inset-inline-start: 50%;
                        inline-size: 4px;
                        block-size: 8px;
                        margin-inline-start: -2px;
                        border-radius: 2px;
                        background: #fff;
                        animation: scroll-wheel 1.8s ease-in-out infinite;
                    }
                }

                .hero__wave {
                    position: absolute;
                    inset-inline: 0;
                    inset-block-end: -1px;
                    z-index: 5;
                    inline-size: 100%;
                    block-size: 70px;
                    color: var(--page-bg);
                }

                /* ---------- Product marquee ---------- */
                .marquee {
                    overflow: hidden;
                    padding: 0.875rem 0 0.375rem;
                    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
                }

                .marquee__track {
                    display: flex;
                    align-items: center;
                    gap: 2rem;
                    inline-size: max-content;
                    animation: marquee 38s linear infinite;

                    .marquee:hover & {
                        animation-play-state: paused;
                    }

                    & span {
                        font-family: var(--font-display);
                        font-size: clamp(1.1rem, 0.9rem + 1vw, 1.6rem);
                        font-weight: 700;
                        letter-spacing: -0.01em;
                        white-space: nowrap;
                        background: linear-gradient(90deg, var(--violet-900), var(--violet-bright) 25%, var(--blue) 50%, var(--cyan-dark) 75%, var(--violet-900));
                        background-size: 300% 100%;
                        -webkit-background-clip: text;
                        background-clip: text;
                        color: transparent;
                        animation: gradient-pan 6s linear infinite;
                    }

                    & i {
                        color: var(--cta);
                        font-size: 0.9rem;
                    }
                }

                /* ---------- Business details ---------- */
                .detail-card {
                    display: flex;
                    align-items: center;
                    gap: 1.5rem;
                    padding: 2rem;

                    & dt {
                        font-size: 0.875rem;
                        font-weight: 500;
                        color: var(--ink-600);
                        text-transform: uppercase;
                        letter-spacing: 0.05em;
                    }

                    & dd {
                        font-size: 1.125rem;
                        font-weight: 700;
                        color: var(--ink-800);
                        overflow-wrap: anywhere;
                    }

                    & dd a {
                        display: block;
                        color: var(--blue);
                    }
                }

                .mono {
                    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                }

                /* ---------- Product search ---------- */
                .search {
                    display: block;
                    position: relative;
                    max-inline-size: 36rem;
                    margin: 0 auto 2rem;

                    & > i {
                        position: absolute;
                        inset-inline-start: 1rem;
                        inset-block-start: 50%;
                        translate: 0 -50%;
                        color: var(--ink-400);
                        pointer-events: none;
                    }
                }

                .search__input {
                    inline-size: 100%;
                    padding: 0.8rem 3rem 0.8rem 2.75rem;
                    border-radius: var(--radius-full);
                    border: 1px solid var(--ink-200);
                    background: #fff;
                    font-size: 0.875rem;
                    box-shadow: 0 10px 30px -18px rgb(30 27 75 / 0.35);
                    transition: border-color 0.2s, box-shadow 0.2s;

                    &:focus {
                        outline: none;
                        border-color: var(--violet-bright);
                        box-shadow: 0 0 0 4px color-mix(in srgb, var(--violet-bright) 15%, transparent);
                    }

                    &::-webkit-search-cancel-button {
                        margin-inline-end: 0.25rem;
                    }
                }

                .voice-btn {
                    position: absolute;
                    inset-inline-end: 6px;
                    inset-block-start: 50%;
                    translate: 0 -50%;
                    inline-size: 2.125rem;
                    aspect-ratio: 1;
                    border-radius: 50%;
                    display: grid;
                    place-items: center;
                    color: var(--ink-400);
                    transition: color 0.2s, background-color 0.2s;

                    &:hover {
                        color: #3b82f6;
                        background: rgb(59 130 246 / 0.1);
                    }

                    &.is-listening {
                        color: var(--danger);
                        animation: voice-pulse 1s ease-in-out infinite;
                    }
                }

                .products-empty {
                    text-align: center;
                    color: var(--ink-500);
                    padding-block: 3rem;
                }

                /* ---------- Product card ---------- */
                .product-card {
                    container: card / inline-size;
                    overflow: hidden;
                    border-radius: 1.5rem;
                    background: rgb(255 255 255 / 0.85);
                    transform: perspective(1000px) rotateX(var(--rx)) rotateY(var(--ry));
                    transition:
                        transform 0.45s var(--ease-standard),
                        translate 0.45s var(--ease-standard),
                        box-shadow 0.45s var(--ease-standard),
                        --rx 0.45s var(--ease-standard),
                        --ry 0.45s var(--ease-standard);

                    &:hover {
                        translate: 0 -8px;
                    }

                    &.is-tilting {
                        transition:
                            translate 0.45s var(--ease-standard),
                            box-shadow 0.45s var(--ease-standard),
                            --rx 0.12s ease-out,
                            --ry 0.12s ease-out;
                    }
                }

                .product-card__spotlight {
                    position: absolute;
                    inset: 0;
                    z-index: 2;
                    border-radius: inherit;
                    pointer-events: none;
                    background: radial-gradient(380px circle at var(--mx) var(--my), rgb(124 58 237 / 0.12), transparent 45%);
                    opacity: 0;
                    transition: opacity 0.4s ease;

                    .product-card:hover & {
                        opacity: 1;
                    }
                }

                .product-card__media {
                    position: relative;
                    display: grid;
                    place-items: center;
                    block-size: 250px;
                    overflow: hidden;
                    background: #fff;

                    /* Light sweep on hover */
                    &::after {
                        content: "";
                        position: absolute;
                        inset: 0;
                        z-index: 1;
                        background: linear-gradient(115deg, transparent 40%, rgb(255 255 255 / 0.65) 50%, transparent 60%);
                        translate: -110% 0;
                        transition: translate 0.9s var(--ease-standard);
                        pointer-events: none;
                    }

                    .product-card:hover &::after {
                        translate: 110% 0;
                    }
                }

                .product-card__img {
                    inline-size: 100%;
                    block-size: 100%;
                    padding: 1.25rem;
                    object-fit: contain;
                    background: #fff;
                    transition:
                        scale 0.7s ease,
                        opacity 0.3s ease;

                    .product-card:hover & {
                        scale: 1.05;
                    }

                    .is-broken & {
                        display: none;
                    }
                }

                /* Skeleton shimmer until the image has loaded (only when JS can report it). */
                @media (scripting: enabled) {
                    .product-card__media:not(.is-loaded, .is-broken) {
                        & .product-card__img {
                            opacity: 0;
                        }

                        &::before {
                            content: "";
                            position: absolute;
                            inset: 0;
                            background: linear-gradient(90deg, var(--ink-100) 25%, var(--ink-200) 37%, var(--ink-100) 63%);
                            background-size: 400% 100%;
                            animation: shimmer 1.4s ease infinite;
                        }
                    }
                }

                .product-card__fallback {
                    position: absolute;
                    inset: 0;
                    display: none;
                    flex-direction: column;
                    align-items: center;
                    justify-content: center;
                    gap: 0.5rem;
                    font-size: 0.875rem;
                    color: #9ca3af;
                    background: linear-gradient(135deg, #f3f4f6, #e5e7eb);

                    & i {
                        font-size: 2.25rem;
                    }

                    .is-broken & {
                        display: flex;
                    }
                }

                .product-card__body {
                    padding: 1.5rem;
                }

                .product-card__title {
                    font-size: 1.25rem;
                    font-weight: 700;
                    margin-block-end: 0.75rem;
                    transition: color 0.2s;

                    .product-card:hover & {
                        color: var(--blue);
                    }
                }

                .product-card__desc {
                    color: var(--ink-600);
                    margin-block-end: 1rem;
                }

                .product-card__row {
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    gap: 0.75rem;
                }

                .product-card__price {
                    font-family: var(--font-display);
                    font-size: 1.5rem;
                    font-weight: 700;
                    white-space: nowrap;

                    & small {
                        margin-inline-start: 0.25rem;
                        font-family: var(--font-sans);
                        font-size: 1.05rem;
                        font-weight: 600;
                        color: var(--ink-500);
                    }
                }

                .product-card__actions {
                    display: flex;
                    gap: 0.5rem;
                }

                /* Narrow cards stack price above the buttons. */
                @container card (width < 290px) {
                    .product-card__row {
                        flex-direction: column;
                        align-items: flex-start;
                    }
                }

                /* ---------- Quantity chips (native radios) ---------- */
                .qty-picker {
                    margin-block: 0.875rem 0.75rem;

                    & legend {
                        padding: 0;
                        margin-block-end: 0.5rem;
                        font-size: 0.75rem;
                        font-weight: 600;
                        color: var(--ink-500);
                    }
                }

                .qty-picker__options {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 0.5rem;
                }

                .qty-chip {
                    position: relative;
                    cursor: pointer;

                    & input {
                        position: absolute;
                        inset: 0;
                        margin: 0;
                        opacity: 0;
                        cursor: pointer;
                    }

                    & span {
                        display: inline-block;
                        padding: 0.25rem 0.875rem;
                        border: 2px solid var(--ink-300);
                        border-radius: var(--radius-full);
                        font-size: 0.8rem;
                        font-weight: 600;
                        color: var(--ink-600);
                        user-select: none;
                        transition:
                            background-color 0.2s,
                            border-color 0.2s,
                            color 0.2s,
                            box-shadow 0.2s;
                    }

                    &:hover span {
                        border-color: var(--violet-bright);
                        color: var(--violet-bright);
                    }

                    &:has(input:checked) span {
                        border-color: transparent;
                        color: #fff;
                        background: var(--gradient-violet);
                        box-shadow: 0 4px 12px color-mix(in srgb, var(--violet-bright) 35%, transparent);
                    }

                    &:has(input:focus-visible) span {
                        outline: 2px solid var(--blue);
                        outline-offset: 2px;
                    }
                }

                .qty-chip--lg span {
                    padding: 0.5rem 1.125rem;
                }

                /* ---------- FAQ (exclusive accordion) ---------- */
                .faq-list {
                    display: grid;
                    gap: 1rem;
                    max-inline-size: 48rem;
                    margin-inline: auto;
                }

                .faq-item {
                    overflow: hidden;
                    border-radius: 1rem;
                    border: 1px solid var(--ink-200);
                    background: #fff;
                    box-shadow: 0 1px 2px rgb(0 0 0 / 0.05);
                    transition:
                        box-shadow 0.3s ease,
                        translate 0.3s ease;

                    &:hover {
                        translate: 0 -2px;
                        box-shadow: 0 14px 30px -16px rgb(30 27 75 / 0.3);
                    }

                    &[open] {
                        box-shadow: var(--shadow-glow);
                    }

                    & summary {
                        display: flex;
                        justify-content: space-between;
                        align-items: center;
                        gap: 1rem;
                        padding: 1rem 1.5rem;
                        list-style: none;
                        cursor: pointer;
                        font-size: 1.125rem;
                        font-weight: 600;
                        color: var(--ink-800);
                        background: var(--ink-100);
                        transition:
                            background-color 0.3s,
                            color 0.3s;

                        &::-webkit-details-marker {
                            display: none;
                        }

                        & i {
                            flex: none;
                            transition: rotate 0.3s var(--ease-spring);
                        }
                    }

                    &[open] summary {
                        color: #fff;
                        background: linear-gradient(90deg, var(--cta-light), var(--cta));

                        & i {
                            rotate: 135deg;
                        }
                    }

                    & p {
                        padding: 1rem 1.5rem;
                        color: var(--ink-600);
                    }

                    /* Animated open/close via the details-content pseudo-element. */
                    &::details-content {
                        block-size: 0;
                        overflow: hidden;
                        transition:
                            block-size 0.35s var(--ease-standard),
                            content-visibility 0.35s allow-discrete;
                    }

                    &[open]::details-content {
                        block-size: auto;
                    }
                }

                /* ---------- Contact ---------- */
                .contact-card {
                    padding: 2rem;
                }

                .contact-card__row {
                    display: flex;
                    align-items: center;
                    gap: 1.5rem;

                    & h3 {
                        font-size: 1.25rem;
                        font-weight: 600;
                        margin-block-end: 0.5rem;
                    }

                    & a {
                        display: block;
                        color: var(--blue);
                        overflow-wrap: anywhere;
                    }
                }

                .contact-card__pay {
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;

                    & a {
                        display: inline;
                    }
                }

                .contact-card__qr {
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    margin-block-start: 1.5rem;
                    text-align: center;

                    & a {
                        display: block;
                        padding: 0.75rem;
                        border-radius: 0.75rem;
                        background: #fff;
                        box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
                        transition:
                            translate 0.2s,
                            box-shadow 0.2s;

                        &:hover {
                            translate: 0 -2px;
                            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.12);
                        }
                    }

                    & img {
                        border-radius: 0.5rem;
                    }

                    & p {
                        margin-block-start: 0.75rem;
                        font-size: 0.875rem;
                        color: var(--ink-500);
                    }
                }

                /* ---------- UPI pay card (cart + cart enquiry) ---------- */
                .upi-card {
                    display: flex;
                    align-items: center;
                    gap: 0.75rem;
                    margin-block-end: 0.75rem;
                    padding: 0.625rem;
                    border: 1.5px dashed #c7d2fe;
                    border-radius: var(--radius-md);
                    background: #fff;
                }

                .upi-card__qr {
                    flex: none;
                    display: block;
                    padding: 6px;
                    border-radius: var(--radius-sm);
                    background: #fff;
                    box-shadow: 0 4px 12px rgb(15 23 42 / 0.12);
                    transition:
                        translate 0.2s,
                        box-shadow 0.2s;

                    &:hover {
                        translate: 0 -1px;
                        box-shadow: 0 8px 18px rgb(52 168 83 / 0.3);
                    }

                    & img {
                        border-radius: 0.375rem;
                    }
                }

                .upi-card__text {
                    min-inline-size: 0;
                }

                .upi-card__brand {
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                    margin-block-end: 0.25rem;
                }

                .upi-card__hint {
                    font-size: 0.75rem;
                    line-height: 1.4;
                    color: var(--ink-500);
                }

                /* ---------- Footer ---------- */
                .site-footer {
                    position: relative;
                    isolation: isolate;
                    overflow: hidden;
                    margin-block-start: 2rem;
                    padding-block: 3rem;
                    color: #fff;
                    background:
                        radial-gradient(600px 300px at 90% 0%, rgb(34 211 238 / 0.18), transparent 60%),
                        radial-gradient(600px 300px at 0% 100%, rgb(124 58 237 / 0.35), transparent 60%),
                        linear-gradient(160deg, var(--violet-deep), var(--violet-950) 55%, var(--indigo-900));
                }

                .site-footer__top {
                    display: flex;
                    flex-wrap: wrap;
                    justify-content: space-between;
                    align-items: center;
                    gap: 2rem;

                    @media (width <= 767px) {
                        flex-direction: column;
                        text-align: center;
                    }
                }

                .site-footer__brand {
                    font-size: 1.875rem;
                    font-weight: 700;
                    margin-block-end: 0.75rem;
                }

                .site-footer__tagline {
                    font-size: 1.125rem;
                    color: var(--ink-300);
                }

                .footer-chip {
                    display: inline-flex;
                    align-items: center;
                    gap: 0.625rem;
                    margin-block-start: 0.75rem;
                    padding: 0.45rem 1rem;
                    border-radius: var(--radius-full);
                    font-size: 0.82rem;
                    font-weight: 600;
                    color: #e0e7ff;
                    background: rgb(255 255 255 / 0.08);
                    border: 1px solid rgb(255 255 255 / 0.18);
                    backdrop-filter: blur(10px);

                    & .status-dot {
                        position: relative;
                        inline-size: 7px;
                    }
                }

                .social-links {
                    display: flex;
                    gap: 1.5rem;
                }

                .social-link {
                    display: grid;
                    place-items: center;
                    inline-size: 3rem;
                    aspect-ratio: 1;
                    border-radius: 0.75rem;
                    font-size: 1.125rem;
                    background: linear-gradient(135deg, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0.04));
                    border: 1px solid rgb(255 255 255 / 0.15);
                    box-shadow: 0 6px 18px -8px rgb(0 0 0 / 0.4);
                    transition:
                        translate 0.3s var(--ease-spring),
                        scale 0.3s var(--ease-spring),
                        box-shadow 0.3s ease;

                    &:hover {
                        translate: 0 -3px;
                        scale: 1.05;
                        border-color: transparent;
                        background: var(--gradient-violet);
                        box-shadow: 0 10px 26px -8px rgb(124 58 237 / 0.6);
                    }
                }

                .site-footer__bottom {
                    margin-block-start: 2rem;
                    padding-block-start: 2rem;
                    border-block-start: 1px solid rgb(255 255 255 / 0.12);
                    text-align: center;
                    color: var(--ink-300);

                    & .text-shine {
                        margin-block-start: 0.5rem;
                        font-size: 0.875rem;
                        font-weight: 600;
                        letter-spacing: 0.02em;
                        filter: none;
                    }
                }

                /* ---------- Floating action buttons ---------- */
                .fab {
                    position: fixed;
                    inset-block-end: 1.5rem;
                    z-index: 60;
                    display: grid;
                    place-items: center;
                    inline-size: 3.5rem;
                    aspect-ratio: 1;
                    border-radius: 50%;
                    color: #fff;
                    font-size: 1.125rem;
                    background: var(--gradient-violet);
                    box-shadow: 0 10px 24px -6px color-mix(in srgb, var(--violet-bright) 55%, transparent);
                    transition:
                        translate 0.3s var(--ease-standard),
                        box-shadow 0.3s var(--ease-standard),
                        opacity 0.3s var(--ease-standard),
                        visibility 0.3s allow-discrete;

                    &:hover {
                        translate: 0 -2px;
                        box-shadow: 0 12px 28px color-mix(in srgb, var(--violet-bright) 45%, transparent);
                    }

                    &:active {
                        scale: 0.96;
                    }
                }

                .fab--top {
                    inset-inline-end: 1.5rem;

                    &:not(.is-visible) {
                        opacity: 0;
                        visibility: hidden;
                        translate: 0 1rem;
                    }
                }

                .fab--assistant {
                    inset-inline-start: 1.5rem;
                    inline-size: 3.625rem;
                    font-size: 1.4rem;

                    &::after {
                        content: "";
                        position: absolute;
                        inset: 0;
                        border-radius: 50%;
                        border: 2px solid var(--violet-bright);
                        animation: pulse-ring 3s cubic-bezier(0.455, 0.03, 0.515, 0.955) infinite;
                    }
                }

                /* ---------- Popover panels (cart, assistant) ---------- */
                .panel {
                    position: fixed;
                    inset: auto;
                    margin: 0;
                    padding: 0;
                    flex-direction: column;
                    overflow: hidden;
                    border: 1px solid rgb(255 255 255 / 0.7);
                    border-radius: var(--radius-lg);
                    color: var(--ink-800);
                    background: rgb(255 255 255 / 0.94);
                    backdrop-filter: blur(18px);
                    box-shadow: var(--shadow-float);
                    opacity: 0;
                    scale: 0.85;
                    transition:
                        opacity 0.3s var(--ease-standard),
                        scale 0.3s var(--ease-standard),
                        overlay 0.3s allow-discrete,
                        display 0.3s allow-discrete;

                    &:popover-open {
                        display: flex;
                        opacity: 1;
                        scale: 1;
                    }
                }

                .panel__header {
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    gap: 0.75rem;
                    padding: 1rem 1.25rem;
                    color: #fff;
                    background: var(--gradient-panel);

                    & h2 {
                        font-family: var(--font-sans);
                        font-size: 1rem;
                        font-weight: 700;
                        letter-spacing: 0;
                        display: flex;
                        align-items: center;
                        gap: 0.5rem;
                    }
                }

                .panel__close {
                    display: grid;
                    place-items: center;
                    inline-size: 2rem;
                    aspect-ratio: 1;
                    border-radius: 50%;
                    color: #fff;
                    transition: background-color 0.2s;

                    &:hover {
                        background: rgb(255 255 255 / 0.15);
                    }
                }

                .cart-panel {
                    inset-block-start: 5rem;
                    inset-inline-end: 1rem;
                    inline-size: min(100vw - 1rem, 21rem);
                    max-block-size: min(80dvh, 44rem);
                    transform-origin: top right;
                }

                /* Pin the cart under its button, wherever the header wraps to. */
                @supports (position-anchor: --a) {
                    .cart-panel {
                        position-anchor: --cart-button;
                        inset-block-start: calc(anchor(bottom) + 0.75rem);
                        inset-inline-end: anchor(right);
                    }
                }

                .cart-panel__list {
                    flex: 1;
                    min-block-size: 0;
                    overflow-y: auto;
                    overscroll-behavior: contain;
                    padding: 0.75rem 1rem;
                }

                .cart-panel__empty {
                    display: grid;
                    justify-items: center;
                    gap: 0.5rem;
                    padding: 2rem 1rem;
                    font-size: 0.875rem;
                    color: var(--ink-400);

                    & i {
                        font-size: 1.875rem;
                    }
                }

                .cart-panel__footer {
                    padding: 0.875rem 1.25rem;
                    border-block-start: 1px solid var(--ink-200);
                    background: var(--ink-50);
                }

                .cart-panel__total {
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    margin-block-end: 0.75rem;
                    font-weight: 600;
                    color: var(--ink-700);

                    & output {
                        font-size: 1.125rem;
                        font-weight: 700;
                        color: var(--ink-800);
                    }
                }

                .cart-panel__clear {
                    inline-size: 100%;
                    margin-block-start: 0.5rem;
                    padding-block: 0.25rem;
                    font-size: 0.75rem;
                    font-weight: 600;
                    color: var(--ink-400);
                    transition: color 0.2s;

                    &:hover {
                        color: var(--danger);
                    }
                }

                .cart-row {
                    display: flex;
                    align-items: center;
                    gap: 0.625rem;
                    padding-block: 0.625rem;
                    border-block-end: 1px solid var(--ink-100);
                    font-size: 0.8125rem;
                    animation: row-in 0.3s var(--ease-out);

                    &:last-child {
                        border-block-end: 0;
                    }
                }

                .cart-row__img {
                    flex: none;
                    inline-size: 2.5rem;
                    aspect-ratio: 1;
                    object-fit: contain;
                    border-radius: 0.5rem;
                    background: var(--ink-50);
                }

                .cart-row__info {
                    flex: 1;
                    min-inline-size: 0;
                }

                .cart-row__name {
                    font-weight: 600;
                    color: var(--ink-800);
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }

                .cart-row__meta {
                    font-size: 0.75rem;
                    color: var(--ink-500);
                }

                .cart-row__remove {
                    margin-inline-start: 0.25rem;
                    padding: 0.25rem;
                    font-size: 0.75rem;
                    color: #f87171;
                    transition: color 0.2s;

                    &:hover {
                        color: var(--danger-dark);
                    }
                }

                /* ---------- Steppers ---------- */
                .stepper {
                    display: flex;
                    align-items: center;
                    gap: 0.375rem;

                    & button {
                        display: grid;
                        place-items: center;
                        inline-size: 1.5rem;
                        aspect-ratio: 1;
                        border-radius: 50%;
                        border: 1.5px solid var(--ink-300);
                        font-weight: 700;
                        transition: border-color 0.2s, color 0.2s;

                        &:hover:not(:disabled) {
                            border-color: #3b82f6;
                            color: #3b82f6;
                        }

                        &:disabled {
                            opacity: 0.4;
                            cursor: not-allowed;
                        }
                    }

                    & output {
                        min-inline-size: 1.25rem;
                        text-align: center;
                        font-size: 0.75rem;
                        font-weight: 700;
                    }
                }

                .stepper--pill {
                    gap: 0;
                    padding: 3px;
                    border-radius: var(--radius-full);
                    background: #fff;
                    border: 1px solid color-mix(in srgb, var(--violet-bright) 18%, transparent);

                    & button {
                        inline-size: 2rem;
                        border: 0;
                        color: var(--violet);
                        background: #f5f3ff;
                        transition:
                            scale 0.2s var(--ease-spring),
                            background-color 0.2s,
                            color 0.2s;

                        &:hover:not(:disabled) {
                            color: #fff;
                            background: var(--gradient-violet);
                            scale: 1.08;
                        }
                    }

                    & output {
                        min-inline-size: 2.75rem;
                        font-family: var(--font-display);
                        font-size: 0.95rem;
                        color: #1e1b4b;
                    }
                }

                /* ---------- Assistant ---------- */
                .assistant-panel {
                    inset-block-end: 6rem;
                    inset-inline-start: 1.5rem;
                    inline-size: 21.25rem;
                    max-block-size: 70dvh;
                    transform-origin: bottom left;
                }

                .assistant-panel__who {
                    display: flex;
                    align-items: center;
                    gap: 0.75rem;

                    & p {
                        font-size: 0.75rem;
                        opacity: 0.7;
                    }
                }

                .assistant-avatar {
                    flex: none;
                    display: grid;
                    place-items: center;
                    inline-size: 2.375rem;
                    aspect-ratio: 1;
                    border-radius: 50%;
                    font-size: 1.1rem;
                    background: rgb(255 255 255 / 0.15);
                }

                .assistant-messages {
                    flex: 1;
                    display: flex;
                    flex-direction: column;
                    gap: 0.625rem;
                    min-block-size: 180px;
                    padding: 1rem;
                    overflow-y: auto;
                    overscroll-behavior: contain;
                }

                .assistant-msg {
                    max-inline-size: 88%;
                    padding: 0.625rem 0.875rem;
                    border-radius: 0.875rem;
                    font-size: 0.8125rem;
                    line-height: 1.55;
                    animation: row-in 0.3s var(--ease-spring);

                    & a {
                        color: var(--blue);
                    }
                }

                .assistant-msg--bot {
                    align-self: flex-start;
                    color: var(--ink-800);
                    background: var(--ink-100);
                    border-end-start-radius: 4px;
                }

                .assistant-msg--user {
                    align-self: flex-end;
                    color: #fff;
                    background: var(--gradient-violet);
                    border-end-end-radius: 4px;
                }

                .assistant-chips {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 0.375rem;
                    padding: 0 1rem 0.75rem;
                }

                .chip {
                    padding: 0.3rem 0.75rem;
                    border: 1.5px solid var(--ink-300);
                    border-radius: var(--radius-full);
                    font-size: 0.72rem;
                    font-weight: 600;
                    color: var(--ink-600);
                    transition: border-color 0.2s, color 0.2s;

                    &:hover {
                        border-color: #3b82f6;
                        color: #3b82f6;
                    }
                }

                .chip--whatsapp {
                    align-self: flex-start;
                    margin-block-start: -0.25rem;
                    border: 0;
                    color: #fff;
                    background: var(--gradient-whatsapp);

                    &:hover {
                        color: #fff;
                        filter: brightness(0.95);
                    }
                }

                .assistant-form {
                    display: flex;
                    gap: 0.5rem;
                    padding: 0.75rem 1rem;
                    border-block-start: 1px solid var(--ink-200);
                }

                .assistant-form__input {
                    flex: 1;
                    min-inline-size: 0;
                    padding: 0.625rem 0.875rem;
                    border: 1.5px solid var(--ink-200);
                    border-radius: var(--radius-full);
                    font-size: 0.8125rem;
                    background: var(--ink-50);

                    &:focus {
                        outline: none;
                        border-color: #3b82f6;
                    }
                }

                .round-btn {
                    flex: none;
                    display: grid;
                    place-items: center;
                    inline-size: 2.5rem;
                    aspect-ratio: 1;
                    border-radius: 50%;
                    transition: scale 0.2s, border-color 0.2s, color 0.2s;
                }

                .round-btn--send {
                    color: #fff;
                    background: linear-gradient(135deg, #3b82f6, var(--blue-dark));

                    &:hover {
                        scale: 1.05;
                    }
                }

                .round-btn--voice {
                    border: 1.5px solid var(--ink-300);
                    color: var(--ink-500);

                    &:hover {
                        border-color: #3b82f6;
                        color: #3b82f6;
                    }

                    &.is-listening {
                        border-color: var(--danger);
                        color: var(--danger);
                        animation: voice-pulse 1s ease-in-out infinite;
                    }
                }

                @media (width <= 480px) {
                    .cart-panel {
                        inset-inline-end: 0.5rem;
                        inline-size: calc(100vw - 1rem);
                    }

                    .assistant-panel {
                        inset-inline: 0.5rem;
                        inset-block-end: 5.5rem;
                        inline-size: auto;
                    }
                }

                /* ---------- Modal dialogs ---------- */
                .modal {
                    /* Re-centre: the reset's margin: 0 removes the UA's margin: auto. */
                    margin: auto;
                    inline-size: min(100% - 2rem, 31.25rem);
                    max-inline-size: none;
                    max-block-size: min(92dvh, 60rem);
                    padding: 0;
                    border: 0;
                    border-radius: var(--radius-xl);
                    color: var(--ink-800);
                    background: linear-gradient(180deg, #fff, #faf9ff);
                    box-shadow: var(--shadow-pop);
                    overflow-y: auto;
                    overscroll-behavior: contain;
                    opacity: 0;
                    translate: 0 32px;
                    scale: 0.96;
                    transition:
                        opacity 0.3s var(--ease-out),
                        translate 0.45s var(--ease-out),
                        scale 0.45s var(--ease-out),
                        overlay 0.3s allow-discrete,
                        display 0.3s allow-discrete;

                    &[open] {
                        opacity: 1;
                        translate: 0 0;
                        scale: 1;
                    }

                    &:focus {
                        outline: none;
                    }

                    &::backdrop {
                        background:
                            radial-gradient(circle at 20% 10%, rgb(124 58 237 / 0.3), transparent 50%),
                            radial-gradient(circle at 80% 90%, rgb(34 211 238 / 0.2), transparent 50%),
                            rgb(15 8 40 / 0.6);
                        backdrop-filter: blur(8px);
                        opacity: 0;
                        transition:
                            opacity 0.3s ease,
                            overlay 0.3s allow-discrete,
                            display 0.3s allow-discrete;
                    }

                    &[open]::backdrop {
                        opacity: 1;
                    }
                }

                .modal--sm {
                    inline-size: min(100% - 2rem, 26.25rem);
                    text-align: center;
                }

                .modal--xs {
                    inline-size: min(100% - 2rem, 23.75rem);
                    text-align: center;
                }

                .modal__header {
                    position: sticky;
                    inset-block-start: 0;
                    z-index: 2;
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    gap: 1rem;
                    padding: 1.375rem 1.5rem;
                    color: #fff;
                    background: var(--gradient-panel);

                    & h2 {
                        font-size: 1.25rem;
                        font-weight: 700;
                    }

                    & p {
                        margin-block-start: 0.25rem;
                        font-size: 0.75rem;
                        color: #dbeafe;
                    }
                }

                .modal__close {
                    flex: none;
                    display: grid;
                    place-items: center;
                    inline-size: 2.375rem;
                    aspect-ratio: 1;
                    border-radius: 50%;
                    color: #fff;
                    background: rgb(255 255 255 / 0.15);
                    transition:
                        background-color 0.2s,
                        rotate 0.3s var(--ease-spring);

                    &:hover {
                        background: rgb(255 255 255 / 0.28);
                        rotate: 90deg;
                    }
                }

                .modal__body {
                    padding: 1.5rem;
                }

                .modal__note {
                    margin-block-start: 0.75rem;
                    text-align: center;
                    font-size: 0.75rem;
                    color: var(--ink-400);
                }

                .modal__actions {
                    display: flex;
                    gap: 0.75rem;
                    padding-inline: 1.5rem;

                    & .btn {
                        flex: 1;
                        padding: 0.8rem;
                        font-size: 0.85rem;
                    }
                }

                /* ---------- Enquiry form ---------- */
                .enquiry-product {
                    display: flex;
                    align-items: center;
                    gap: 1rem;
                    margin-block-end: 1.375rem;
                    padding: 1rem;
                    border-radius: 1rem;
                    border: 1px solid #bae6fd;
                    background: #f0f9ff;

                    & img {
                        flex: none;
                        inline-size: 4.5rem;
                        aspect-ratio: 1;
                        object-fit: contain;
                        border-radius: 0.75rem;
                        background: #fff;
                    }
                }

                .enquiry-product__label {
                    font-size: 0.75rem;
                    color: var(--ink-500);
                }

                .enquiry-product__name {
                    font-size: 1.125rem;
                    font-weight: 700;
                }

                .enquiry-product__rate {
                    font-size: 0.875rem;
                    font-weight: 600;
                    color: var(--blue);
                }

                .order-summary {
                    margin-block-end: 1.25rem;
                    padding: 1rem;
                    border-radius: 1rem;
                    border: 1px solid #bae6fd;
                    background: #f0f9ff;
                }

                .order-summary__row {
                    display: flex;
                    align-items: center;
                    gap: 0.75rem;
                    padding-block: 0.5rem;
                    border-block-end: 1px solid #e0f2fe;

                    & img {
                        flex: none;
                        inline-size: 2.5rem;
                        aspect-ratio: 1;
                        object-fit: contain;
                        border-radius: 0.5rem;
                        background: #fff;
                    }

                    & div {
                        flex: 1;
                        min-inline-size: 0;
                    }

                    & strong {
                        font-size: 0.875rem;
                    }
                }

                .order-summary__name {
                    font-size: 0.875rem;
                    font-weight: 600;
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }

                .order-summary__meta {
                    font-size: 0.75rem;
                    color: var(--ink-500);
                }

                .order-summary__total {
                    display: flex;
                    justify-content: space-between;
                    padding-block-start: 0.75rem;
                    font-weight: 700;

                    & output {
                        color: var(--blue);
                    }
                }

                .field {
                    margin-block-end: 1rem;
                }

                .field__label {
                    display: block;
                    margin-block-end: 0.25rem;
                    font-size: 0.875rem;
                    font-weight: 600;
                    color: var(--ink-700);

                    & abbr {
                        color: var(--danger);
                        text-decoration: none;
                    }
                }

                .field__label-row {
                    display: flex;
                    justify-content: space-between;
                    align-items: center;

                    & .field__label {
                        margin: 0;
                    }
                }

                .field__hint {
                    margin-block-start: 0.25rem;
                    font-size: 0.75rem;
                    color: var(--ink-500);
                }

                .field__error {
                    margin-block-start: 0.25rem;
                    font-size: 0.75rem;
                    color: var(--danger);
                }

                .field-row {
                    display: grid;
                    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
                    gap: 0 0.75rem;
                }

                .input {
                    inline-size: 100%;
                    padding: 0.75rem 1rem;
                    border: 1.5px solid var(--ink-200);
                    border-radius: 0.8rem;
                    font-size: 0.9rem;
                    color: var(--ink-800);
                    background: var(--ink-50);
                    accent-color: var(--violet-bright);
                    transition:
                        border-color 0.2s,
                        background-color 0.2s;

                    &:focus {
                        outline: none;
                        border-color: #3b82f6;
                        background: #fff;
                    }

                    &[readonly] {
                        border-color: #c7d2fe;
                        color: #3730a3;
                        font-weight: 600;
                        background: #eef2ff;
                    }

                    .field:has(.field__error:not([hidden])) & {
                        border-color: var(--danger);
                        background: #fef2f2;
                    }
                }

                textarea.input {
                    field-sizing: content;
                    min-block-size: 4.5rem;
                    max-block-size: 12rem;
                    resize: vertical;
                }

                .link-btn {
                    font-size: 0.75rem;
                    font-weight: 600;
                    color: var(--blue-dark);
                    text-decoration: underline;
                }

                .enquiry-single-qty {
                    font-size: 0.875rem;
                    color: var(--ink-500);
                }

                /* ---------- Added-to-cart dialog ---------- */
                .added-hero {
                    position: relative;
                    padding: 1.625rem 1.5rem 1.25rem;
                    color: #fff;
                    background:
                        radial-gradient(240px 140px at 100% 0%, rgb(34 211 238 / 0.45), transparent 70%),
                        radial-gradient(220px 140px at 0% 120%, rgb(249 115 22 / 0.4), transparent 70%),
                        var(--gradient-panel);

                    & .modal__close {
                        position: absolute;
                        inset-block-start: 0.875rem;
                        inset-inline-end: 0.875rem;
                        inline-size: 2rem;
                        border-radius: 0.75rem;
                        border: 1px solid rgb(255 255 255 / 0.22);
                        background: rgb(255 255 255 / 0.12);
                    }
                }

                .added-check {
                    display: grid;
                    place-items: center;
                    inline-size: 3.625rem;
                    aspect-ratio: 1;
                    margin: 0 auto 0.75rem;
                    border-radius: 50%;
                    font-size: 1.4rem;
                    color: #fff;
                    background: linear-gradient(135deg, var(--success), #059669);
                    box-shadow:
                        0 0 0 6px rgb(255 255 255 / 0.14),
                        0 14px 30px -10px rgb(5 150 105 / 0.8);

                    .modal[open] & {
                        animation: check-pop 0.6s var(--ease-spring) 0.15s backwards;
                    }
                }

                .added-hero__name {
                    margin-inline: 1.5rem;
                    font-family: var(--font-display);
                    font-size: 1.1rem;
                    font-weight: 700;
                }

                .added-hero__msg {
                    font-size: 0.82rem;
                    color: rgb(224 231 255 / 0.85);
                }

                .added-body {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    gap: 1.125rem;
                    margin: 1.25rem 1.5rem 1.125rem;
                    padding: 0.875rem;
                    border-radius: var(--radius-lg);
                    border: 1px solid transparent;
                    background:
                        linear-gradient(135deg, #f5f3ff, #ecfeff) padding-box,
                        linear-gradient(135deg, rgb(124 58 237 / 0.45), rgb(34 211 238 / 0.45)) border-box;

                    @media (width <= 480px) {
                        flex-direction: column;
                    }
                }

                .added-body__img {
                    flex: none;
                    inline-size: 5.5rem;
                    aspect-ratio: 1;
                    padding: 0.625rem;
                    object-fit: contain;
                    border-radius: 1rem;
                    background: #fff;
                    box-shadow: 0 10px 20px -12px rgb(76 29 149 / 0.5);
                }

                .added-body__qty p {
                    margin-block-end: 0.5rem;
                    font-size: 0.66rem;
                    font-weight: 700;
                    letter-spacing: 0.14em;
                    text-transform: uppercase;
                    color: var(--violet);
                }

                .added-summary {
                    padding-inline: 1.5rem;
                    font-size: 0.85rem;
                    color: var(--ink-500);

                    & button {
                        font-weight: 700;
                        color: var(--violet);
                        text-decoration: underline;
                        text-decoration-color: rgb(124 58 237 / 0.35);
                        text-underline-offset: 3px;
                    }
                }

                .added-subtotal {
                    margin: 0.25rem 0 1.25rem;
                    padding-inline: 1.5rem;
                    font-size: 0.95rem;
                    color: var(--ink-800);

                    & output {
                        font-family: var(--font-display);
                        font-size: 1.1rem;
                        font-weight: 700;
                        background: linear-gradient(120deg, var(--violet-900), var(--violet-bright), var(--blue));
                        -webkit-background-clip: text;
                        background-clip: text;
                        color: transparent;
                    }
                }

                /* ---------- Remove-confirm dialog ---------- */
                .remove-confirm {
                    padding-block: 1.875rem 1.5rem;
                }

                .remove-confirm__icon {
                    display: grid;
                    place-items: center;
                    inline-size: 4rem;
                    aspect-ratio: 1;
                    margin: 0 auto 0.875rem;
                    border-radius: 50%;
                    font-size: 1.5rem;
                    color: var(--danger);
                    background: radial-gradient(circle at 30% 30%, #fff, #fee2e2 60%, #fecaca);
                    box-shadow:
                        0 0 0 8px rgb(239 68 68 / 0.08),
                        0 16px 30px -14px rgb(239 68 68 / 0.7);

                    .modal[open] & {
                        animation: remove-wobble 0.6s var(--ease-spring) 0.2s backwards;
                    }
                }

                .remove-confirm__title {
                    margin-block-end: 0.5rem;
                    font-size: 1.2rem;
                    font-weight: 700;
                    color: #1e1b4b;
                }

                .remove-confirm__msg {
                    margin-block-end: 1.375rem;
                    padding-inline: 1.625rem;
                    font-size: 0.9rem;
                    line-height: 1.5;
                    color: var(--ink-600);

                    & b {
                        color: var(--violet);
                    }
                }

                /* ---------- Fly-to-cart clone ---------- */
                .fly-to-cart {
                    position: fixed;
                    z-index: 9999;
                    margin: 0;
                    object-fit: contain;
                    pointer-events: none;
                    will-change: transform, opacity;
                }
            }

            /* ============================== Motion ============================== */
            @layer motion {
                /* Entry/exit transitions for the top layer (dialogs + popovers). */
                @starting-style {
                    .modal[open] {
                        opacity: 0;
                        translate: 0 32px;
                        scale: 0.96;
                    }

                    .modal[open]::backdrop {
                        opacity: 0;
                    }

                    .panel:popover-open {
                        opacity: 0;
                        scale: 0.85;
                    }

                    .hero__content {
                        opacity: 0;
                        translate: 0 24px;
                    }
