function e(string|int|float $value): string
{
    return htmlspecialchars((string) $value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
}

// "SC Logo.jpg" -> "SC%20Logo.jpg"
function file_url(string $file): string
{
    return rawurlencode($file);
}

function absolute_url(string $path): string
{
    return SITE_URL === '' ? $path : rtrim(SITE_URL, '/') . '/' . ltrim($path, '/');
}

function inr(int $amount): string
{
    return '₹' . number_format($amount);
}

function qty_text(int $qty, string $label): string
{
    return $label === 'pcs' ? ($qty === 1 ? '1 piece' : "{$qty} pcs") : "{$qty} {$label}";
}

// "pa" stays unencoded on purpose: some UPI apps reject "%40" in the VPA.
function upi_url(): string
{
    return 'upi://pay?pa=' . UPI_ID . '&pn=' . rawurlencode(BRAND) . '&cu=INR';
}

function qr_src(string $data): string
{
    return 'https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=' . rawurlencode($data);
}

// JSON that is safe to place inside a <script> element.
function json_for_script(mixed $data): string
{
    return json_encode(
        $data,
        JSON_HEX_TAG | JSON_HEX_AMP | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR
    );
}

