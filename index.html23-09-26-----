        <script>
            "use strict";

            const APP = Object.freeze({
                WA_NUMBER: "919352470085",
                CART_STORAGE_KEY: "sc_cart_auto",
                CURRENCY: "INR",
                COUNTRY_CODE: "+91",
            });

            function isValidIndianMobile(value) {
                return /^[6-9]\d{9}$/.test(String(value || "").trim());
            }

            function safeParseJSON(raw, fallback) {
                try {
                    const parsed = JSON.parse(raw);
                    return parsed ?? fallback;
                } catch {
                    return fallback;
                }
            }

            // localStorage can throw (private mode, blocked site data, quota) - never let it break the page.
            const storage = {
                get(key) {
                    try {
                        return localStorage.getItem(key);
                    } catch {
                        return null;
                    }
                },
                set(key, value) {
                    try {
                        localStorage.setItem(key, value);
                    } catch {
                        /* cart simply won't persist this session */
                    }
                },
                remove(key) {
                    try {
                        localStorage.removeItem(key);
                    } catch {
                        /* ignore */
                    }
                },
            };

            function safeOpenNewTab(url) {
                window.open(url, "_blank", "noopener,noreferrer");
            }

            function digitsOnly(inputEl) {
                inputEl.addEventListener("input", () => {
                    const cleaned = inputEl.value.replace(/\D/g, "").slice(0, 10);
                    if (cleaned !== inputEl.value) inputEl.value = cleaned;
                });
            }

            function setFieldError(inputEl, errorEl, hasError) {
                if (errorEl) errorEl.classList.toggle("hidden", !hasError);
                if (inputEl) inputEl.setAttribute("aria-invalid", String(hasError));
            }

            function buildWhatsAppUrl(message) {
                return `https://wa.me/${APP.WA_NUMBER}?text=${encodeURIComponent(message)}`;
            }

            function escapeHtml(str) {
                const div = document.createElement("div");
                div.textContent = String(str ?? "");
                return div.innerHTML;
            }

            const currencyFormatter = new Intl.NumberFormat("en-IN", {
                style: "currency",
                currency: APP.CURRENCY,
                maximumFractionDigits: 0,
            });

            function formatCurrency(amount) {
                return currencyFormatter.format(amount);
            }

            function debounce(fn, delay) {
                let timeoutId;
                return (...args) => {
                    clearTimeout(timeoutId);
                    timeoutId = setTimeout(() => fn(...args), delay);
                };
            }

            async function copyText(text, btn) {
                try {
                    if (!navigator.clipboard || !window.isSecureContext) {
                        throw new Error("Clipboard API unavailable outside a secure context");
                    }
                    await navigator.clipboard.writeText(text);
                    if (btn) {
                        const original = btn.innerHTML;
                        btn.disabled = true;
                        btn.innerHTML = '<i class="fas fa-check" aria-hidden="true"></i>';
                        setTimeout(() => {
                            btn.innerHTML = original;
                            btn.disabled = false;
                        }, 1400);
                    }
                } catch (err) {
                    if (btn) btn.title = "Copy failed — please select the text manually";
                }
            }

            const products = [
                {
                    id: 1,
                    name: "Dashboard Polish",
                    image: "Dashboard Polish.jpg",
                    price: 200,
                    unit: "Lt",
                    hasLtOptions: true,
                    description: "Premium dashboard polish for long-lasting shine",
                },
                {
                    id: 2,
                    name: "Tyre Polish",
                    image: "Tyre Polish.jpg",
                    price: 150,
                    unit: "Lt",
                    hasLtOptions: true,
                    description: "High-gloss tyre polish for enhanced appearance",
                },
                {
                    id: 3,
                    name: "Car Foaming Wash",
                    image: "Car Foaming Wash.jpg",
                    price: 70,
                    unit: "Lt",
                    hasLtOptions: true,
                    description: "Advanced foaming wash for thorough cleaning",
                },
                {
                    id: 4,
                    name: "Interior Cleaner",
                    image: "Interior Cleaner.png",
                    price: 130,
                    unit: "Lt",
                    hasLtOptions: true,
                    description: "Effective interior cleaner for all surfaces",
                },
                {
                    id: 5,
                    name: "Glass Cleaner",
                    image: "Glass Cleaner.jpg",
                    price: 70,
                    unit: "Lt",
                    hasLtOptions: true,
                    description: "Streak-free glass cleaner for crystal clear visibility",
                },
                {
                    id: 6,
                    name: "Foaming Gun",
                    image: "Foaming Gun.jpg",
                    price: 2000,
                    unit: "per piece",
                    hasLtOptions: false,
                    description: "Professional foaming gun for car wash",
                },
                {
                    id: 7,
                    name: "Micro Towel",
                    image: "Micro Towel.jpg",
                    price: 70,
                    unit: "per piece",
                    hasLtOptions: true,
                    qtyOptions: [5, 10, 20],
                    qtyLabel: " pcs",
                    description: "Ultra soft Micro Towel",
                },
                {
                    id: 8,
                    name: "Micro Towel",
                    image: "Micro Towel 2.jpg",
                    price: 110,
                    unit: "per piece",
                    hasLtOptions: true,
                    qtyOptions: [5, 10, 20],
                    qtyLabel: " pcs",
                    description: "Ultra soft Micro Towel",
                },
                {
                    id: 9,
                    name: "Micro Towel",
                    image: "Micro Towel 3.jpg",
                    price: 130,
                    unit: "per piece",
                    hasLtOptions: true,
                    qtyOptions: [5, 10, 20],
                    qtyLabel: " pcs",
                    description: "Ultra soft Micro Towel",
                },
            ];

            const LT_OPTIONS = [10, 35, 50];
            const MAX_LINE_QTY = 999;
            const productById = new Map(products.map((p) => [p.id, p]));
            let cart = {};
            let lastCartBadgeCount = 0;

            const getDialog = (id) => document.getElementById(id);

            function openDialog(dialog) {
                if (dialog && !dialog.open) dialog.showModal();
            }

            function closeDialog(dialog) {
                if (dialog && dialog.open) dialog.close();
            }

            // Unit shown next to a quantity: litres for liquids, pieces otherwise.
            function qtyUnitFor(product) {
                if (product.qtyLabel) return product.qtyLabel.trim();
                return product.hasLtOptions ? "Lt" : "pcs";
            }

            function allowedSizesFor(product) {
                return product.hasLtOptions ? product.qtyOptions || LT_OPTIONS : [1];
            }

            function cartTotals() {
                return Object.values(cart).reduce(
                    (acc, item) => {
                        acc.items += item.qty;
                        acc.amount += item.product.price * item.selectedQty * item.qty;
                        return acc;
                    },
                    { items: 0, amount: 0 }
                );
            }

            // Only ids and counts are persisted. Name, image and price always come from the
            // catalogue above, so stale prices or edited storage can never reach the page.
            function saveCart() {
                const data = Object.values(cart).map((item) => ({
                    id: item.product.id,
                    size: item.selectedQty,
                    qty: item.qty,
                }));
                storage.set(APP.CART_STORAGE_KEY, JSON.stringify(data));
            }

            function loadCart() {
                const raw = safeParseJSON(storage.get(APP.CART_STORAGE_KEY), null);
                if (!raw || typeof raw !== "object") return {};
                // Older saves stored { key: { product, qty, selectedQty } }; migrate them.
                const entries = Array.isArray(raw)
                    ? raw
                    : Object.values(raw).map((e) => ({ id: e?.product?.id, size: e?.selectedQty, qty: e?.qty }));
                const restored = {};
                entries.forEach((entry) => {
                    const { id, size, qty } = entry || {};
                    const product = productById.get(Number(id));
                    const selectedQty = Number(size);
                    const count = Number(qty);
                    if (!product || !allowedSizesFor(product).includes(selectedQty)) return;
                    if (!Number.isInteger(count) || count < 1 || count > MAX_LINE_QTY) return;
                    restored[`${product.id}_${selectedQty}`] = { product, qty: count, selectedQty };
                });
                return restored;
            }

            function addToCart(productId) {
                const product = productById.get(productId);
                if (!product) return;
                const card = document.querySelector(`.product-card[data-product-id="${productId}"]`);
                const activeBtn = card?.querySelector(".qty-btn.active");
                const selectedQty = activeBtn ? Number(activeBtn.dataset.lt) : 1;
                if (!allowedSizesFor(product).includes(selectedQty)) return;
                const key = `${productId}_${selectedQty}`;

                const commitToCart = () => {
                    if (cart[key]) cart[key].qty = Math.min(cart[key].qty + 1, MAX_LINE_QTY);
                    else cart[key] = { product, qty: 1, selectedQty };
                    saveCart();
                    updateCartUI();
                    openAddedCartModal(key);
                };

                const sourceImg = card?.querySelector(".product-image.loaded");
                const cartBtn = document.querySelector(".cart-icon-btn");
                const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

                if (!sourceImg || !cartBtn || reduceMotion) {
                    commitToCart();
                    return;
                }
                flyToCart(sourceImg, cartBtn, commitToCart);
            }

            function flyToCart(sourceImg, cartBtn, onDone) {
                const srcRect = sourceImg.getBoundingClientRect();
                const destRect = cartBtn.getBoundingClientRect();
                if (srcRect.width === 0 || srcRect.height === 0) {
                    onDone();
                    return;
                }

                const flyer = sourceImg.cloneNode(true);
                flyer.removeAttribute("id");
                flyer.setAttribute("aria-hidden", "true");
                Object.assign(flyer.style, {
                    position: "fixed",
                    zIndex: "9999",
                    margin: "0",
                    pointerEvents: "none",
                    left: `${srcRect.left}px`,
                    top: `${srcRect.top}px`,
                    width: `${srcRect.width}px`,
                    height: `${srcRect.height}px`,
                    transformOrigin: "top left",
                    willChange: "transform, opacity",
                });
                document.body.appendChild(flyer);

                const destX = destRect.left + destRect.width / 2 - (srcRect.left + srcRect.width / 2);
                const destY = destRect.top + destRect.height / 2 - (srcRect.top + srcRect.height / 2);

                // Web Animations API: the returned promise replaces transitionend + timeout juggling.
                const animation = flyer.animate(
                    [
                        { transform: "translate(0, 0) scale(1)", opacity: 1 },
                        { transform: `translate(${destX}px, ${destY}px) scale(0.12)`, opacity: 0.3 },
                    ],
                    { duration: 550, easing: "cubic-bezier(0.34, 0, 0.64, 1)", fill: "forwards" }
                );
                animation.finished
                    .catch(() => {})
                    .finally(() => {
                        flyer.remove();
                        onDone();
                    });
            }

            function updateCartUI() {
                const keys = Object.keys(cart);
                const { items: totalItems, amount: grandTotal } = cartTotals();
                const badge = document.getElementById("cartBadge");
                const footer = document.getElementById("cartFooter");
                const list = document.getElementById("cartItemsList");
                if (!badge || !footer || !list) return;

                badge.style.display = totalItems > 0 ? "flex" : "none";
                badge.textContent = String(totalItems);
                if (totalItems !== lastCartBadgeCount && totalItems > 0) {
                    badge.classList.remove("bump");
                    void badge.offsetWidth;
                    badge.classList.add("bump");
                }
                lastCartBadgeCount = totalItems;

                const cartBtn = document.querySelector(".cart-icon-btn");
                if (cartBtn) {
                    cartBtn.setAttribute(
                        "aria-label",
                        totalItems ? `Open cart, ${totalItems} item${totalItems === 1 ? "" : "s"}` : "Open cart"
                    );
                }

                if (keys.length === 0) {
                    list.innerHTML = `<div class="cart-empty-msg"><i class="fas fa-shopping-cart text-3xl mb-3 block opacity-30" aria-hidden="true"></i>Your cart is empty</div>`;
                    footer.style.display = "none";
                    return;
                }

                footer.style.display = "block";
                list.innerHTML = keys
                    .map((key) => {
                        const { product, qty, selectedQty } = cart[key];
                        const totalQty = selectedQty * qty;
                        const lineTotal = product.price * totalQty;
                        const unit = qtyUnitFor(product);
                        const name = escapeHtml(product.name);
                        const safeKey = escapeHtml(key);
                        return `<div class="cart-item-row"><div style="flex:1;min-width:0"><p style="font-weight:500;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${name}</p>
         <p style="font-size:11px;color:#64748b;">${totalQty} ${unit} × ${formatCurrency(product.price)}/${unit}</p>
          </div><div class="cart-item-qty-ctrl"><button type="button" class="cart-qty-btn" data-action="cart-qty" data-key="${safeKey}" data-delta="-1" aria-label="Decrease ${name}">−</button><span style="min-width:40px;text-align:center;font-size:12px;">${totalQty} ${unit}</span><button type="button" class="cart-qty-btn" data-action="cart-qty" data-key="${safeKey}" data-delta="1" aria-label="Increase ${name}">+</button></div><div style="display:flex;align-items:center;gap:8px;"><span style="font-weight:700;color:#1d4ed8;">${formatCurrency(lineTotal)}</span><button type="button" data-action="remove-from-cart" data-key="${safeKey}" aria-label="Remove ${name} from cart" style="background:#fee2e2;border-radius:50%;width:24px;height:24px;display:flex;align-items:center;justify-content:center;color:#ef4444;border:none;cursor:pointer;flex-shrink:0;"><i class="fas fa-trash-can" style="font-size:11px;" aria-hidden="true"></i></button></div></div>`;
                    })
                    .join("");

                const totalEl = document.getElementById("cartTotal");
