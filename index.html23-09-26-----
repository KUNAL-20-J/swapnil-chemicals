                        isFallback: false,
                    };
                }

                if (/\b(bye|thanks|thank you|thank)\b/.test(text)) {
                    return { html: `You're welcome! Feel free to reach out anytime. 🙏`, isFallback: false };
                }

                if (/\b(product|catalog|range|items?)\b/.test(text) || /what.*(sell|make|manufacture)/.test(text)) {
                    const lines = uniqueProductList().map(formatProductLine).join("<br>");
                    return {
                        html: `Here's our product range:<br><br>${lines}<br><br>Tap "Add to Cart" or "Enquiry" on any product card above for quantity options.`,
                        isFallback: false,
                    };
                }

                if (/\b(price|cost|rate|rates|pricing|how much)\b/.test(text)) {
                    const matches = findProductsByQuery(text);
                    if (matches.length) {
                        const lines = matches.map(formatProductLine).join("<br>");
                        const suffix =
                            matches.length > 1
                                ? 'Let us know which variant you need, or ask about "bulk orders" for larger quantities.'
                                : 'Larger quantities are available for bulk orders — ask me about "bulk orders" for details.';
                        return { html: `${lines}<br><br>${suffix}`, isFallback: false };
                    }
                    const lines = uniqueProductList().map(formatProductLine).join("<br>");
                    return { html: `Here are our current prices:<br><br>${lines}`, isFallback: false };
                }

                if (/\b(bulk|wholesale|distributor|discount|large quantity|retail)\b/.test(text)) {
                    return {
                        html: `We supply both bulk and retail quantities. For bulk/wholesale pricing, please call us at <a href="tel:9352470085" class="text-blue-600">9352470085</a> or <a href="tel:9024598298" class="text-blue-600">9024598298</a>, or use the "Enquiry" button on a product to send your requirement on WhatsApp.`,
                        isFallback: false,
                    };
                }

                if (/\b(contact|phone|number|call|reach|mobile)\b/.test(text)) {
                    return {
                        html: `You can reach Swapnil Chemicals at:<br>📞 <a href="tel:9352470085" class="text-blue-600">9352470085</a><br>📞 <a href="tel:9024598298" class="text-blue-600">9024598298</a><br>✉️ <a href="mailto:swapnilchemicals10@gmail.com" class="text-blue-600">swapnilchemicals10@gmail.com</a>`,
                        isFallback: false,
                    };
                }

                if (/\b(email|mail)\b/.test(text)) {
                    return {
                        html: `Our email is <a href="mailto:swapnilchemicals10@gmail.com" class="text-blue-600">swapnilchemicals10@gmail.com</a>`,
                        isFallback: false,
                    };
                }

                if (/\b(where|location|address|based|jaipur|city)\b/.test(text)) {
                    return {
                        html: `We're based in Jaipur, Rajasthan, and supply both bulk and retail orders.`,
                        isFallback: false,
                    };
                }

                if (/\b(gst|msme|udyam|brn|registration|license|legal|certificate)\b/.test(text)) {
                    return {
                        html: `Swapnil Chemicals is a registered business:<br>GST: <b>08CIJPS1734A1ZE</b><br>MSME: <b>MSME/2020/6194</b><br>Udyam: <b>UDYAM-RJ-17-0022468</b><br>BRN: <b>8005220072000968</b>`,
                        isFallback: false,
                    };
                }

                if (/\b(pay|payment|upi|gpay|google pay)\b/.test(text)) {
                    return {
                        html: `You can pay via Google Pay / UPI to <b>9352470085</b>, or scan the QR code in the Contact section. Call us to discuss other payment arrangements.`,
                        isFallback: false,
                    };
                }

                if (/\b(order|buy|purchase)\b/.test(text)) {
                    return {
                        html: `To order: pick a product above, choose a quantity, and tap "Add to Cart" (then "Pay via GPay" in your cart), or tap "Enquiry" to send your requirement directly to us on WhatsApp.`,
                        isFallback: false,
                    };
                }

                return {
                    html: `I can help with product info, pricing, bulk orders, payment and contact details. For anything else, let's connect you with our team directly on WhatsApp.`,
                    isFallback: true,
                };
            }

            function handleAssistantQuery(rawText) {
                const trimmed = String(rawText || "").trim();
                if (!trimmed) return;
                appendAssistantMessage("user", escapeHtml(trimmed));
                const reply = buildAssistantReply(trimmed);
                appendAssistantMessage("bot", reply.html);
                if (reply.isFallback) {
                    const list = document.getElementById("assistantMessages");
                    const btn = document.createElement("button");
                    btn.type = "button";
                    btn.className = "assistant-chip";
                    btn.style.cssText =
                        "align-self:flex-start;margin-top:-4px;background:linear-gradient(135deg,#25d366,#128c7e);color:#fff;border:none;";
                    btn.innerHTML = '<i class="fab fa-whatsapp" aria-hidden="true"></i> Ask on WhatsApp';
                    btn.addEventListener("click", () => {
                        safeOpenNewTab(buildWhatsAppUrl(`Hi Swapnil Chemicals, I have a question: ${trimmed}`));
                    });
                    if (list) {
                        list.appendChild(btn);
                        list.scrollTop = list.scrollHeight;
                    }
                }
            }

            const assistantForm = document.getElementById("assistantForm");
            if (assistantForm) {
                assistantForm.addEventListener("submit", (e) => {
                    e.preventDefault();
                    const input = document.getElementById("assistantInput");
                    if (!input || !input.value.trim()) return;
                    handleAssistantQuery(input.value);
                    input.value = "";
                });
            }

            // One rAF-throttled, passive scroll listener drives every scroll-linked UI piece.
            function initScrollEffects() {
                const topBtn = document.getElementById("scrollToTop");
                const bar = document.getElementById("scrollProgress");
                const cssDrivesProgress = CSS.supports?.("animation-timeline: scroll()");
                let ticking = false;

                const update = () => {
                    ticking = false;
                    topBtn?.classList.toggle("hidden", window.scrollY <= 300);
                    if (bar && !cssDrivesProgress) {
                        const scrollable = document.documentElement.scrollHeight - window.innerHeight;
                        const pct = scrollable > 0 ? (window.scrollY / scrollable) * 100 : 0;
                        bar.style.width = `${pct}%`;
                    }
                };
                const onScroll = () => {
                    if (ticking) return;
                    ticking = true;
                    requestAnimationFrame(update);
                };

                window.addEventListener("scroll", onScroll, { passive: true });
                window.addEventListener("resize", onScroll, { passive: true });
                update();

                topBtn?.addEventListener("click", () => {
                    window.scrollTo({ top: 0 }); // html { scroll-behavior: smooth } animates it and honours reduced motion
                    document.getElementById("main-content")?.focus({ preventScroll: true });
                });
            }

            function initScrollAnimations(cards) {
                const obs = new IntersectionObserver(
                    (entries) =>
                        entries.forEach((entry) => {
                            if (!entry.isIntersecting) return;
                            entry.target.style.opacity = "1";
                            entry.target.style.transform = "translateY(0)";
                            obs.unobserve(entry.target);
                        }),
                    { threshold: 0.1 }
                );
                cards.forEach((c) => {
                    c.style.opacity = "0";
                    c.style.transform = "translateY(30px)";
                    c.style.transition = "opacity 0.6s ease, transform 0.6s ease";
                    obs.observe(c);
                });
            }

            function initCardReveal() {
                if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
                const cards = document.querySelectorAll(".product-card, .feature-card");
                if (CSS.supports?.("animation-timeline: view()")) {
                    cards.forEach((c) => c.classList.add("scroll-reveal"));
                    return;
                }
                if ("IntersectionObserver" in window) initScrollAnimations(cards);
            }

            // Single delegated listener handles every data-action element, including
            // ones rendered later via innerHTML (product cards, cart rows, qty buttons).
            const ACTIONS = {
                "toggle-cart": () => toggleCart(),
                "toggle-assistant": () => toggleAssistant(),
                copy: (target) => copyText(target.dataset.copyText, target),
                "open-cart-enquiry": () => openCartEnquiry(),
                "clear-cart": () => clearCart(),
                "close-enquiry": () => closeEnquiryModal(),
                "close-added-cart": (target, e) => closeAddedCartModal(e),
                "added-cart-qty": (target) => changeAddedCartQty(Number(target.dataset.delta)),
                "view-cart-from-added": (target, e) => viewCartFromAddedModal(e),
                "close-remove-confirm": () => closeRemoveConfirmModal(),
                "confirm-remove": (target, e) => confirmRemoveFromCart(e),
                "cart-qty": (target, e) => changeCartQty(target.dataset.key, Number(target.dataset.delta), e),
                "remove-from-cart": (target, e) => removeFromCart(target.dataset.key, e),
                "select-qty": (target) => selectQty(target),
                "open-enquiry": (target) => openEnquiryModal(Number(target.dataset.productId)),
                "add-to-cart": (target) => addToCart(Number(target.dataset.productId)),
            };

            function handleGlobalClick(e) {
                const target = e.target instanceof Element ? e.target.closest("[data-action]") : null;
                if (!target) return;
                ACTIONS[target.dataset.action]?.(target, e);
            }
            document.addEventListener("click", handleGlobalClick);

            // load/error don't bubble, but the capture phase still sees them on the way
            // down — this replaces per-image onload/onerror attributes for every
            // .product-image, including ones rendered after this listener is attached.
            document.addEventListener(
                "load",
                (e) => {
                    if (e.target instanceof HTMLImageElement && e.target.matches(".product-image")) {
                        e.target.classList.add("loaded");
                    }
                },
                true
            );
            document.addEventListener(
                "error",
                (e) => {
                    if (e.target instanceof HTMLImageElement && e.target.matches(".product-image")) {
                        e.target.style.display = "none";
                        const fallback = e.target.nextElementSibling;
                        if (fallback) fallback.style.opacity = "1";
                    }
                },
                true
            );

            function init() {
                renderProducts();
                initProductSearch();
                initVoiceSearch();
                initVoiceAssistant();
                initDialogs();
                initScrollEffects();
                initCardReveal();
                const yearEl = document.getElementById("copyrightYear");
                if (yearEl) yearEl.textContent = String(new Date().getFullYear());
                cart = loadCart();
                saveCart(); // rewrites any legacy-format save in the compact format
                updateCartUI();
            }

            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", init, { once: true });
            } else {
                init();
            }

            // Keep the cart in sync when it changes in another tab.
            window.addEventListener("storage", (e) => {
                if (e.key !== APP.CART_STORAGE_KEY) return;
                cart = loadCart();
                updateCartUI();
            });
        </script>
