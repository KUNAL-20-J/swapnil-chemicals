            function createSpeechRecognizer() {
                const SpeechRecognitionCtor = window.SpeechRecognition || window.webkitSpeechRecognition;
                const recognizer = new SpeechRecognitionCtor();
                recognizer.lang = "en-IN";
                recognizer.interimResults = false;
                recognizer.maxAlternatives = 1;
                return recognizer;
            }

            function attachVoiceInput(buttonEl, inputEl, options) {
                if (!buttonEl || !inputEl) return;
                const opts = options || {};
                let listening = false;

                buttonEl.addEventListener("click", () => {
                    if (listening) return;
                    let recognizer;
                    try {
                        recognizer = createSpeechRecognizer();
                    } catch (err) {
                        return;
                    }

                    listening = true;
                    buttonEl.classList.add("listening");
                    buttonEl.setAttribute("aria-label", opts.listeningLabel || "Listening…");

                    recognizer.onresult = (event) => {
                        const transcript = event.results[0][0].transcript;
                        inputEl.value = transcript;
                        inputEl.dispatchEvent(new Event("input", { bubbles: true }));
                        if (opts.onTranscript) opts.onTranscript(transcript);
                    };
                    recognizer.onerror = () => {
                        // Microphone denied or nothing heard - fail quietly, input stays editable by hand.
                    };
                    recognizer.onend = () => {
                        listening = false;
                        buttonEl.classList.remove("listening");
                        buttonEl.setAttribute("aria-label", opts.idleLabel || "Use voice input");
                    };
                    try {
                        recognizer.start();
                    } catch {
                        recognizer.onend();
                    }
                });
            }

